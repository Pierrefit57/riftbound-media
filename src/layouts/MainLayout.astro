    <div class="absolute inset-x-0 bottom-0 h-[1000px] bg-[radial-gradient(ellipse_80%_50%_at_50%_100%,_rgba(233,135,15,0.2)_0%,_transparent_70%)] pointer-events-none z-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-[800px] bg-[radial-gradient(ellipse_60%_40%_at_15%_100%,_rgba(233,135,15,0.15)_0%,_transparent_60%),_radial-gradient(ellipse_60%_40%_at_85%_100%,_rgba(233,135,15,0.15)_0%,_transparent_60%)] pointer-events-none z-0"></div>
