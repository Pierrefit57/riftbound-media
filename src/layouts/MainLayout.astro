---
interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  petalMode?: 'full' | 'sides';
  petals?: boolean;
  noindex?: boolean;
}

const { 
  title, 
  description = "Votre source francophone pour l'univers Riftbound. Actualités, tournois, règles et communauté.",
  image = "/riftbound-logo.png?v=2",
  canonicalURL = new URL(Astro.url.pathname, Astro.site),
  type = 'website',
  petalMode = 'full', 
  petals = false,
  noindex = false,
} = Astro.props;
const currentPath = Astro.url.pathname;
const user = Astro.locals.user;
const profile = Astro.locals.profile;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/news', label: 'Actualités' },
  { href: '/rules', label: 'Règles' },
  { href: '/calendar', label: 'Calendrier' },
];

import { supabase } from '../lib/supabase';
import { proxyUrl } from '../lib/proxy';
import '../styles/tables.css';

// Détection d'événement en cours pour la notification toast
// On utilise le fuseau Europe/Paris pour éviter le décalage UTC
const now = new Date();

// Obtenir la date "locale" Paris en YYYY-MM-DD
const parisDateStr = now.toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' }); // en-CA → YYYY-MM-DD
const parisTomorrow = new Date(now.getTime() + 86400000);
const parisTomorrowStr = parisTomorrow.toLocaleDateString('en-CA', { timeZone: 'Europe/Paris' });

const { data: activeEvents } = await supabase
  .from('calendar_events')
  .select('id, title, start_date, end_date, image_url')
  .gte('end_date', parisDateStr + 'T00:00:00')
  .lte('start_date', parisTomorrowStr + 'T23:59:59');

// Trouver l'événement en cours basé sur la date Paris
const ongoingEvent = activeEvents
  ?.filter(event => {
    const startDate = event.start_date.split('T')[0]; // YYYY-MM-DD
    const endDate = event.end_date ? event.end_date.split('T')[0] : startDate;
    return parisDateStr >= startDate && parisDateStr <= endDate;
  })
  // Prioriser les événements qui commencent aujourd'hui (vs multi-jours en cours)
  .sort((a, b) => {
    const aStartsToday = a.start_date.split('T')[0] === parisDateStr ? 0 : 1;
    const bStartsToday = b.start_date.split('T')[0] === parisDateStr ? 0 : 1;
    return aStartsToday - bStartsToday;
  })[0] ?? null;


---

<!doctype html>
<html lang="fr" class="bg-rift-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/favicon-192.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="W29uyPBUbZMap2eBaByU1u6vG4HobqjMpdvHK40DfpI" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="6e0efd70-2bb1-4ffa-99a8-b7c457b3acb7"></script>

    <!-- Primary Meta Tags -->
    <title>{title} | Riftbound Media</title>
    <meta name="title" content={`${title} | Riftbound Media`} />
    <meta name="description" content={description} />
    <meta name="keywords" content="Riftbound, TCG, Jeu de cartes, Riftbound Media, JCC Riftbound, Communauté française, Tournois Riftbound, Origins, Spiritforged" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="alternate" type="application/rss+xml" title="Riftbound Media — Actualités" href="/rss.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Riftbound Media" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD Global -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Riftbound Media",
      "url": "https://www.riftbound-media.fr",
      "logo": "https://www.riftbound-media.fr/riftbound-logo.png",
      "description": "Portail francophone officiel de la communauté Riftbound TCG. Actualités, tournois et guides.",
      "sameAs": [
        "https://x.com/Riftbound_Media",
        "https://discord.gg/QDB6WfA9Zm"
      ]
    })} />
    
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "Riftbound Media",
      "url": "https://www.riftbound-media.fr",
      "alternateName": ["Riftbound TCG France", "JCC Riftbound"],
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://www.riftbound-media.fr/news?search={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cookie&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        color-scheme: light;
      }
      /* Spoiler */
      .article-spoiler.revealed .spoiler-content {
        filter: blur(0) !important;
        opacity: 1 !important;
        pointer-events: auto !important;
        user-select: auto !important;
      }
      .article-spoiler.revealed .spoiler-overlay {
        display: none !important;
      }
      .article-spoiler.revealed {
        cursor: auto !important;
      }
      /* Rose petals falling */
      .petals-container {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 1;
        overflow: hidden;
      }
      .petal {
        position: absolute;
        width: 12px;
        height: 10px;
        border-radius: 50% 0 50% 50%;
        opacity: 0;
      }
      .petal:nth-child(1) { left: 5%; background: #ffbca1; animation: petal-fall 11s linear 0s infinite; width: 16px; height: 14px; }
      .petal:nth-child(2) { left: 12%; background: #ffbca1; animation: petal-fall-2 15s linear 2s infinite; width: 13px; height: 11px; }
      .petal:nth-child(3) { left: 20%; background: #ffbca1; animation: petal-fall 13s linear 4s infinite; width: 15px; height: 13px; }
      .petal:nth-child(4) { left: 28%; background: #ffbca1; animation: petal-fall-2 17s linear 1s infinite; width: 12px; height: 10px; }
      .petal:nth-child(5) { left: 35%; background: #ffbca1; animation: petal-fall 12s linear 6s infinite; width: 17px; height: 14px; }
      .petal:nth-child(6) { left: 42%; background: #ffbca1; animation: petal-fall-2 14s linear 3s infinite; width: 14px; height: 12px; }
      .petal:nth-child(7) { left: 50%; background: #ffbca1; animation: petal-fall 16s linear 5s infinite; width: 13px; height: 11px; }
      .petal:nth-child(8) { left: 58%; background: #ffbca1; animation: petal-fall-2 13s linear 7s infinite; width: 16px; height: 13px; }
      .petal:nth-child(9) { left: 65%; background: #ffbca1; animation: petal-fall 11s linear 2s infinite; width: 15px; height: 12px; }
      .petal:nth-child(10) { left: 72%; background: #ffbca1; animation: petal-fall-2 18s linear 8s infinite; width: 12px; height: 10px; }
      .petal:nth-child(11) { left: 78%; background: #ffbca1; animation: petal-fall 14s linear 1s infinite; width: 17px; height: 14px; }
      .petal:nth-child(12) { left: 85%; background: #ffbca1; animation: petal-fall-2 12s linear 4s infinite; width: 14px; height: 12px; }
      .petal:nth-child(13) { left: 92%; background: #ffbca1; animation: petal-fall 15s linear 9s infinite; width: 13px; height: 11px; }
      .petal:nth-child(14) { left: 15%; background: #ffbca1; animation: petal-fall-2 16s linear 6s infinite; width: 15px; height: 13px; }
      .petal:nth-child(15) { left: 45%; background: #ffbca1; animation: petal-fall 10s linear 3s infinite; width: 16px; height: 14px; }
      .petal:nth-child(16) { left: 70%; background: #ffbca1; animation: petal-fall-2 11s linear 5s infinite; width: 14px; height: 12px; }

      @keyframes petal-fall {
        0% { transform: translateY(-10vh) translateX(0) rotate(0deg) scale(0.8); opacity: 0; }
        8% { opacity: 1; }
        50% { transform: translateY(50vh) translateX(40px) rotate(180deg) scale(1); opacity: 0.9; }
        85% { opacity: 0.6; }
        100% { transform: translateY(110vh) translateX(80px) rotate(360deg) scale(0.6); opacity: 0; }
      }
      @keyframes petal-fall-2 {
        0% { transform: translateY(-10vh) translateX(0) rotate(0deg) scale(0.7); opacity: 0; }
        8% { opacity: 1; }
        50% { transform: translateY(50vh) translateX(-50px) rotate(-180deg) scale(1); opacity: 0.85; }
        85% { opacity: 0.5; }
        100% { transform: translateY(110vh) translateX(-60px) rotate(-360deg) scale(0.5); opacity: 0; }
      }

      .petal-static {
        position: absolute;
        width: 14px;
        height: 12px;
        background: #ffbca1;
        border-radius: 50% 0 50% 50%;
      }

      /* Side only mode: Hide center petals */
      .petals-sides-only .petal:nth-child(5), /* 35% */
      .petals-sides-only .petal:nth-child(6), /* 42% */
      .petals-sides-only .petal:nth-child(7), /* 50% */
      .petals-sides-only .petal:nth-child(8), /* 58% */
      .petals-sides-only .petal:nth-child(9), /* 65% */
      .petals-sides-only .petal:nth-child(15) /* 45% */
      {
        display: none;
      }

      /* Nav link underline animation */
      /* Nav link underline animation removed for centering */

      /* Nav link underline animation removed for centering */
      
      /* Floating Event Notification */
      .event-toast {
        /* Smooth entrance with a slight scale and blur for premium feel */
        animation: toast-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        will-change: transform, opacity;
      }
      @keyframes toast-in {
        0% { 
          transform: translateX(40px) scale(0.9); 
          opacity: 0; 
          filter: blur(8px);
        }
        100% { 
          transform: translateX(0) scale(1); 
          opacity: 1; 
          filter: blur(0);
        }
      }

      .badge-keyword-red::before { background-color: #E63946; color: #fff; }
      .badge-keyword-red { color: #fff !important; }

      /* ── Buy Me a Coffee pill (Extreme Right Edge) ── */
      .bmc-pill {
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
        display: inline-flex;
        align-items: center;
        background: transparent;
        border-radius: 9999px;
        overflow: hidden;
        text-decoration: none;
        height: 38px;
        flex-direction: row;
        transition: background 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
        z-index: 60;
      }
      .bmc-pill:hover {
        background: rgba(20, 16, 28, 0.95);
        border: 1px solid rgba(233, 135, 15, 0.4);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
      }
      .bmc-pill__text {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 0.9rem;
        color: #fff;
        white-space: nowrap;
        letter-spacing: 0.02em;
        /* hidden by default */
        max-width: 0;
        overflow: hidden;
        opacity: 0;
        padding: 0;
        transition: max-width 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease 0.05s, padding 0.3s ease;
      }
      .bmc-pill:hover .bmc-pill__text {
        max-width: 140px;
        opacity: 1;
        padding: 0 10px 0 14px;
      }
      .bmc-pill__icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        background: #E9870F; /* Site spirit orange */
        border-radius: 50%;
        flex-shrink: 0;
        box-shadow: 0 0 12px rgba(233, 135, 15, 0.4);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      .bmc-pill:hover .bmc-pill__icon {
        transform: scale(1.06);
        box-shadow: 0 0 18px rgba(233, 135, 15, 0.6);
      }
      .bmc-pill__logo {
        width: 20px;
        height: 20px;
        object-fit: contain;
        display: block;
        filter: brightness(0) invert(1);
      }
      /* Mobile: always show text, no hover needed */
      .bmc-pill--mobile {
        background: #2a2318;
        border-radius: 12px;
        height: 42px;
        width: 100%;
      }
      .bmc-pill--mobile .bmc-pill__icon {
        margin: 5px 0 5px 5px;
        width: 32px;
        height: 32px;
      }
    </style>

    <style is:global>
      /* TCG Keyword Badges - Global for Slots & Preview */
      .badge-keyword {
        display: inline-block;
        padding: 0.11em 0.55em 0.1em 0.25em; /* Léger padding vertical rétabli */
        font-weight: 900;
        font-style: italic;
        color: #000 !important;
        position: relative;
        z-index: 1;
        margin: 0 0.4em;
        line-height: 1; /* Resserre la boîte autour du texte (supprime l'espace naturel de la police) */
        font-family: 'Outfit', sans-serif;
        text-transform: uppercase;
        font-size: 0.9em;
        vertical-align: baseline;
      }
      .badge-keyword::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        transform: skewX(-15deg);
        box-shadow: 0 1px 2px rgba(0,0,0,0.4);
      }
      .badge-keyword-lime::before { background-color: #A3CF31; }
      .badge-keyword-lime { color: #000 !important; }
      
      .badge-keyword-teal::before { background-color: #006B5F; }
      .badge-keyword-teal { color: #fff !important; }
      
      .badge-keyword-red::before { background-color: #C42761; }
      .badge-keyword-red { color: #fff !important; }

      .badge-keyword-magenta::before { background-color: #C42761; }
      .badge-keyword-magenta { color: #fff !important; }

      .badge-keyword-gray::before { background-color: #6B7280; }
      .badge-keyword-gray { color: #fff !important; }

      /* Volet Accordion Styles */
      .article-volet {
        background: rgba(10, 17, 40, 0.4); /* bg-rift-900 */
        border: 1px solid rgba(233, 135, 15, 0.2); /* #E9870F - accent.spirit */
        border-radius: 0.5rem;
        margin: 1.5rem 0;
        overflow: hidden;
      }
      .article-volet[open] {
        border-color: rgba(233, 135, 15, 0.5);
      }
      .volet-summary {
        background: rgba(5, 9, 20, 0.6); /* bg-rift-950 */
        padding: 1rem 1.5rem;
        font-family: 'Outfit', sans-serif;
        font-weight: 700;
        font-size: 1.25rem;
        color: #e9870f;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        user-select: none;
        transition: background-color 0.2s, color 0.2s;
        /* Disable default marker in WebKit */
        list-style: none;
      }
      .volet-summary::-webkit-details-marker {
        display: none;
      }
      .volet-summary:hover {
        background: rgba(233, 135, 15, 0.1); /* accent.spirit */
      }
      .volet-summary::after {
        content: '+';
        font-size: 1.5rem;
        font-weight: 400;
        transition: transform 0.3s ease;
      }
      .article-volet[open] .volet-summary::after {
        transform: rotate(45deg);
      }
      .volet-content {
        padding: 1.5rem;
        border-top: 1px solid rgba(233, 135, 15, 0.2); /* accent.spirit */
        background: rgba(10, 17, 40, 0.2); /* bg-rift-900 */
      }
    </style>
  </head>
  <body class="bg-rift-900 text-rift-100 font-sans min-h-screen flex flex-col relative">

    <!-- Global Background Shading -->
    <div class="absolute inset-x-0 top-0 h-[800px] pointer-events-none z-0" style="background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(160,28,64,0.16), transparent);"></div>
    
    <!-- Bottom Glow (Anchored to Footer) -->
    <div class="absolute inset-x-0 bottom-0 h-[1000px] bg-[radial-gradient(ellipse_80%_60%_at_50%_100%,_rgba(160,28,64,0.40)_0%,_transparent_70%)] pointer-events-none z-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-[800px] bg-[radial-gradient(ellipse_60%_40%_at_15%_100%,_rgba(160,28,64,0.28)_0%,_transparent_60%),_radial-gradient(ellipse_60%_40%_at_85%_100%,_rgba(160,28,64,0.28)_0%,_transparent_60%)] pointer-events-none z-0"></div>
    <div class="absolute inset-x-0 bottom-0 h-[600px] bg-[radial-gradient(ellipse_50%_50%_at_50%_100%,_rgba(160,28,64,0.23)_0%,_transparent_70%)] pointer-events-none z-0"></div>

    <!-- Falling Petals removed -->

    <!-- Navbar -->
    <header class="sticky top-0 z-50 bg-rift-900/95 backdrop-blur-sm border-b border-rift-700/50 relative">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 h-20 flex items-center justify-between relative">
        <!-- Logo -->
        <a href="/" class="flex items-center group">
          <img src="/riftbound-titre.png?v=3" alt="Riftbound Media" class="h-40 w-auto -my-10 -ml-4 object-contain group-hover:scale-105 transition-transform duration-300" />
        </a>

        <!-- Desktop Nav -->
        <div class="hidden md:flex items-center gap-8 absolute left-1/2 -translate-x-1/2">
          {navLinks.map((link) => (
            <div class="relative group">
              <a
                href={link.href}
                class:list={[
                  'nav-link px-5 pt-2.5 pb-4 text-base font-medium transition-all duration-200',
                  currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                    ? 'nav-link-active text-accent-spirit'
                    : 'text-rift-300 hover:text-accent-spirit',
                ]}
              >
                {link.label}
              </a>
              {/* Hover line */}
              <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-accent-spirit group-hover:w-full transition-all duration-300"></span>
            </div>
          ))}
        </div>

        <!-- Right side: Auth -->
        <div class="hidden sm:flex items-center gap-3">
          {user ? (
            <>
              {profile && ['admin', 'editor'].includes(profile.role) && (
                <a href="/admin" class="px-3 py-1 rounded-full bg-rift-800 text-rift-50 text-xs font-semibold hover:bg-rift-700 transition-colors border border-rift-700">
                  Admin
                </a>
              )}
              
              <!-- Mon Compte Button (Left of separator) -->
              <a href="/account" class="px-3 py-1 rounded-full bg-rift-800 text-rift-50 text-xs font-semibold hover:bg-rift-700 transition-colors border border-rift-700">
                Mon Compte
              </a>

              <!-- User Info Block (Right of separator) -->
              <a href="/account" class="flex items-center gap-3 pl-4 border-l border-rift-700/50 group">
                <div class="text-right hidden sm:block">
                  <p class="text-sm font-display font-bold text-rift-50 group-hover:text-accent-spirit transition-colors">{profile?.username}</p>
                </div>
                {profile?.avatar_url ? (
                  <img src={profile.avatar_url} alt="Avatar" class="w-9 h-9 rounded-full object-cover group-hover:scale-105 transition-transform duration-200" />
                ) : (
                  <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent-spirit to-accent-sakura flex items-center justify-center text-sm font-bold text-white group-hover:scale-105 transition-transform duration-200">
                    {profile?.username?.charAt(0)?.toUpperCase() || '?'}
                  </div>
                )}
              </a>
            </>
          ) : (
            <a href="/login" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-accent-spirit text-white text-sm font-semibold hover:bg-accent-spirit/90 shadow-spirit hover:shadow-lg transition-all duration-300">
              Connexion
            </a>
          )}
        </div>

        <!-- Mobile menu toggle -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-rift-600 hover:text-accent-spirit transition-colors" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </nav>

      <!-- Buy Me a Coffee — Extreme Right Edge of Page Header -->
      <a
        href="https://www.buymeacoffee.com/riftboundmedia"
        target="_blank"
        rel="noopener noreferrer"
        id="bmc-btn-header"
        aria-label="Buy Me a Coffee"
        class="bmc-pill hidden sm:flex focus:outline-none"
      >
        <span class="bmc-pill__text">Buy me a coffee</span>
        <span class="bmc-pill__icon">
          <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" alt="Buy me a coffee" class="bmc-pill__logo" />
        </span>
      </a>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="md:hidden hidden border-t border-rift-700/50 bg-rift-900">
        <div class="px-4 py-3 space-y-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                'block px-4 py-2.5 rounded-lg text-sm font-medium transition-all duration-200',
                currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                  ? 'text-accent-spirit bg-accent-spirit/5'
                  : 'text-rift-600 hover:text-rift-900 hover:bg-rift-100',
              ]}
            >
              {link.label}
            </a>
          ))}
          <!-- Buy Me a Coffee (mobile) -->
          <a
            href="https://www.buymeacoffee.com/riftboundmedia"
            target="_blank"
            rel="noopener noreferrer"
            class="bmc-pill bmc-pill--mobile focus:outline-none"
          >
            <span class="bmc-pill__icon">
              <img src="https://cdn.buymeacoffee.com/buttons/bmc-new-btn-logo.svg" alt="" class="bmc-pill__logo" />
            </span>
            <span class="font-sans font-medium text-white text-sm pr-3.5">Buy me a coffee</span>
          </a>
          <hr class="border-rift-200 my-2" />
          {user ? (
            <>
              {profile && ['admin', 'editor'].includes(profile.role) && (
                <a href="/admin" class="block px-4 py-2.5 rounded-lg text-sm font-medium text-rift-300 hover:text-accent-spirit hover:bg-rift-100 transition-all duration-200">
