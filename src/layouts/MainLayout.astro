    <script>
      import { supabase } from '../lib/supabase';

      // Mobile menu
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));

      // Logout mobile
      const mobileLogoutBtn = document.getElementById('mobile-logout-btn');
      mobileLogoutBtn?.addEventListener('click', async (e) => {
        // Bloquer la redirection immédiate par défaut
        e.preventDefault();
        console.log('[auth] Starting bulletproof mobile logout...');
        
        try {
          // 1. Sign out SDK
          await supabase.auth.signOut();
          
          // 2. Clear LocalStorage
          localStorage.removeItem('sb-otbccpoavhfvjpqpzemz-auth-token');
          
          // 3. API Logout et ATTENTE réelle de réponse
          const res = await fetch('/api/auth/logout', { method: 'POST' });
          
          if (res.ok) {
            console.log('[auth] Mobile API Confirmation received.');
          }
        } catch (err) {
          console.error('[auth] Logout error:', err);
        } finally {
          // 4. Redirection manuelle contrôlée
          window.location.replace('/login');
        }
      });

      // Global Auth Listener (ex: Password Recovery redirect)
      supabase.auth.onAuthStateChange((event) => {
        if (event === 'PASSWORD_RECOVERY') {
          console.log('Password recovery event detected, redirecting...');
          if (window.location.pathname !== '/reset-password') {
            window.location.href = '/reset-password';
          }
        }
      });

      // Verification proactive du hash (sécurité pour la prod)
      const hash = window.location.hash;
      if (hash.includes('type=recovery') && window.location.pathname !== '/reset-password') {
        window.location.href = '/reset-password' + hash;
      } else if (hash.includes('type=signup') && window.location.pathname !== '/login') {
        window.location.href = '/login' + hash;
      }

      // Check for dismissed event notification
      const notification = document.getElementById('event-notification');
      if (notification) {
        const eventId = notification.getAttribute('data-event-id');
        if (localStorage.getItem(`dismissed-event-${eventId}`)) {
          notification.remove();
        } else {
          // Show it if not dismissed
          notification.style.display = 'block';
          notification.classList.remove('pointer-events-none');
        }
      }
      // Volet scroll fix: prevent scroll jump when opening/closing details
      document.querySelectorAll('details.article-volet').forEach((volet) => {
        volet.querySelector('summary')?.addEventListener('click', (e) => {
          const scrollY = window.scrollY;
          requestAnimationFrame(() => {
            window.scrollTo(0, scrollY);
          });
        });
      });
    </script>
