---
export const prerender = false;

interface Props {
  title: string;
  activeItem?: string;
}

const { title, activeItem } = Astro.props;
const profile = Astro.locals.profile;

const sidebarItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊', id: 'dashboard' },
  { href: '/admin/articles', label: 'Articles', icon: '📝', id: 'articles' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} — Admin | Riftbound Media</title>
  </head>
  <body class="bg-rift-950 text-gray-100 font-sans min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-surface border-r border-surface-border flex flex-col flex-shrink-0 sticky top-0 h-screen">
      <!-- Logo -->
      <div class="p-4 border-b border-surface-border">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-accent-cyan to-accent-purple flex items-center justify-center text-white font-black text-sm">R</div>
          <span class="text-sm font-bold"><span class="text-white">Riftbound</span> <span class="text-accent-cyan">Admin</span></span>
        </a>
      </div>

      <!-- Nav -->
      <nav class="flex-1 p-3 space-y-1">
        {sidebarItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200',
              activeItem === item.id
                ? 'bg-accent-cyan/10 text-accent-cyan'
                : 'text-gray-400 hover:text-white hover:bg-white/5',
            ]}
          >
            <span class="text-base">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>

      <!-- User info -->
      <div class="p-4 border-t border-surface-border">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent-cyan to-accent-purple flex items-center justify-center text-sm font-bold text-white">
            {profile?.username?.charAt(0)?.toUpperCase() || '?'}
          </div>
          <div class="min-w-0">
            <p class="text-sm font-medium text-white truncate">{profile?.username || 'Utilisateur'}</p>
            <p class="text-xs text-accent-cyan capitalize">{profile?.role || 'user'}</p>
          </div>
        </div>
        <form action="/api/auth/logout" method="POST">
          <button type="submit" class="w-full px-3 py-2 rounded-lg text-sm text-gray-400 hover:text-white hover:bg-white/5 transition-colors text-left">
            Déconnexion
          </button>
        </form>
      </div>
    </aside>

    <!-- Main content -->
    <div class="flex-1 flex flex-col min-h-screen">
      <header class="h-14 border-b border-surface-border flex items-center px-6">
        <h1 class="text-lg font-bold text-white">{title}</h1>
      </header>
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
  </body>
</html>
