---
export const prerender = false;

interface Props {
  title: string;
  activeItem?: string;
}

const { title, activeItem } = Astro.props;
const profile = Astro.locals.profile;

const sidebarItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊', id: 'dashboard' },
  { href: '/admin/articles', label: 'Articles', icon: '📝', id: 'articles' },
  { href: '/admin/calendar', label: 'Calendrier', icon: '📅', id: 'calendar' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} — Admin | Riftbound Media</title>
  </head>
  <body class="bg-rift-950 text-rift-100 font-sans min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-rift-900/90 border-r border-rift-800 flex flex-col flex-shrink-0 sticky top-0 h-screen backdrop-blur-sm">
      <div class="p-4 border-b border-rift-800">
        <a href="/" class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg overflow-hidden"><img src="/riftbound-logo.png" alt="Riftbound" class="w-full h-full object-contain" /></div>
          <span class="text-sm font-bold"><span class="text-rift-900">Riftbound</span> <span class="text-accent-spirit">Admin</span></span>
        </a>
      </div>

      <nav class="flex-1 p-3 space-y-1">
        {sidebarItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200',
              activeItem === item.id
                ? 'bg-accent-spirit/10 text-accent-spirit'
                : 'text-rift-400 hover:text-rift-100 hover:bg-rift-800',
            ]}
          >
            <span class="text-base">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="p-4 border-t border-rift-800">
        <div class="flex items-center gap-3 mb-3">
          {profile?.avatar_url ? (
            <img src={profile.avatar_url} alt="Avatar" class="w-9 h-9 rounded-full object-cover" />
          ) : (
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent-spirit to-accent-sakura flex items-center justify-center text-sm font-bold text-white">
              {profile?.username?.charAt(0)?.toUpperCase() || '?'}
            </div>
          )}
          <div class="min-w-0">
            <p class="text-sm font-medium text-rift-100 truncate">{profile?.username || 'Utilisateur'}</p>
            <p class="text-[10px] text-accent-spirit uppercase tracking-widest font-bold">{profile?.role || 'user'}</p>
          </div>
        </div>
        <button 
          id="logout-btn"
          class="w-full px-3 py-2 rounded-lg text-sm text-rift-400 hover:text-accent-spirit hover:bg-rift-800 transition-colors text-left"
        >
          Déconnexion
        </button>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-h-screen">
      <header class="h-[65px] border-b border-rift-800 flex items-center justify-between px-6 bg-rift-900/50 backdrop-blur-sm">
        <h1 class="text-lg font-display font-bold text-rift-100">{title}</h1>
        <div class="flex items-center gap-4">
          <slot name="header-actions" />
        </div>
      </header>
      <main class="flex-1 p-6">
        <slot />
      </main>
    </div>
    <script>
      import { supabase } from '../lib/supabase';

      const logoutBtn = document.getElementById('logout-btn');
      logoutBtn?.addEventListener('click', async () => {
        console.log('[auth] Starting robust admin logout...');
        
        // 1. Déconnexion client
        await supabase.auth.signOut();
        
        // 2. Clear LocalStorage
        const prefix = 'sb-otbccpoavhfvjpqpzemz-auth-token';
        localStorage.removeItem(prefix);
        
        // 3. Suppression manuelle forcée via loop
        const cookies = document.cookie.split(';');
        for (let i = 0; i < cookies.length; i++) {
          const cookie = cookies[i].trim();
          const eqPos = cookie.indexOf('=');
          const name = eqPos > -1 ? cookie.substr(0, eqPos) : cookie;
          
          if (name.startsWith(prefix)) {
            document.cookie = name + "=; Path=/; Domain=.riftbound-media.fr; Expires=Thu, 01 Jan 1970 00:00:01 GMT;";
          }
        }

        // 4. Déconnexion serveur
        await fetch('/api/auth/logout', { method: 'POST' });
        
        // 5. Redirection vers login
        window.location.href = '/login';
      });
    </script>
  </body>
</html>
