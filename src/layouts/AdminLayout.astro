---
export const prerender = false;

interface Props {
  title: string;
  activeItem?: string;
}

const { title, activeItem } = Astro.props;
const profile = Astro.locals.profile;

const sidebarItems = [
  { href: '/admin', label: 'Dashboard', icon: '📊', id: 'dashboard' },
  { href: '/admin/articles', label: 'Articles', icon: '📝', id: 'articles' },
  { href: '/admin/calendar', label: 'Calendrier', icon: '📅', id: 'calendar' },
  { href: '/admin/alerts', label: 'Alertes', icon: '🔔', id: 'alerts' },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{title} — Admin | Riftbound Media</title>
    <style is:global>
      /* TCG Keyword Badges - Global for Live Preview */
      .badge-keyword {
        display: inline-flex;
        align-items: center;
        padding: 0.05em 0.5em;
        font-weight: 900;
        font-style: italic;
        color: #000 !important;
        position: relative;
        z-index: 1;
        margin: 0 0.4em;
        line-height: normal;
        font-family: 'Outfit', sans-serif;
        text-transform: uppercase;
        font-size: 0.9em;
        vertical-align: middle;
      }
      .badge-keyword::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        transform: skewX(-15deg);
        box-shadow: 0 1px 2px rgba(0,0,0,0.4);
      }
      .badge-keyword-green::before { background-color: #A3CF31; }
      .badge-keyword-red::before { background-color: #E63946; color: #fff; }
      .badge-keyword-red { color: #fff !important; }
    </style>
  </head>
  <body class="bg-rift-950 text-rift-100 font-sans min-h-screen flex">

    <!-- Mobile Overlay -->
    <div id="admin-sidebar-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-40 hidden md:hidden transition-opacity opacity-0"></div>

    <!-- Sidebar -->
    <aside id="admin-sidebar" class="w-64 bg-rift-900/95 border-r border-rift-800 flex flex-col flex-shrink-0 fixed md:sticky top-0 h-screen backdrop-blur-md z-50 transition-transform duration-300 -translate-x-full md:translate-x-0">
      <div class="h-[65px] px-4 border-b border-rift-800 flex justify-between items-center">
        <a href="/" class="flex items-center">
          <img src="/riftbound-titre.png?v=3" alt="Riftbound Media" class="h-20 w-auto -ml-2 object-contain" />
        </a>
        <button id="close-sidebar-btn" class="md:hidden p-2 text-rift-400 hover:text-accent-spirit transition-colors">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <nav class="flex-1 p-3 space-y-1 overflow-y-auto">
        {sidebarItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all duration-200',
              activeItem === item.id
                ? 'bg-accent-spirit/10 text-accent-spirit'
                : 'text-rift-400 hover:text-rift-100 hover:bg-rift-800',
            ]}
          >
            <span class="text-base">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </nav>

      <div class="p-4 border-t border-rift-800">
        <div class="flex items-center gap-3 mb-3">
          {profile?.avatar_url ? (
            <img src={profile.avatar_url} alt="Avatar" class="w-9 h-9 rounded-full object-cover" />
          ) : (
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-accent-spirit to-accent-sakura flex items-center justify-center text-sm font-bold text-white">
              {profile?.username?.charAt(0)?.toUpperCase() || '?'}
            </div>
          )}
          <div class="min-w-0">
            <p class="text-sm font-medium text-rift-100 truncate">{profile?.username || 'Utilisateur'}</p>
            <p class="text-[10px] text-accent-spirit uppercase tracking-widest font-bold">{profile?.role || 'user'}</p>
          </div>
        </div>
        <button 
          id="admin-logout-btn"
          class="w-full px-3 py-2 rounded-lg text-sm text-rift-400 hover:text-accent-spirit hover:bg-rift-800 transition-colors text-left"
        >
          Déconnexion
        </button>
      </div>
    </aside>

    <div class="flex-1 flex flex-col min-h-screen min-w-0 md:ml-0">
      <header class="h-[65px] border-b border-rift-800 flex items-center justify-between px-4 sm:px-6 bg-rift-900/50 backdrop-blur-sm sticky top-0 z-30">
        <div class="flex items-center gap-3">
          <button id="open-sidebar-btn" class="md:hidden p-2 -ml-2 text-rift-400 hover:text-accent-spirit transition-colors">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <h1 class="text-lg font-display font-bold text-rift-100 truncate">{title}</h1>
        </div>
        <div class="flex items-center gap-2 sm:gap-4">
        <slot name="header-actions" />
        </div>
      </header>
      <main class="flex-1 p-4 sm:p-6 overflow-x-hidden">
        <slot />
      </main>
    </div>
    <script>
      import { supabase } from '../lib/supabase';

      // Sidebar Toggle Logic
      const sidebar = document.getElementById('admin-sidebar');
      const overlay = document.getElementById('admin-sidebar-overlay');
      const openBtn = document.getElementById('open-sidebar-btn');
      const closeBtn = document.getElementById('close-sidebar-btn');

      function openSidebar() {
        sidebar?.classList.remove('-translate-x-full');
        overlay?.classList.remove('hidden');
        // Small delay to allow display:block to apply before changing opacity
        setTimeout(() => overlay?.classList.remove('opacity-0'), 10);
        document.body.style.overflow = 'hidden'; // Prevent background scrolling
      }

      function closeSidebar() {
        sidebar?.classList.add('-translate-x-full');
        overlay?.classList.add('opacity-0');
        setTimeout(() => overlay?.classList.add('hidden'), 300); // Wait for transition
        document.body.style.overflow = '';
      }

      openBtn?.addEventListener('click', openSidebar);
      closeBtn?.addEventListener('click', closeSidebar);
      overlay?.addEventListener('click', closeSidebar);

      const adminLogoutBtn = document.getElementById('admin-logout-btn');
      adminLogoutBtn?.addEventListener('click', async (e) => {
        // Bloquer la sortie immédiate
        e.preventDefault();
        console.log('[auth] Starting bulletproof admin logout...');
        
        try {
          // 1. Déconnexion client SDK
          await supabase.auth.signOut();
          
          // 2. Nettoyage LocalStorage
          localStorage.removeItem('sb-otbccpoavhfvjpqpzemz-auth-token');
          
          // 3. Appel API et ATTENTE réelle de réponse
          const res = await fetch('/api/auth/logout', { method: 'POST' });
          
          if (res.ok) {
            console.log('[auth] API logout confirmed, replacing location...');
          } else {
            console.error('[auth] API logout error status:', res.status);
          }
        } catch (err) {
          console.error('[auth] Logout error:', err);
        } finally {
          // 4. Redirection manuelle contrôlée
          window.location.replace('/login');
        }
      });
    </script>
  </body>
</html>
