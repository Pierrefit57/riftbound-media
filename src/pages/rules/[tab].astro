---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import PDFViewer from '../../components/PDFViewer.tsx';
import ErrataViewer from '../../components/ErrataViewer.tsx';
import { supabase } from '../../lib/supabase';
import { proxyUrl } from '../../lib/proxy';
import { articleUrl } from '../../lib/articleUrl';

const { tab } = Astro.params;

// Valid tabs — redirect anything else to /rules/base
const validTabs = ['base', 'tournoi', 'errata'];
if (!validTabs.includes(tab!)) {
  return Astro.redirect('/rules/base', 301);
}

// Cache navigateur uniquement (pas de cache CDN public pour éviter les conflits de session)
Astro.response.headers.set('Cache-Control', 'private, max-age=60');

const activeTab = tab!;

// Fetch metadata for the visual errata articles
const { data: visualArticleUnleashed } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, article_number')
  .eq('slug', 'les-errata-unleashed')
  .single();

const { data: visualArticleSpiritforged } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, article_number')
  .eq('slug', 'les-errata-spiritforged')
  .single();

const { data: visualArticleOrigins } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, article_number')
  .eq('slug', 'les-errata-origins')
  .single();

const errataArticles = [
  {
    title: "Errata Unleashed",
    content: "/pdfs/errata-unleashed.pdf",
    date: "03-04-2026",
    activeClass: "bg-[#722d6c] text-white border-[#722d6c] shadow-[#722d6c]/20",
    textClass: "text-[#722d6c]",
    visualLink: visualArticleUnleashed ? articleUrl(visualArticleUnleashed) : "/news/les-errata-unleashed",
    visualTitle: visualArticleUnleashed?.title || "LES ERRATA UNLEASHED",
    visualSummary: visualArticleUnleashed?.summary || "Découvrez les errata pour le set Unleashed.",
    visualImage: proxyUrl(visualArticleUnleashed?.image_url) || undefined,
    visualDate: visualArticleUnleashed?.published_at 
      ? new Date(visualArticleUnleashed.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
      : "3 avril 2026",
    visualTags: visualArticleUnleashed?.tags || ["Règles", "Errata"]
  },
  {
    title: "Errata Spiritforged",
    content: "/pdfs/errata-spiritforged.pdf",
    date: "14-01-2026",
    activeClass: "bg-[#A5A9B4] text-rift-950 border-[#A5A9B4] shadow-[#A5A9B4]/20",
    textClass: "text-[#A5A9B4]",
    visualLink: visualArticleSpiritforged ? articleUrl(visualArticleSpiritforged) : "/news/les-errata-spiritforged",
    visualTitle: visualArticleSpiritforged?.title || "LES ERRATA SPIRITFORGED",
    visualSummary: visualArticleSpiritforged?.summary || "Un résumé rapide des derniers Errata pour Origins et Spiritforged.",
    visualImage: proxyUrl(visualArticleSpiritforged?.image_url) || undefined,
    visualDate: visualArticleSpiritforged?.published_at 
      ? new Date(visualArticleSpiritforged.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
      : "12 février 2026",
    visualTags: visualArticleSpiritforged?.tags || ["Règles", "Errata"]
  },
  {
    title: "Errata Origins",
    content: "/pdfs/errata-origins.pdf",
    date: "21-10-2025",
    activeClass: "bg-[#C5A059] text-rift-950 border-[#C5A059] shadow-[#C5A059]/20",
    textClass: "text-[#C5A059]",
    visualLink: visualArticleOrigins ? articleUrl(visualArticleOrigins) : "/news/les-errata-origins",
    visualTitle: visualArticleOrigins?.title || "LES ERRATA ORIGINS",
    visualSummary: visualArticleOrigins?.summary || "Découvrez les errata pour le set Origins.",
    visualImage: proxyUrl(visualArticleOrigins?.image_url) || undefined,
    visualDate: visualArticleOrigins?.published_at 
      ? new Date(visualArticleOrigins.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
      : "21 octobre 2025",
    visualTags: visualArticleOrigins?.tags || ["Règles", "Errata"]
  }
];

const tabMeta: Record<string, { title: string; description: string }> = {
  base:    { title: "Règles de base – Riftbound",    description: "Les règles officielles du jeu Riftbound. Tout ce qu'il faut savoir pour jouer." },
  tournoi: { title: "Règles de tournoi – Riftbound", description: "Les règles officielles pour les tournois Riftbound." },
  errata:  { title: "Errata et FAQ – Riftbound",     description: "Les errata et la FAQ officielle pour les sets Origins, Spiritforged et Unleashed." },
};
const meta = tabMeta[activeTab];
---

<MainLayout title={meta.title} description={meta.description} petalMode="sides">
  <!-- JSON-LD FAQ Schema for Errata -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": errataArticles.map(errata => ({
      "@type": "Question",
      "name": `Quels sont les derniers erratas pour ${errata.title} ?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${errata.visualSummary}. Retrouvez les détails sur ${errata.visualLink}`
      }
    }))
  })} />

  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Spiritforged Shading Background -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-spirit-radial pointer-events-none z-0"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
        <span class="text-accent-sakura text-xs font-display tracking-[0.2em] uppercase">Règles</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Règles du Jeu</h1>
      <p class="text-rift-300 leading-relaxed max-w-2xl mx-auto">Tout ce que vous devez savoir pour jouer à Riftbound. Des bases aux règles de tournoi.</p>
    </div>

    <!-- Tabs Navigation — use <a> tags for proper URL routing -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      <a
        href="/rules/base"
        class={`tab-btn w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center ${activeTab === 'base' ? 'active' : ''}`}
      >
        Règles de base
      </a>
      <a
        href="/rules/tournoi"
        class={`tab-btn w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center ${activeTab === 'tournoi' ? 'active' : ''}`}
      >
        Règles de tournoi
      </a>
      <a
        href="/rules/errata"
        class={`tab-btn w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center ${activeTab === 'errata' ? 'active' : ''}`}
      >
        Errata et FAQ
      </a>
    </div>

    <!-- Core Rules Content -->
    {activeTab === 'base' && (
      <div id="core-rules" class="rules-content">
        <div class="bg-rift-800/50 border border-rift-700/50 rounded-2xl p-4 md:p-8 text-center text-rift-300">
          <div class="relative flex flex-col md:flex-row items-center justify-center md:justify-between gap-2 mb-6">
            <div class="lang-toggle flex items-center gap-1">
              <button class="lang-btn active" data-lang="en" data-section="core" aria-label="English">
                <svg width="28" height="18" viewBox="0 0 24 16" fill="none" class="rounded-sm"><rect width="24" height="16" fill="#012169"/><path d="M0 0L24 16M24 0L0 16" stroke="white" stroke-width="3"/><path d="M0 0L24 16M24 0L0 16" stroke="#C8102E" stroke-width="1.5"/><path d="M12 0V16M0 8H24" stroke="white" stroke-width="5"/><path d="M12 0V16M0 8H24" stroke="#C8102E" stroke-width="3"/></svg>
              </button>
              <button class="lang-btn" data-lang="fr" data-section="core" aria-label="Français">
                <svg width="28" height="18" viewBox="0 0 24 16" fill="none" class="rounded-sm"><rect width="8" height="16" fill="#002395"/><rect x="8" width="8" height="16" fill="white"/><rect x="16" width="8" height="16" fill="#ED2939"/></svg>
              </button>
            </div>
            <div class="md:absolute md:left-1/2 md:-translate-x-1/2 w-full md:w-auto text-center">
              <h2 class="text-2xl font-display font-bold text-accent-spirit" data-lang-content="en" data-section="core">
                Core Rules <span class="text-rift-400 font-normal ml-2 text-lg">v 1.4</span>
              </h2>
              <h2 class="text-2xl font-display font-bold text-accent-spirit hidden" data-lang-content="fr" data-section="core">
                Règles de base <span class="text-rift-400 font-normal ml-2 text-lg">v 1.4</span>
              </h2>
            </div>
            <span class="text-sm text-rift-500 italic relative z-10">Mis à jour le <span class="text-emerald-400 font-medium font-sans">16-07-2026</span></span>
          </div>
          <div class="min-h-[600px] w-full bg-rift-900/50 flex flex-col justify-center" data-lang-content="en" data-section="core">
            <PDFViewer client:only="react" url="https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/CR14.pdf" />
          </div>
          <div class="min-h-[600px] w-full bg-rift-900/50 flex flex-col justify-center hidden" data-lang-content="fr" data-section="core">
            <PDFViewer client:only="react" url="https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/FRENCH_CR.pdf" />
          </div>
        </div>
      </div>
    )}

    <!-- Tournament Rules Content -->
    {activeTab === 'tournoi' && (
      <div id="tournament-rules" class="rules-content">
        <div class="bg-rift-800/50 border border-rift-700/50 rounded-2xl p-4 md:p-8 text-center text-rift-300">
          <div class="relative flex flex-col md:flex-row items-center justify-center md:justify-between gap-2 mb-6">
            <div class="lang-toggle flex items-center gap-1">
              <button class="lang-btn active" data-lang="en" data-section="tournament" aria-label="English">
                <svg width="28" height="18" viewBox="0 0 24 16" fill="none" class="rounded-sm"><rect width="24" height="16" fill="#012169"/><path d="M0 0L24 16M24 0L0 16" stroke="white" stroke-width="3"/><path d="M0 0L24 16M24 0L0 16" stroke="#C8102E" stroke-width="1.5"/><path d="M12 0V16M0 8H24" stroke="white" stroke-width="5"/><path d="M12 0V16M0 8H24" stroke="#C8102E" stroke-width="3"/></svg>
              </button>
              <button class="lang-btn" data-lang="fr" data-section="tournament" aria-label="Français">
                <svg width="28" height="18" viewBox="0 0 24 16" fill="none" class="rounded-sm"><rect width="8" height="16" fill="#002395"/><rect x="8" width="8" height="16" fill="white"/><rect x="16" width="8" height="16" fill="#ED2939"/></svg>
              </button>
            </div>
            <div class="md:absolute md:left-1/2 md:-translate-x-1/2 w-full md:w-auto text-center">
              <h2 class="text-2xl font-display font-bold text-accent-spirit" data-lang-content="en" data-section="tournament">
                Tournament Rules
              </h2>
              <h2 class="text-2xl font-display font-bold text-accent-spirit hidden" data-lang-content="fr" data-section="tournament">
                Règles de tournoi
              </h2>
            </div>
            <span class="text-sm text-rift-500 italic relative z-10">Mis à jour le <span class="text-emerald-400 font-medium font-sans">16-07-2026</span></span>
          </div>
          <div class="min-h-[600px] w-full" data-lang-content="en" data-section="tournament">
            <PDFViewer client:only="react" url="https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/TR14.pdf" />
          </div>
          <div class="min-h-[600px] w-full hidden" data-lang-content="fr" data-section="tournament">
            <PDFViewer client:only="react" url="https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/FRENCH_TR.pdf" />
          </div>
        </div>
      </div>
    )}

    <!-- Errata Content -->
    {activeTab === 'errata' && (
      <div id="errata" class="rules-content animate-fade-in">
        <ErrataViewer client:visible articles={errataArticles} />
      </div>
    )}

  </div>
  </div>

</MainLayout>

<style>
  /* Tab Styles */
  .tab-btn {
    @apply bg-rift-800 text-rift-400 hover:text-rift-100;
  }
  
  .tab-btn:hover {
    @apply bg-rift-700/80;
  }

  /* Active Tab Styles */
  .tab-btn.active {
    @apply bg-accent-spirit text-white shadow-spirit;
  }

  /* Language Toggle */
  .lang-btn {
    @apply p-1.5 rounded-lg border-2 border-transparent transition-all duration-200 opacity-50 cursor-pointer;
  }
  .lang-btn:hover {
    @apply opacity-80;
  }
  .lang-btn.active {
    @apply opacity-100 border-accent-spirit bg-rift-700/50;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.lang-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const section = btn.dataset.section;
      const lang = btn.dataset.lang;

      // Toggle active state on buttons
      document.querySelectorAll<HTMLButtonElement>(`.lang-btn[data-section="${section}"]`).forEach(b => {
        b.classList.remove('active');
      });
      btn.classList.add('active');

      // Toggle content visibility
      document.querySelectorAll<HTMLElement>(`[data-lang-content][data-section="${section}"]`).forEach(el => {
        if (el.dataset.langContent === lang) {
          el.classList.remove('hidden');
        } else {
          el.classList.add('hidden');
        }
      });

      // Trigger resize so PDF viewer recalculates dimensions
      setTimeout(() => window.dispatchEvent(new Event('resize')), 150);
    });
  });
</script>
