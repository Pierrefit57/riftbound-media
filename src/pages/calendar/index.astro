---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import CalendarView from '../../components/CalendarView.tsx';
import { supabase } from '../../lib/supabase';
import { proxyUrl } from '../../lib/proxy';

// Récupérer tous les événements (on pourrait filtrer, mais le composant gère le tri par mois)
const { data: events, error } = await supabase
  .from('calendar_events')
  .select('*, image_url')
  .order('start_date', { ascending: true });

const calendarEvents = (events || []).map(e => ({
  ...e,
  image_url: proxyUrl(e.image_url)
}));
const user = Astro.locals.user;
---

<MainLayout title="Calendrier">
  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Spiritforged Shading Background (Coordinated with DA) -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-spirit-radial pointer-events-none z-0"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      <div class="text-center mb-12">
        <div class="flex items-center justify-center gap-4 mb-4 animate-fade-in">
          <div class="h-px w-12 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
          <span class="text-accent-sakura text-xs font-display tracking-[0.3em] uppercase">Événements & Communauté</span>
          <div class="h-px w-12 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
        </div>
        
        <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-50 tracking-tight mb-4">
          Calendrier
        </h1>
        
        <p class="text-rift-300 max-w-xl mx-auto leading-relaxed text-balance text-sm">
          Suivez les tournois, les lives et les mises à jour majeures de l'univers Riftbound. 
          Ne manquez aucun rendez-vous !
        </p>
      </div>

      <!-- Error State -->
      {error && (
        <div class="max-w-2xl mx-auto p-6 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 text-center mb-12">
          <p class="font-bold mb-2">Oups ! Impossible de charger les événements.</p>
          <p class="text-sm opacity-80">{error.message}</p>
        </div>
      )}

      <!-- Interactive Calendar Component -->
      <CalendarView client:only="react" initialEvents={calendarEvents} currentUser={user} />

      <!-- Subscribe & RSS buttons -->
      <div class="flex items-center justify-end gap-3 mt-8 flex-wrap">
        <button id="ics-copy-btn" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-rift-700/50 text-xs font-medium text-rift-400 hover:text-accent-spirit hover:border-accent-spirit/40 transition-all duration-300 group" title="Copier l'URL du calendrier ICS">
          <svg class="w-3.5 h-3.5 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 11v5m0 0l-2-2m2 2l2-2" />
          </svg>
          <span id="ics-copy-text">S'abonner au calendrier</span>
        </button>
        <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-rift-700/50 text-xs font-medium text-rift-400 hover:text-accent-spirit hover:border-accent-spirit/40 transition-all duration-300 group" title="Flux RSS">
          <svg class="w-3.5 h-3.5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
          <span>Flux RSS</span>
        </a>
      </div>

      <!-- Additional Info / CTA -->
      <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-3xl bg-rift-800/20 border border-rift-700/50 backdrop-blur-sm group hover:border-accent-spirit/30 transition-all duration-500">
          <div class="w-12 h-12 rounded-2xl bg-accent-spirit/10 flex items-center justify-center text-accent-spirit mb-6 group-hover:scale-110 transition-transform duration-500">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-rift-50 mb-3">Organisateur ?</h3>
          <p class="text-rift-400 text-sm leading-relaxed mb-6">
            Vous organisez un tournoi, un stream, une soirée spéciale et vous souhaitez apparaître sur notre calendrier ? Contactez notre équipe !
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 text-accent-spirit text-sm font-bold uppercase tracking-widest transition-colors relative group">
            Nous contacter
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-spirit group-hover:w-[calc(100%-1.5rem)] transition-all duration-300"></span>
          </a>
        </div>

        <div class="p-8 rounded-3xl bg-rift-800/20 border border-rift-700/50 backdrop-blur-sm group hover:border-accent-forge/30 transition-all duration-500">
          <div class="w-12 h-12 rounded-2xl bg-accent-spirit/10 flex items-center justify-center text-accent-spirit mb-6 group-hover:scale-110 transition-transform duration-500">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
          </div>
          <h3 class="text-xl font-display font-bold text-rift-50 mb-3">RESTEZ ALERTÉS</h3>
          <p class="text-rift-400 text-sm leading-relaxed mb-6">
            Rejoignez notre Discord officiel pour recevoir des notifications en temps réel avant chaque début d'événement.
          </p>
          <a href="https://discord.gg/QDB6WfA9Zm" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-accent-spirit text-sm font-bold uppercase tracking-widest transition-colors relative group">
            Rejoindre le Discord
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
            <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-accent-spirit group-hover:w-[calc(100%-1.5rem)] transition-all duration-300"></span>
          </a>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const icsBtn = document.getElementById('ics-copy-btn');
  const icsText = document.getElementById('ics-copy-text');

  icsBtn?.addEventListener('click', async () => {
    const feedUrl = `${window.location.origin}/api/calendar/feed.ics`;
    try {
      await navigator.clipboard.writeText(feedUrl);
      if (icsText) {
        icsText.textContent = 'URL copiée ✓';
        icsBtn.classList.add('!text-green-400', '!border-green-500/40');
        setTimeout(() => {
          icsText.textContent = "S'abonner au calendrier";
          icsBtn.classList.remove('!text-green-400', '!border-green-500/40');
        }, 2500);
      }
    } catch {
      // Fallback: open in new tab for manual copy
      window.open(feedUrl, '_blank');
    }
  });
</script>

<style>
  @keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-fade-in {
    animation: fade-in 1s ease forwards;
  }
  @keyframes fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
