---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import PDFViewer from '../components/PDFViewer.tsx';
import ErrataViewer from '../components/ErrataViewer.tsx';
import { supabase } from '../lib/supabase';
import { proxyUrl } from '../lib/proxy';

// Fetch metadata for the visual errata articles
const { data: visualArticleSpiritforged } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', 'les-errata-spiritforged')
  .single();

const { data: visualArticleOrigins } = await supabase
  .from('articles')
  .select('*')
  .eq('slug', 'les-errata-origins')
  .single();

const errataArticles = [
  {
    title: "Errata Spiritforged",
    content: proxyUrl("https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/UPDATED%20Riftbound%20Erratas%20Spiritforged.pdf"),
    date: "14-01-2026",
    activeClass: "bg-[#A5A9B4] text-rift-950 border-[#A5A9B4] shadow-[#A5A9B4]/20",
    textClass: "text-[#A5A9B4]",
    visualLink: "/news/les-errata-spiritforged",
    visualTitle: visualArticleSpiritforged?.title || "LES ERRATA SPIRITFORGED",
    visualSummary: visualArticleSpiritforged?.summary || "Un résumé rapide des derniers Errata pour Origins et Spiritforged.",
    visualImage: proxyUrl(visualArticleSpiritforged?.image_url) || undefined,
    visualDate: visualArticleSpiritforged?.published_at 
      ? new Date(visualArticleSpiritforged.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
      : "12 février 2026",
    visualTags: visualArticleSpiritforged?.tags || ["Règles", "Errata"]
  },
  {
    title: "Errata Origins",
    content: proxyUrl("https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/Riftbound%20Card%20Errata%20Origins%20.pdf"),
    date: "21-10-2025",
    activeClass: "bg-[#C5A059] text-rift-950 border-[#C5A059] shadow-[#C5A059]/20",
    textClass: "text-[#C5A059]",
    visualLink: "/news/les-errata-origins",
    visualTitle: visualArticleOrigins?.title || "LES ERRATA ORIGINS",
    visualSummary: visualArticleOrigins?.summary || "Découvrez les errata pour le set Origins.",
    visualImage: proxyUrl(visualArticleOrigins?.image_url) || undefined,
    visualDate: visualArticleOrigins?.published_at 
      ? new Date(visualArticleOrigins.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
      : "21 octobre 2025",
    visualTags: visualArticleOrigins?.tags || ["Règles", "Errata"]
  }
];
---

<MainLayout title="Règles du Jeu" petalMode="sides">

  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Spiritforged Shading Background -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-spirit-radial pointer-events-none z-0"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
        <span class="text-accent-sakura text-xs font-display tracking-[0.2em] uppercase">Règles</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Règles du Jeu</h1>
      <p class="text-rift-300 leading-relaxed max-w-2xl mx-auto">Tout ce que vous devez savoir pour jouer à Riftbound. Des bases aux règles de tournoi.</p>
      <p class="text-rift-400 italic text-sm mt-4">Les règles officielles n'existent qu'en anglais pour le moment</p>
    </div>

    <!-- Tabs Navigation -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="rules-tabs">
      <button 
        class="tab-btn active w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center"
        data-target="#core-rules"
      >
        Règles de base
      </button>
      <button 
        class="tab-btn w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center"
        data-target="#tournament-rules"
      >
        Règles de tournoi
      </button>
      <button 
        class="tab-btn w-48 px-2 py-2.5 rounded-xl font-display font-bold text-sm transition-all duration-300 border border-transparent text-center"
        data-target="#errata"
      >
        Errata et FAQ
      </button>
    </div>

    <!-- Core Rules Content -->
    <div id="core-rules" class="rules-content">
       <div class="bg-rift-800/50 border border-rift-700/50 rounded-2xl p-4 md:p-8 text-center text-rift-300">
            <div class="relative flex flex-col md:flex-row items-center justify-center md:justify-end gap-2 mb-6">
                 <h2 class="text-2xl font-display font-bold text-accent-spirit md:absolute md:left-1/2 md:-translate-x-1/2 w-full md:w-auto text-center">
                    Core Rules <span class="text-rift-400 font-normal ml-2 text-lg">v 1.2</span>
                 </h2>
                 <span class="text-sm text-rift-500 italic relative z-10">Mis à jour le 01-12-2025</span>
            </div>
            <div class="min-h-[600px] w-full bg-rift-900/50 flex flex-col justify-center">
              <PDFViewer client:only="react" url={proxyUrl("https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/Riftbound%20Core%20Rules%20v1.2.pdf")} />
            </div>
        </div>
    </div>

    <!-- Tournament Rules Content -->
    <div id="tournament-rules" class="rules-content hidden">
        <div class="bg-rift-800/50 border border-rift-700/50 rounded-2xl p-4 md:p-8 text-center text-rift-300">
             <div class="relative flex flex-col md:flex-row items-center justify-center md:justify-end gap-2 mb-6">
                 <h2 class="text-2xl font-display font-bold text-accent-spirit md:absolute md:left-1/2 md:-translate-x-1/2 w-full md:w-auto text-center">
                    Tournament Rules
                 </h2>
                 <span class="text-sm text-rift-500 italic relative z-10">Mis à jour le 30-01-2025</span>
            </div>
            <div class="min-h-[600px] w-full">
              <PDFViewer client:only="react" url={proxyUrl("https://otbccpoavhfvjpqpzemz.supabase.co/storage/v1/object/public/PDFrules/Tournament%20Rules,%20January%20Update.pdf")} />
            </div>
        </div>
    </div>

    <!-- Errata Content -->
    <div id="errata" class="rules-content hidden animate-fade-in">
        <ErrataViewer client:visible articles={errataArticles} />
    </div>

  </div>
  </div>

</MainLayout>

<style>
  /* Tab Styles */
  .tab-btn {
    @apply bg-rift-800 text-rift-400 hover:text-rift-100;
  }
  
  .tab-btn:hover {
    @apply bg-rift-700/80;
  }

  /* Active Tab Styles - varying colors could be nice, let's Stick to Orange for now for consistency */
  .tab-btn.active {
    @apply bg-accent-spirit text-white shadow-spirit;
  }

  /* Content formatting would go here */
</style>

<script>
  const buttons = document.querySelectorAll('.tab-btn');
  const contents = document.querySelectorAll('.rules-content');

  // Helper to handle ResizeObserver trigger for PDF viewer when tab becomes visible
  const triggerResize = () => {
    // Dispatch a resize event to trigger implicit observers if any
    window.dispatchEvent(new Event('resize'));
  }

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      // 1. Remove active class from all buttons
      buttons.forEach(b => b.classList.remove('active'));
      // 2. Add active class to clicked button
      btn.classList.add('active');

      // 3. Hide all content
      contents.forEach(c => c.classList.add('hidden'));

      // 4. Show target content
      const targetId = (btn as HTMLElement).dataset.target;
      const targetContent = document.querySelector(targetId!);
      targetContent?.classList.remove('hidden');

      // Trigger resize to help PDF viewer detect visibility change immediately if needed
      // (Though the internal ResizeObserver in viewer.html handles this effectively)
      setTimeout(triggerResize, 50);
    });
  });
</script>
