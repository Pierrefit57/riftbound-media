---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

if (Astro.locals.user) {
  return Astro.redirect('/');
}

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email') as string;
  const password = formData.get('password') as string;
  const username = formData.get('username') as string;

  const { data, error } = await supabase.auth.signUp({
    email,
    password,
    options: {
      data: { full_name: username },
    },
  });

  if (error) {
    errorMsg = error.message === 'User already registered'
      ? 'Un compte existe déjà avec cet email.'
      : 'Erreur lors de l\'inscription. Veuillez réessayer.';
  } else {
    successMsg = 'Compte créé ! Vérifiez votre email pour confirmer votre inscription.';
  }
}
---

<MainLayout title="Inscription">
  <div class="max-w-md mx-auto px-4 pt-16 pb-20">

    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
        <span class="text-accent-sakura text-xs font-display tracking-[0.2em] uppercase">Rejoindre</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
      </div>
      <h1 class="text-3xl font-display font-bold text-rift-900 mb-2">Créer un compte</h1>
      <p class="text-rift-500 text-sm">Rejoignez la communauté Riftbound Media</p>
    </div>

    <div class="bg-white/70 rounded-2xl border border-rift-200/80 p-6 space-y-6 shadow-card">

      <a
        id="discord-register-btn"
        href="#"
        class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-xl bg-[#5865F2] text-white font-semibold hover:bg-[#4752C4] transition-all duration-300 shadow-lg shadow-[#5865F2]/15 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
        S'inscrire avec Discord
      </a>

      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-rift-200"></div>
        <span class="text-xs text-rift-400 font-display tracking-wider uppercase">ou</span>
        <div class="flex-1 h-px bg-rift-200"></div>
      </div>

      <form method="POST" class="space-y-4">
        {errorMsg && (
          <div class="p-3 rounded-xl bg-accent-spirit/10 border border-accent-spirit/25 text-accent-spirit text-sm">
            {errorMsg}
          </div>
        )}
        {successMsg && (
          <div class="p-3 rounded-xl bg-domain-calm/10 border border-domain-calm/25 text-domain-calm text-sm">
            {successMsg}
          </div>
        )}

        <div>
          <label for="username" class="block text-sm font-medium text-rift-700 mb-1.5">Nom d'utilisateur</label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full px-4 py-2.5 rounded-xl bg-rift-50 border border-rift-200 text-rift-900 placeholder-rift-400 focus:outline-none focus:border-accent-sakura/50 focus:ring-2 focus:ring-accent-sakura/15 transition-all duration-300"
            placeholder="VoidReaver57"
          />
        </div>

        <div>
          <label for="email" class="block text-sm font-medium text-rift-700 mb-1.5">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2.5 rounded-xl bg-rift-50 border border-rift-200 text-rift-900 placeholder-rift-400 focus:outline-none focus:border-accent-spirit/50 focus:ring-2 focus:ring-accent-spirit/15 transition-all duration-300"
            placeholder="vous@exemple.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-rift-700 mb-1.5">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            class="w-full px-4 py-2.5 rounded-xl bg-rift-50 border border-rift-200 text-rift-900 placeholder-rift-400 focus:outline-none focus:border-accent-spirit/50 focus:ring-2 focus:ring-accent-spirit/15 transition-all duration-300"
            placeholder="Min. 6 caractères"
          />
        </div>

        <button
          type="submit"
          class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-accent-spirit to-accent-sakura text-white font-semibold hover:shadow-sakura transition-all duration-300 hover:-translate-y-0.5"
        >
          Créer mon compte
        </button>
      </form>

      <p class="text-center text-sm text-rift-500">
        Déjà un compte ?
        <a href="/login" class="text-accent-spirit hover:text-accent-forge transition-colors duration-200 font-medium">Se connecter</a>
      </p>
    </div>
  </div>

  <script>
    const discordBtn = document.getElementById('discord-register-btn');
    discordBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
      const { data } = await supabase.auth.signInWithOAuth({
        provider: 'discord',
        options: { redirectTo: `${window.location.origin}/api/auth/callback` },
      });
      if (data?.url) window.location.href = data.url;
    });
  </script>
</MainLayout>
