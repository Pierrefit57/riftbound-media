---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Nouveau mot de passe">
  <div class="max-w-md mx-auto px-4 pt-16 pb-20">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-3xl font-display font-bold text-rift-100 mb-2">Réinitialisation</h1>
      <p class="text-rift-400 text-sm">Choisissez un nouveau mot de passe sécurisé.</p>
    </div>

    <!-- Card -->
    <div class="bg-rift-800/80 rounded-2xl border border-rift-700/50 p-6 space-y-6 shadow-card">
      
      <div id="loading" class="text-center text-rift-400">
        Vérification du lien...
      </div>

      <div id="error-message" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/25 text-red-400 text-sm"></div>
      <div id="success-message" class="hidden p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-sm">
        Mot de passe mis à jour avec succès ! Redirection...
      </div>

      <form id="reset-form" class="hidden space-y-4">
        <div>
          <label for="password" class="block text-sm font-medium text-rift-200 mb-1.5">Nouveau mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            class="w-full px-4 py-2.5 rounded-xl bg-rift-900/50 border border-rift-700 text-rift-100 placeholder-rift-500 focus:outline-none focus:border-accent-spirit/50 focus:ring-2 focus:ring-accent-spirit/15 transition-all duration-300"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full px-4 py-3 rounded-xl bg-accent-spirit text-white font-semibold hover:bg-accent-spirit/90 shadow-spirit transition-all duration-300 hover:-translate-y-0.5"
        >
          Valider le nouveau mot de passe
        </button>
      </form>

    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    const form = document.getElementById('reset-form');
    const loading = document.getElementById('loading');
    const errorDiv = document.getElementById('error-message');
    const successDiv = document.getElementById('success-message');

    // Vérifier si on est en mode recovery
    supabase.auth.onAuthStateChange(async (event, session) => {
      if (event === "PASSWORD_RECOVERY") {
        // L'utilisateur est connecté avec un token temporaire, on affiche le formulaire
        loading.classList.add('hidden');
        form.classList.remove('hidden');
      } else if (event === "SIGNED_IN") { 
         // Parfois Signed In arrive aussi, on vérifie si on vient d'un lien recovery via l'URL si besoin, 
         // mais le flow standard Supabase gère ça.
         loading.classList.add('hidden');
         form.classList.remove('hidden');
      }
    });

    // Fallback si pas d'event immédiat (ex: déjà hydraté)
    // On check la session
    supabase.auth.getSession().then(({ data: { session } }) => {
        if (session) {
            loading.classList.add('hidden');
            form.classList.remove('hidden');
        } else {
             // Si pas de session, et pas de hash recovery, c'est louche.
             // On attend un peu l'event, sinon erreur.
             setTimeout(() => {
                 if (!form.classList.contains('hidden')) return;
                 // Vérif hash manuellle si besoin
                 const hash = window.location.hash;
                 if (hash && hash.includes('type=recovery')) {
                     // Supabase devrait le catch
                 } else {
                     loading.innerText = "Lien invalide ou expiré.";
                 }
             }, 2000);
        }
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      
      const { error } = await supabase.auth.updateUser({ password });

      if (error) {
        errorDiv.textContent = error.message;
        errorDiv.classList.remove('hidden');
      } else {
        form.classList.add('hidden');
        successDiv.classList.remove('hidden');
        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
      }
    });
  </script>
</MainLayout>
