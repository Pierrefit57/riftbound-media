---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

// Rediriger si déjà connecté
if (Astro.locals.user) {
  return Astro.redirect('/');
}

let errorMsg = '';

// Traiter le formulaire de login email/password
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email') as string;
  const password = formData.get('password') as string;

  const { data, error } = await supabase.auth.signInWithPassword({
    email,
    password,
  });

  if (error) {
    errorMsg = 'Email ou mot de passe incorrect.';
  } else if (data.session) {
    Astro.cookies.set('sb-access-token', data.session.access_token, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    Astro.cookies.set('sb-refresh-token', data.session.refresh_token, {
      path: '/',
      httpOnly: true,
      secure: true,
      sameSite: 'lax',
      maxAge: 60 * 60 * 24 * 7,
    });
    return Astro.redirect('/');
  }
}
---

<MainLayout title="Connexion">
  <div class="max-w-md mx-auto px-4 pt-16 pb-20">

    <div class="text-center mb-8">
      <h1 class="text-3xl font-black text-white mb-2">Connexion</h1>
      <p class="text-gray-400">Connectez-vous à votre compte Riftbound Media</p>
    </div>

    <div class="bg-surface rounded-xl border border-surface-border p-6 space-y-6">

      <!-- Discord OAuth -->
      <a
        id="discord-login-btn"
        href="#"
        class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-lg bg-[#5865F2] text-white font-semibold hover:bg-[#4752C4] transition-colors"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
        Continuer avec Discord
      </a>

      <!-- Séparateur -->
      <div class="flex items-center gap-3">
        <div class="flex-1 h-px bg-surface-border"></div>
        <span class="text-xs text-gray-500 uppercase">ou</span>
        <div class="flex-1 h-px bg-surface-border"></div>
      </div>

      <!-- Formulaire email/password -->
      <form method="POST" class="space-y-4">
        {errorMsg && (
          <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
            {errorMsg}
          </div>
        )}

        <div>
          <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            placeholder="vous@exemple.com"
          />
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-gray-300 mb-1.5">Mot de passe</label>
          <input
            type="password"
            id="password"
            name="password"
            required
            minlength="6"
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full px-4 py-2.5 rounded-lg bg-accent-cyan text-rift-950 font-semibold hover:bg-accent-cyan/90 transition-colors"
        >
          Se connecter
        </button>
      </form>

      <p class="text-center text-sm text-gray-400">
        Pas encore de compte ?
        <a href="/register" class="text-accent-cyan hover:underline">Créer un compte</a>
      </p>
    </div>
  </div>

  <script>
    const discordBtn = document.getElementById('discord-login-btn');
    discordBtn?.addEventListener('click', async (e) => {
      e.preventDefault();
      const { createClient } = await import('@supabase/supabase-js');
      const supabase = createClient(
        import.meta.env.PUBLIC_SUPABASE_URL,
        import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      );
      const { data, error } = await supabase.auth.signInWithOAuth({
        provider: 'discord',
        options: { redirectTo: `${window.location.origin}/api/auth/callback` },
      });
      if (data?.url) window.location.href = data.url;
    });
  </script>
</MainLayout>
