---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { sendEmail } from '../lib/email';

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const name = formData.get('name') as string;
    const email = formData.get('email') as string;
    const subject = formData.get('subject') as string;
    const message = formData.get('message') as string;

    const { error } = await sendEmail({
      to: 'contact@riftbound-media.fr',
      subject: `[Contact Form] ${subject} - ${name}`,
      html: `
        <div style="font-family: sans-serif; line-height: 1.6; color: #333;">
          <h2 style="color: #E9870F;">Nouveau message de contact</h2>
          <p><strong>Nom :</strong> ${name}</p>
          <p><strong>Email :</strong> ${email}</p>
          <p><strong>Sujet :</strong> ${subject}</p>
          <hr style="border: none; border-top: 1px solid #eee; margin: 20px 0;">
          <p><strong>Message :</strong></p>
          <div style="background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #eee;">
            ${message.replace(/\n/g, '<br>')}
          </div>
        </div>
      `,
    });

    if (error) {
      console.error("Erreur d'envoi de formulaire:", error);
      errorMsg = "Une erreur est survenue lors de l'envoi du message. Veuillez réessayer.";
    } else {
      successMsg = 'Merci ! Votre message a bien été envoyé.';
    }
  } catch (err) {
    console.error("Exception lors de l'envoi du formulaire:", err);
    errorMsg = "Une erreur inattendue est survenue.";
  }
}
---

<MainLayout title="Aide & Support" petals={true}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-32 pb-20 relative z-10">
    
    <!-- Hero Header -->
    <div class="text-center mb-16">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-accent-spirit"></div>
        <span class="text-accent-spirit text-xs font-display tracking-[0.2em] uppercase">Besoin d'aide ?</span>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-accent-spirit"></div>
      </div>
      <h1 class="text-4xl md:text-5xl font-display font-bold text-rift-100 mb-4 uppercase tracking-tight">Aide & Support</h1>
      <p class="text-rift-300 max-w-2xl mx-auto text-lg leading-relaxed">
        Vous avez une question sur Riftbound Media ? Notre équipe est là pour vous accompagner !
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      
      <!-- Left Column: Info -->
      <div class="rounded-3xl border border-rift-700/50 bg-rift-800/40 backdrop-blur-xl p-8 lg:p-10 shadow-2xl h-full">
        <div class="flex items-center gap-3 mb-10">
          <div class="w-10 h-10 rounded-xl bg-accent-spirit/10 border border-accent-spirit/20 flex items-center justify-center text-accent-spirit">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
          </div>
          <h2 class="text-xl font-display font-bold text-white uppercase tracking-wider">Informations de Contact</h2>
        </div>

        <div class="space-y-10 group">
          <!-- Email Support -->
          <div class="relative pl-4 border-l-2 border-accent-spirit/30 hover:border-accent-spirit transition-colors duration-300">
            <h3 class="text-xs font-display font-bold text-accent-spirit uppercase tracking-widest mb-2">Email Support</h3>
            <a href="mailto:contact@riftbound-media.fr" class="text-lg text-rift-100 hover:text-white transition-colors block font-medium">
              contact@riftbound-media.fr
            </a>
          </div>

          <!-- Response Time -->
          <div class="pt-6 mt-10 border-t border-rift-700/50">
            <p class="text-rift-400 text-sm italic leading-relaxed">
              <strong class="text-rift-200 not-italic block mb-2 uppercase text-[10px] tracking-widest">Délai de réponse</strong>
              Nous répondons généralement aux emails sous 24h à 48h.
            </p>
          </div>
        </div>

      </div>

      <!-- Right Column: Form -->
      <div class="rounded-3xl border border-rift-700/50 bg-rift-900/40 backdrop-blur-xl p-8 lg:p-10 shadow-2xl ring-1 ring-white/5">
        <div class="flex items-center gap-3 mb-10">
          <div class="w-10 h-10 rounded-xl bg-accent-forge/10 border border-accent-forge/20 flex items-center justify-center text-accent-forge">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h2 class="text-xl font-display font-bold text-white uppercase tracking-wider">Envoyez-nous un message</h2>
        </div>

        {successMsg ? (
          <div class="py-12 text-center animate-slide-up">
            <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-6 shadow-xl shadow-emerald-500/10">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="text-xl font-display font-bold text-white mb-2">{successMsg}</h3>
            <p class="text-rift-400 text-sm">Nous reviendrons vers vous très prochainement.</p>
            <button onclick="window.location.reload()" class="mt-8 text-accent-spirit text-sm font-bold hover:underline">Envoyer un autre message</button>
          </div>
        ) : (
          <form method="POST" class="space-y-6">
            {errorMsg && (
              <div class="p-4 rounded-xl bg-accent-spirit/10 border border-accent-spirit/25 text-accent-spirit text-sm animate-shake">
                {errorMsg}
              </div>
            )}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="block text-xs font-bold text-rift-400 uppercase tracking-widest pl-1">Nom *</label>
                <input 
                  type="text" 
                  id="name" 
                  name="name" 
                  required 
                  placeholder="Votre nom"
                  class="w-full px-4 py-3.5 rounded-xl bg-rift-950/50 border border-rift-700 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit transition-all text-sm font-medium"
                />
              </div>
              <div class="space-y-2">
                <label for="email" class="block text-xs font-bold text-rift-400 uppercase tracking-widest pl-1">Email *</label>
                <input 
                  type="email" 
                  id="email" 
                  name="email" 
                  required 
                  placeholder="votre.email@exemple.com"
                  class="w-full px-4 py-3.5 rounded-xl bg-rift-950/50 border border-rift-700 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit transition-all text-sm font-medium"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label for="subject" class="block text-xs font-bold text-rift-400 uppercase tracking-widest pl-1">Sujet *</label>
              <input 
                type="text" 
                id="subject" 
                name="subject" 
                required 
                placeholder="De quoi s'agit-il ?"
                class="w-full px-4 py-3.5 rounded-xl bg-rift-950/50 border border-rift-700 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit transition-all text-sm font-medium"
              />
            </div>

            <div class="space-y-2">
              <label for="message" class="block text-xs font-bold text-rift-400 uppercase tracking-widest pl-1">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="6" 
                required 
                placeholder="Dites-nous comment nous pouvons vous aider..."
                class="w-full px-4 py-3.5 rounded-xl bg-rift-950/50 border border-rift-700 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit transition-all text-sm font-medium resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full px-8 py-4 rounded-xl bg-accent-spirit text-white font-display font-bold tracking-widest uppercase text-sm transition-all hover:bg-accent-spirit/90 hover:shadow-lg hover:shadow-accent-spirit/20 hover:-translate-y-0.5 active:translate-y-0 flex items-center justify-center gap-3 group"
            >
              Envoyer le message
              <svg class="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
              </svg>
            </button>
          </form>
        )}
      </div>

    </div>
  </div>
</MainLayout>
