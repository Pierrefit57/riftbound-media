---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { createServiceClient } from '../lib/supabase';

const user = Astro.locals.user;
const profile = Astro.locals.profile;

if (!user) {
  return Astro.redirect('/login');
}

let successMsg = '';
let errorMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action') as string;

  if (action === 'update-avatar') {
    const file = formData.get('avatar') as File;
    if (file && file.size > 0) {
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
      if (!allowedTypes.includes(file.type)) {
        errorMsg = 'Format non supporté. Utilisez JPG, PNG ou WebP.';
      } else if (file.size > 2 * 1024 * 1024) {
        errorMsg = 'Image trop lourde (max 2 Mo).';
      } else {
        const supabase = createServiceClient();
        const ext = file.name.split('.').pop()?.toLowerCase() || 'png';
        const fileName = `${user.id}-${Date.now()}.${ext}`;
        const filePath = `avatars/${fileName}`;

        const arrayBuffer = await file.arrayBuffer();
        const buffer = new Uint8Array(arrayBuffer);

        const { error: uploadError } = await supabase.storage
          .from('article-images')
          .upload(filePath, buffer, {
            contentType: file.type,
            upsert: true,
          });

        if (uploadError) {
          console.error('[account] Avatar upload error:', uploadError);
          errorMsg = 'Erreur lors de l\'upload de l\'avatar.';
        } else {
          const { data: { publicUrl } } = supabase.storage
            .from('article-images')
            .getPublicUrl(filePath);

          const { error: updateError } = await supabase
            .from('profiles')
            .update({ avatar_url: publicUrl })
            .eq('id', user.id);

          if (updateError) {
            errorMsg = 'Erreur lors de la mise à jour du profil.';
          } else {
            successMsg = 'Photo de profil mise à jour !';
          }
        }
      }
    }
  }

  if (action === 'update-username') {
    const newUsername = formData.get('username') as string;
    if (newUsername && newUsername.length >= 2 && newUsername.length <= 30) {
      const supabase = createServiceClient();
      const { error } = await supabase
        .from('profiles')
        .update({ username: newUsername })
        .eq('id', user.id);

      if (error) {
        errorMsg = error.code === '23505'
          ? 'Ce nom d\'utilisateur est déjà pris.'
          : 'Erreur lors de la mise à jour.';
      } else {
        successMsg = 'Nom d\'utilisateur mis à jour !';
      }
    } else {
      errorMsg = 'Le nom doit contenir entre 2 et 30 caractères.';
    }
  }
}

// Recharger le profil après modification
const supabase = createServiceClient();
const { data: freshProfile } = await supabase
  .from('profiles')
  .select('*')
  .eq('id', user.id)
  .single();

const displayProfile = freshProfile || profile;
const joinDate = new Date(displayProfile?.created_at).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

function getRoleBadge(role: string) {
  switch (role) {
    case 'admin': return { label: 'Administrateur', class: 'bg-accent-forge/10 text-accent-forge border-accent-forge/25' };
    case 'editor': return { label: 'Rédacteur', class: 'bg-accent-spirit/10 text-accent-spirit border-accent-spirit/25' };
    default: return { label: 'Membre', class: 'bg-rift-200/50 text-rift-600 border-rift-300/50' };
  }
}

const roleBadge = getRoleBadge(displayProfile?.role || 'user');
---

<MainLayout title="Mon compte" petals={true}>

  <div class="max-w-xl mx-auto px-4 sm:px-6 pt-32 pb-20 relative z-10">

    {successMsg && (
      <div class="p-4 mb-6 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-medium flex items-center gap-2 shadow-lg shadow-emerald-900/10 animate-slide-up backdrop-blur-sm">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        {successMsg}
      </div>
    )}

    {errorMsg && (
      <div class="p-4 mb-6 rounded-2xl bg-red-500/10 border border-red-500/20 text-red-400 text-sm font-medium flex items-center gap-2 shadow-lg shadow-red-900/10 animate-slide-up backdrop-blur-sm">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
        {errorMsg}
      </div>
    )}

    <!-- Main Profile Card -->
    <div class="rounded-3xl border border-rift-700/50 bg-rift-800/60 backdrop-blur-xl shadow-2xl overflow-hidden ring-1 ring-white/5">

      <!-- Avatar section — centered -->
      <div class="flex flex-col items-center pt-8 pb-8 px-6 bg-gradient-to-b from-rift-800/50 to-transparent">
        <!-- Avatar -->
        <form method="POST" enctype="multipart/form-data" id="avatar-form" class="relative group mb-6">
          <input type="hidden" name="action" value="update-avatar" />
          <div class="relative w-32 h-32">
            <!-- Glow effect -->
            <div class="absolute inset-0 bg-accent-spirit/20 blur-2xl rounded-full scale-110 opacity-50 group-hover:opacity-100 transition-opacity duration-500"></div>
            
            <div class="relative w-full h-full aspect-square rounded-full border-4 border-rift-900 shadow-2xl bg-gradient-to-br from-accent-spirit to-accent-sakura overflow-hidden ring-2 ring-accent-spirit/30 group-hover:ring-accent-spirit/60 transition-all duration-300">
              {displayProfile?.avatar_url ? (
                <img src={displayProfile.avatar_url} alt="Avatar" class="w-full h-full object-cover aspect-square" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-4xl font-bold text-white font-display">
                  {displayProfile?.username?.charAt(0)?.toUpperCase() || '?'}
                </div>
              )}
            </div>

            <label class="absolute inset-0 rounded-full bg-rift-900/0 group-hover:bg-rift-900/60 transition-all duration-300 cursor-pointer flex items-center justify-center z-10 border-4 border-transparent">
              <div class="opacity-0 group-hover:opacity-100 transition-all duration-300 flex flex-col items-center gap-1 transform translate-y-2 group-hover:translate-y-0">
                <svg class="w-6 h-6 text-accent-spirit drop-shadow-md" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z" />
                </svg>
                <span class="text-[10px] text-white font-bold tracking-widest uppercase">Modifier</span>
              </div>
              <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp" class="hidden" onchange="document.getElementById('avatar-form').submit()" />
            </label>
          </div>
        </form>

        <!-- Username & info -->
        <h1 class="text-3xl font-display font-bold text-white mb-2 tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-white via-rift-100 to-rift-300">
          {displayProfile?.username || 'Utilisateur'}
        </h1>
        <span class={`px-4 py-1 text-xs font-bold rounded-full border mb-6 uppercase tracking-wider ${roleBadge.class}`}>
          {roleBadge.label}
        </span>

        <!-- Info grid -->
        <div class="w-full max-w-md grid grid-cols-2 gap-4 mt-2">
          <div class="rounded-xl bg-rift-900/40 border border-rift-700/50 p-4 text-center hover:bg-rift-900/60 transition-colors">
            <p class="text-[10px] uppercase tracking-widest text-rift-400 font-semibold mb-1.5 flex items-center justify-center gap-1.5">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              Email
            </p>
            <p class="text-sm text-rift-200 font-medium truncate px-2" title={user.email}>{user.email}</p>
          </div>
          <div class="rounded-xl bg-rift-900/40 border border-rift-700/50 p-4 text-center hover:bg-rift-900/60 transition-colors">
            <p class="text-[10px] uppercase tracking-widest text-rift-400 font-semibold mb-1.5 flex items-center justify-center gap-1.5">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              Membre depuis
            </p>
            <p class="text-sm text-rift-200 font-medium">{joinDate}</p>
          </div>
        </div>
      </div>

      <!-- Divider -->
      <div class="h-px bg-gradient-to-r from-transparent via-rift-700/50 to-transparent mx-8"></div>

      <!-- Settings section -->
      <div class="p-8 space-y-8">

        <!-- Change Username -->
        <div>
          <h3 class="text-sm font-display font-bold text-rift-100 mb-4 flex items-center gap-2 uppercase tracking-wide">
            <svg class="w-4 h-4 text-accent-spirit" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
            Nom d'utilisateur
          </h3>
          <form method="POST" class="flex gap-3">
            <input type="hidden" name="action" value="update-username" />
            <div class="relative flex-1">
              <input type="text" name="username" value={displayProfile?.username || ''} required minlength="2" maxlength="30"
                class="w-full px-4 py-3 rounded-xl bg-rift-950/50 border border-rift-700 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit transition-all text-sm font-medium pl-10"
                placeholder="Votre pseudo"
              />
              <svg class="w-4 h-4 text-rift-500 absolute left-3.5 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
              </svg>
            </div>
            
            <button type="submit" class="px-6 py-2.5 rounded-xl bg-accent-spirit text-white text-sm font-bold uppercase tracking-wide hover:bg-accent-spirit/90 transition-all shadow-lg shadow-accent-spirit/20 hover:shadow-accent-spirit/40 hover:-translate-y-0.5 active:translate-y-0">
              Enregistrer
            </button>
          </form>
          <p class="text-[10px] text-rift-500 mt-2 ml-1">Ce nom sera visible publiquement sur vos commentaires et articles.</p>
        </div>

        <!-- Divider -->
        <div class="h-px bg-rift-700/30"></div>

        <!-- Logout -->
        <div class="flex items-center justify-between group">
          <div>
            <h3 class="text-sm font-display font-bold text-rift-200 group-hover:text-white transition-colors flex items-center gap-2 uppercase tracking-wide">
              <svg class="w-4 h-4 text-red-400 group-hover:text-red-300 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" /></svg>
              Déconnexion
            </h3>
            <p class="text-xs text-rift-500 mt-1">Fermer votre session actuelle</p>
          </div>
          <form action="/api/auth/logout" method="POST">
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-red-500/10 text-red-400 text-sm font-semibold border border-red-500/20 hover:bg-red-500/20 hover:border-red-400/30 hover:text-red-300 transition-all shadow-lg shadow-red-900/5 hover:-translate-y-0.5">
              Se déconnecter
            </button>
          </form>
        </div>

      </div>
    </div>
  </div>
</MainLayout>
