---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.astro';
import { createServiceClient } from '../../../lib/supabase';

const { id } = Astro.params;
let errorMsg = '';

const supabase = createServiceClient();

// Charger l'article
const { data: article, error: fetchError } = await supabase
  .from('articles')
  .select('*')
  .eq('id', id)
  .single();

if (fetchError || !article) {
  return Astro.redirect('/admin/articles');
}

// Traiter la mise à jour
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = formData.get('title') as string;
  const slug = (formData.get('slug') as string).toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  const content = formData.get('content') as string;
  const summary = formData.get('summary') as string;
  const image_url = formData.get('image_url') as string || '';
  const tags = (formData.get('tags') as string).split(',').map((t) => t.trim()).filter(Boolean);
  const featured = formData.get('featured') === 'on';
  const published = formData.get('published') === 'on';

  const { error } = await supabase
    .from('articles')
    .update({ title, slug, content, summary, image_url, tags, featured, published })
    .eq('id', id);

  if (error) {
    errorMsg = 'Erreur lors de la mise à jour. Vérifiez que le slug est unique.';
  } else {
    return Astro.redirect('/admin/articles');
  }
}
---

<AdminLayout title="Éditer l'article" activeItem="articles">
  <div class="max-w-3xl">

    <a href="/admin/articles" class="inline-flex items-center gap-1 text-sm text-accent-cyan hover:underline mb-6 transition-colors">
      ← Retour aux articles
    </a>

    <form method="POST" class="space-y-5">
      {errorMsg && (
        <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          {errorMsg}
        </div>
      )}

      <div>
        <label for="title" class="block text-sm font-medium text-rift-300 mb-1.5">Titre</label>
        <input type="text" id="title" name="title" required value={article.title}
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-rift-300 mb-1.5">Slug (URL)</label>
        <div class="flex items-center gap-2">
          <span class="text-sm text-rift-500">/news/</span>
          <input type="text" id="slug" name="slug" required value={article.slug}
            class="flex-1 px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
          />
        </div>
      </div>

      <!-- Image -->
      <div>
        <label class="block text-sm font-medium text-rift-300 mb-1.5">Image de couverture</label>
        <input type="hidden" id="image_url" name="image_url" value={article.image_url || ''} />

        <div id="image-upload-zone"
          class="relative w-full min-h-[180px] rounded-xl border-2 border-dashed border-rift-700/50 bg-rift-900/30 hover:border-accent-cyan/40 transition-all duration-300 cursor-pointer flex flex-col items-center justify-center gap-3 overflow-hidden">

          <!-- Preview (visible si image existante) -->
          <div id="image-preview" class:list={[article.image_url ? '' : 'hidden', 'absolute inset-0']}>
            <img id="preview-img" class="w-full h-full object-cover" src={article.image_url || ''} alt="Preview" />
            <div class="absolute inset-0 bg-gradient-to-t from-rift-950/80 to-transparent"></div>
            <button type="button" id="remove-image-btn"
              class="absolute top-3 right-3 w-8 h-8 rounded-full bg-red-500/80 hover:bg-red-500 text-white flex items-center justify-center text-lg transition-colors z-10">
              ×
            </button>
          </div>

          <!-- Upload prompt -->
          <div id="upload-prompt" class:list={[article.image_url ? 'hidden' : '', 'flex flex-col items-center gap-2 py-4']}>
            <div class="w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center text-accent-cyan">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v13.5A1.5 1.5 0 003.75 21z" />
              </svg>
            </div>
            <p class="text-sm text-rift-400">Glissez une image ici ou <span class="text-accent-cyan font-medium">cliquez pour parcourir</span></p>
            <p class="text-xs text-rift-500">JPG, PNG, WebP ou GIF — Max 5 Mo</p>
          </div>

          <!-- Loading spinner -->
          <div id="upload-loading" class="hidden flex flex-col items-center gap-2 py-4">
            <div class="w-8 h-8 border-2 border-accent-cyan/30 border-t-accent-cyan rounded-full animate-spin"></div>
            <p class="text-sm text-rift-400">Upload en cours...</p>
          </div>

          <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
        </div>
      </div>

      <div>
        <label for="summary" class="block text-sm font-medium text-rift-300 mb-1.5">Résumé</label>
        <textarea id="summary" name="summary" rows="2"
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors resize-none"
        >{article.summary}</textarea>
      </div>

      <div>
        <label for="tags" class="block text-sm font-medium text-rift-300 mb-1.5">Tags</label>
        <input type="text" id="tags" name="tags" value={article.tags?.join(', ') || ''}
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
        />
      </div>


      <!-- Contenu Markdown -->
      <div>
        <MarkdownEditor
          label="Contenu (Markdown)"
          name="content"
          id="content"
          rows={16}
          value={article.content}
          required={true}
        />
      </div>

      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer group">
          <input type="checkbox" name="featured" checked={article.featured}
            class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30 checked:bg-accent-cyan checked:border-accent-cyan transition-colors" />
          <span class="text-sm text-rift-300 group-hover:text-rift-100 transition-colors">Article à la une</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer group">
          <input type="checkbox" name="published" checked={article.published}
            class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30 checked:bg-accent-cyan checked:border-accent-cyan transition-colors" />
          <span class="text-sm text-rift-300 group-hover:text-rift-100 transition-colors">Publié</span>
        </label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-6 py-2.5 rounded-lg bg-accent-spirit text-rift-950 font-bold text-sm hover:bg-accent-spirit/90 transition-colors shadow-lg shadow-accent-spirit/20 hover:-translate-y-0.5 transform duration-200">
          Enregistrer
        </button>
        <a href="/admin/articles" class="px-6 py-2.5 rounded-lg bg-rift-800 text-rift-300 font-medium text-sm border border-rift-700 hover:bg-rift-700 hover:text-rift-100 transition-colors">
          Annuler
        </a>
      </div>
    </form>
  </div>

  <script>
    // Image upload
    const zone = document.getElementById('image-upload-zone')!;
    const fileInput = document.getElementById('image-file-input') as HTMLInputElement;
    const imageUrlInput = document.getElementById('image_url') as HTMLInputElement;
    const preview = document.getElementById('image-preview')!;
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const uploadPrompt = document.getElementById('upload-prompt')!;
    const uploadLoading = document.getElementById('upload-loading')!;
    const removeBtn = document.getElementById('remove-image-btn')!;

    zone.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#remove-image-btn')) return;
      fileInput.click();
    });

    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
      const file = e.dataTransfer?.files[0];
      if (file) uploadImage(file);
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) uploadImage(file);
    });

    removeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      imageUrlInput.value = '';
      preview.classList.add('hidden');
      uploadPrompt.classList.remove('hidden');
    });



    async function uploadImageAndGetUrl(file: File): Promise<string | null> {
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      if (!allowedTypes.includes(file.type)) {
        alert('Format non supporté. Utilisez JPG, PNG, WebP ou GIF.');
        return null;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('Image trop lourde (max 5 Mo).');
        return null;
      }

      try {
        const formData = new FormData();
        formData.append('image', file);

        const res = await fetch('/api/upload-image', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (!res.ok) {
          alert(data.error || 'Erreur lors de l\'upload');
          return null;
        }
        return data.url;
      } catch (err) {
        alert('Erreur réseau lors de l\'upload');
        return null;
      }
    }

    async function uploadImage(file: File) {
      uploadPrompt.classList.add('hidden');
      preview.classList.add('hidden');
      uploadLoading.classList.remove('hidden');

      const url = await uploadImageAndGetUrl(file);

      if (url) {
        imageUrlInput.value = url;
        previewImg.src = url;
        uploadLoading.classList.add('hidden');
        preview.classList.remove('hidden');
      } else {
        uploadLoading.classList.add('hidden');
        uploadPrompt.classList.remove('hidden');
      }
    }
  </script>
</AdminLayout>
