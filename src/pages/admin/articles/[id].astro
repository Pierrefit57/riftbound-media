---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabase } from '../../../lib/supabase';

const { id } = Astro.params;
let errorMsg = '';

// Charger l'article
const { data: article, error: fetchError } = await supabase
  .from('articles')
  .select('*')
  .eq('id', id)
  .single();

if (fetchError || !article) {
  return Astro.redirect('/admin/articles');
}

// Traiter la mise à jour
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = formData.get('title') as string;
  const slug = (formData.get('slug') as string).toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  const content = formData.get('content') as string;
  const summary = formData.get('summary') as string;
  const tags = (formData.get('tags') as string).split(',').map((t) => t.trim()).filter(Boolean);
  const featured = formData.get('featured') === 'on';
  const published = formData.get('published') === 'on';

  const { error } = await supabase
    .from('articles')
    .update({ title, slug, content, summary, tags, featured, published })
    .eq('id', id);

  if (error) {
    errorMsg = 'Erreur lors de la mise à jour. Vérifiez que le slug est unique.';
  } else {
    return Astro.redirect('/admin/articles');
  }
}
---

<AdminLayout title="Éditer l'article" activeItem="articles">
  <div class="max-w-3xl">

    <a href="/admin/articles" class="inline-flex items-center gap-1 text-sm text-accent-cyan hover:underline mb-6">
      ← Retour aux articles
    </a>

    <form method="POST" class="space-y-5">
      {errorMsg && (
        <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          {errorMsg}
        </div>
      )}

      <div>
        <label for="title" class="block text-sm font-medium text-gray-300 mb-1.5">Titre</label>
        <input type="text" id="title" name="title" required value={article.title}
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
        />
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-gray-300 mb-1.5">Slug (URL)</label>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">/news/</span>
          <input type="text" id="slug" name="slug" required value={article.slug}
            class="flex-1 px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
          />
        </div>
      </div>

      <div>
        <label for="summary" class="block text-sm font-medium text-gray-300 mb-1.5">Résumé</label>
        <textarea id="summary" name="summary" rows="2"
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors resize-none"
        >{article.summary}</textarea>
      </div>

      <div>
        <label for="tags" class="block text-sm font-medium text-gray-300 mb-1.5">Tags</label>
        <input type="text" id="tags" name="tags" value={article.tags?.join(', ') || ''}
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
        />
      </div>

      <div>
        <label for="content" class="block text-sm font-medium text-gray-300 mb-1.5">Contenu (Markdown)</label>
        <textarea id="content" name="content" rows="16" required
          class="w-full px-4 py-3 rounded-lg bg-rift-950 border border-surface-border text-white focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors font-mono text-sm leading-relaxed resize-y"
        >{article.content}</textarea>
      </div>

      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="featured" checked={article.featured}
            class="w-4 h-4 rounded border-surface-border bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30" />
          <span class="text-sm text-gray-300">Article à la une</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="published" checked={article.published}
            class="w-4 h-4 rounded border-surface-border bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30" />
          <span class="text-sm text-gray-300">Publié</span>
        </label>
      </div>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-6 py-2.5 rounded-lg bg-accent-cyan text-rift-950 font-semibold text-sm hover:bg-accent-cyan/90 transition-colors">
          Enregistrer
        </button>
        <a href="/admin/articles" class="px-6 py-2.5 rounded-lg bg-white/5 text-gray-300 font-medium text-sm border border-surface-border hover:bg-white/10 transition-colors">
          Annuler
        </a>
      </div>
    </form>
  </div>
</AdminLayout>
