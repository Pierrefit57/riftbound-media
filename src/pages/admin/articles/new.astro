---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import MarkdownEditor from '../../../components/admin/MarkdownEditor.astro';
import DateTimePicker from '../../../components/admin/DateTimePicker';
import { createServiceClient } from '../../../lib/supabase';

let errorMsg = '';
let title = '';
let content = '';
let summary = '';
let image_url = '';
let tagsStr = '';
let featured = false;
let highlighted = false;
let published = true;
let published_at = new Date().toISOString().slice(0, 16);
let slug = '';

// Auto-populate values if we have a draft and NO post data (client-side JS handles this, but server-side helps on errors)
// Actually, we rely on client-side JS for the draft restore. Server-side only for POST errors.

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  
  // Extract values to variables for re-rendering on error
  title = formData.get('title') as string;
  // Slug is generated from title if empty, or taken from input
  const rawSlug = (formData.get('slug') as string);
  slug = rawSlug.toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  
  content = formData.get('content') as string;
  summary = formData.get('summary') as string;
  image_url = formData.get('image_url') as string || '';
  tagsStr = (formData.get('tags') as string);
  const tags = tagsStr.split(',').map((t) => t.trim()).filter(Boolean);
  featured = formData.get('featured') === 'on';
  highlighted = formData.get('highlighted') === 'on';
  published = formData.get('published') === 'on';
  published_at = formData.get('published_at') as string || new Date().toISOString();

  const serviceClient = createServiceClient();
  const { data: newArticle, error } = await serviceClient
    .from('articles')
    .insert({
      title,
      slug,
      content,
      summary,
      image_url,
      tags,
      featured,
      published,
      published_at,
      author_id: Astro.locals.user?.id,
      highlighted,
    })
    .select('id')
    .single();

  if (error) {
    console.error('[articles] Erreur création:', error.message, error.code);
    errorMsg = error.code === '23505'
      ? 'Ce slug existe déjà. Choisissez un slug unique.'
      : 'Erreur lors de la création. Réessayez.';
      
    // If error, we stay on page. Variables are already set for the form.
  } else {
    return Astro.redirect(`/admin/articles/${newArticle.id}?success=created`);
  }
}
---

<AdminLayout title="Nouvel Article" activeItem="articles">
  <div class="max-w-[1920px] mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between mb-8">
      <a href="/admin/articles" class="inline-flex items-center gap-1 text-sm text-accent-cyan hover:underline transition-colors">
        ← Retour aux articles
      </a>
      <h1 class="text-2xl font-bold text-rift-100 font-display uppercase tracking-wider">Nouvel Article</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <!-- Left Column: Form -->
      <div class="lg:col-span-12 xl:col-span-6">
        <form method="POST" class="space-y-6 bg-rift-900/40 p-6 rounded-xl border border-rift-800/50">
          {errorMsg && (
            <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
              {errorMsg}
            </div>
          )}

          <div id="draft-alert" class="hidden p-4 rounded-lg bg-accent-spirit/10 border border-accent-spirit/30 text-rift-100 text-sm flex flex-col sm:flex-row items-center justify-between gap-3 animate-fade-in">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-accent-spirit shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Vous avez un brouillon non enregistré pour cet article.</span>
            </div>
            <div class="flex gap-2 shrink-0">
              <button type="button" id="restore-draft-btn" class="px-3 py-1.5 rounded bg-accent-spirit text-rift-950 font-bold text-xs hover:bg-accent-spirit/90 transition-colors uppercase tracking-wider">
                Restaurer
              </button>
              <button type="button" id="discard-draft-btn" class="px-3 py-1.5 rounded bg-rift-950 border border-rift-700/50 text-rift-300 font-bold text-xs hover:text-rift-100 hover:border-rift-600 transition-all uppercase tracking-wider">
                Ignorer
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="title" class="block text-sm font-medium text-rift-300 mb-2">Titre</label>
              <input type="text" id="title" name="title" required
                class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
                placeholder="Titre de l'article"
                value={title}
              />
            </div>

            <div>
              <DateTimePicker 
                client:load 
                id="published_at" 
                name="published_at" 
                label="Date de publication"
                initialDate={published_at} 
              />
            </div>

            <div>
              <label for="slug" class="block text-sm font-medium text-rift-300 mb-2">Slug (URL)</label>
              <div class="flex items-center gap-2">
                <span class="text-sm text-rift-500 font-mono">/news/N°-</span>
                <input type="text" id="slug" name="slug" required
                  class="flex-1 px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors font-mono text-sm"
                  placeholder="mon-article"
                  value={slug}
                />
              </div>
            </div>
          </div>

          <!-- Image -->
          <div class="space-y-2">
            <label class="block text-sm font-medium text-rift-300">Image de couverture</label>
            <input type="hidden" id="image_url" name="image_url" value={image_url} />

            <div id="image-upload-zone"
              class="relative w-full min-h-[160px] rounded-xl border-2 border-dashed border-rift-700/50 bg-rift-900/30 hover:border-accent-cyan/40 transition-all duration-300 cursor-pointer flex flex-col items-center justify-center gap-3 overflow-hidden">
              <div id="image-preview" class={`absolute inset-0 ${image_url ? '' : 'hidden'}`}>
                <img id="preview-img" src={image_url} class="w-full h-full object-cover" alt="Preview" />
                <div class="absolute inset-0 bg-gradient-to-t from-rift-950/80 to-transparent"></div>
                <button type="button" id="remove-image-btn"
                  class="absolute top-3 right-3 w-8 h-8 rounded-full bg-red-500/80 hover:bg-red-500 text-white flex items-center justify-center text-lg transition-colors z-10">
                  ×
                </button>
              </div>
              <div id="upload-prompt" class={`flex flex-col items-center gap-2 py-4 ${image_url ? 'hidden' : ''}`}>
                <div class="w-10 h-10 rounded-xl bg-accent-cyan/10 flex items-center justify-center text-accent-cyan">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v13.5A1.5 1.5 0 003.75 21z" />
                  </svg>
                </div>
                <p class="text-sm text-rift-400">Glissez ou <span class="text-accent-cyan font-medium">cliquez</span></p>
              </div>
              <div id="upload-loading" class="hidden flex flex-col items-center gap-2 py-4">
                <div class="w-8 h-8 border-2 border-accent-cyan/30 border-t-accent-cyan rounded-full animate-spin"></div>
              </div>
              <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
            </div>

            <!-- Position Adjustment Slider -->
            <div id="image-position-container" class:list={["mt-3", image_url ? '' : 'hidden']}>
              <label for="image_position_slider" class="block text-xs font-medium text-rift-400 mb-1 flex justify-between">
                <span>Ajustement de l'image (Haut/Bas)</span>
                <span id="image-position-val">50%</span>
              </label>
              <input 
                type="range" 
                id="image_position_slider" 
                min="0" 
                max="100" 
                value="50"
                class="w-full accent-accent-cyan cursor-pointer"
              />
            </div>
          </div>

          <div>
            <label for="summary" class="block text-sm font-medium text-rift-300 mb-2">Résumé</label>
            <textarea id="summary" name="summary" rows="2"
              class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors resize-none text-sm"
              placeholder="Résumé pour les cards..."
            >{summary}</textarea>
          </div>

          <div>
            <label for="tags" class="block text-sm font-medium text-rift-300 mb-2">Tags</label>
            <input type="text" id="tags" name="tags"
              class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors text-sm"
              placeholder="news, guide..."
              value={tagsStr}
            />
            
            <!-- Quick Tag Picker -->
            <div class="mt-3 flex flex-wrap gap-2">
              {[
                { name: 'Boutique Riot', class: 'bg-accent-sakura/15 text-accent-sakura border-accent-sakura/25 hover:bg-accent-sakura/25' },
                { name: 'Annonce Riot', class: 'bg-domain-order/10 text-domain-order border-domain-order/20 hover:bg-domain-order/20' },
                { name: 'Tournoi', class: 'bg-accent-spirit/10 text-accent-spirit border-accent-spirit/20 hover:bg-accent-spirit/20' },
                { name: 'Compétitif', class: 'bg-accent-spirit/10 text-accent-spirit border-accent-spirit/20 hover:bg-accent-spirit/20' },
                { name: 'Mise à jour', class: 'bg-domain-calm/10 text-domain-calm border-domain-calm/20 hover:bg-domain-calm/20' },
                { name: 'Equilibrage', class: 'bg-accent-forge/10 text-accent-forge border-accent-forge/20 hover:bg-accent-forge/20' },
                { name: 'Patch', class: 'bg-accent-forge/10 text-accent-forge border-accent-forge/20 hover:bg-accent-forge/20' },
                { name: 'Lore', class: 'bg-domain-chaos/10 text-domain-chaos border-domain-chaos/20 hover:bg-domain-chaos/20' },
                { name: 'Fun', class: 'bg-domain-chaos/10 text-domain-chaos border-domain-chaos/20 hover:bg-domain-chaos/20' },
                { name: 'Cartes', class: 'bg-domain-mind/10 text-domain-mind border-domain-mind/20 hover:bg-domain-mind/20' },
                { name: 'Règles', class: 'bg-accent-spirit/10 text-accent-spirit border-accent-spirit/20 hover:bg-accent-spirit/20' },
                { name: 'Interview', class: 'bg-accent-sakura/15 text-accent-sakura border-accent-sakura/25 hover:bg-accent-sakura/25' },
                { name: 'Errata', class: 'bg-domain-body/10 text-domain-body border-domain-body/20 hover:bg-domain-body/20' },
                { name: 'FAQ', class: 'bg-domain-body/10 text-domain-body border-domain-body/20 hover:bg-domain-body/20' },
                { name: 'Site Web', class: 'bg-sky-400/10 text-sky-400 border-sky-400/20 hover:bg-sky-400/20' },
                { name: 'Set 1', class: 'bg-[#C5A059]/10 text-[#C5A059] border-[#C5A059]/20 hover:bg-[#C5A059]/20' },
                { name: 'Set 2', class: 'bg-[#A5A9B4]/10 text-[#A5A9B4] border-[#A5A9B4]/20 hover:bg-[#A5A9B4]/20' },
                { name: 'Set 3', class: 'bg-[#722d6c]/10 text-[#722d6c] border-[#722d6c]/20 hover:bg-[#722d6c]/20' },
                { name: 'Set 4', class: 'bg-[#a01c40]/10 text-[#a01c40] border-[#a01c40]/20 hover:bg-[#a01c40]/20' },
                { name: 'EU', class: 'bg-blue-500/10 text-blue-400 border-blue-500/20 hover:bg-blue-500/20' },
                { name: 'US', class: 'bg-red-500/10 text-red-400 border-red-500/20 hover:bg-red-500/20' },
                { name: 'Chine', class: 'bg-amber-500/10 text-amber-400 border-amber-500/20 hover:bg-amber-500/20' },
              ].map(tag => (
                <button 
                  type="button" 
                  data-tag={tag.name}
                  class={`px-2.5 py-1 text-[11px] font-medium rounded-md border transition-colors ${tag.class} tag-chip`}
                >
                  + {tag.name}
                </button>
              ))}
            </div>
          </div>

          <MarkdownEditor
            label="Contenu (Markdown)"
            name="content"
            id="content"
            placeholder="# Titre\n\nContenu..."
            required={true}
          />
          <!-- Inject initial content for server-side re-render on error -->
          <script define:vars={{ initialContent: content }}>
            if (initialContent) {
              // Wait for editor to initialize
              window.addEventListener('load', () => {
                const ta = document.querySelector('textarea[name="content"]');
                if (ta) { ta.value = initialContent; ta.dispatchEvent(new Event('input')); }
              });
            }
          </script>

          <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6 pt-4 border-t border-rift-800/50">
            <div class="flex items-center justify-between sm:justify-start gap-4 sm:gap-6 w-full sm:w-auto">
              <button type="button" id="reset-btn" class="text-xs text-rift-500 hover:text-red-400 underline transition-colors">
                Vider le formulaire
              </button>
              <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 cursor-pointer group">
                  <input type="checkbox" name="featured" checked={featured}
                    class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30 checked:bg-accent-cyan checked:border-accent-cyan transition-colors" />
                  <span class="text-xs text-rift-300 group-hover:text-rift-100 transition-colors uppercase tracking-wider">Épinglé</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer group">
                  <input type="checkbox" name="highlighted" checked={highlighted}
                    class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30 checked:bg-accent-cyan checked:border-accent-cyan transition-colors" />
                  <span class="text-xs text-rift-300 group-hover:text-rift-100 transition-colors uppercase tracking-wider">✦ Surbrillance</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer group">
                  <input type="checkbox" name="published" checked={published}
                    class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30 checked:bg-accent-cyan checked:border-accent-cyan transition-colors" />
                  <span class="text-xs text-rift-300 group-hover:text-rift-100 transition-colors uppercase tracking-wider">Publier</span>
                </label>
              </div>
            </div>
            <div class="hidden sm:block flex-1"></div>
            <button type="submit" class="w-full sm:w-auto px-8 py-2.5 rounded-lg bg-accent-spirit text-rift-950 font-bold text-sm hover:bg-accent-spirit/90 transition-all shadow-lg shadow-accent-spirit/20 uppercase tracking-widest text-center mt-2 sm:mt-0">
              Créer l'article
            </button>
          </div>
        </form>
      </div>

      <!-- Right Column: Live Preview -->
      <div class="lg:col-span-12 xl:col-span-6 hidden xl:block sticky top-8">
        <div class="bg-rift-900/30 rounded-xl border border-rift-800/50 flex flex-col shadow-2xl overflow-hidden">
          <div class="px-4 py-3 border-b border-rift-800/50 bg-rift-900/60 flex items-center justify-between">
            <span class="text-xs font-bold text-rift-400 uppercase tracking-widest font-display">Aperçu en temps réel</span>
            <div class="flex gap-1">
              <div class="w-1.5 h-1.5 rounded-full bg-red-500/30"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-amber-500/30"></div>
              <div class="w-1.5 h-1.5 rounded-full bg-green-500/30"></div>
            </div>
          </div>
          <div class="px-8 py-10 min-h-[600px] max-h-[calc(100vh-120px)] overflow-y-auto scrollbar-thin scrollbar-thumb-rift-800 scrollbar-track-transparent">
             
             <!-- Cover image preview -->
             <div id="live-cover-preview" class:list={["mb-8 w-full h-48 sm:h-64 rounded-xl overflow-hidden shadow-lg border border-rift-700/50 relative", image_url ? '' : 'hidden']}>
               <img id="live-cover-img" src="" alt="Cover" class="w-full h-full object-cover" style="object-position: center 50%;" />
             </div>

             <div class="article-live-preview prose prose-invert prose-orange max-w-none
               prose-headings:font-display prose-headings:font-bold prose-headings:text-rift-50
               prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4
               prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
               prose-p:text-rift-200 prose-p:leading-relaxed
               prose-a:text-accent-spirit prose-a:no-underline hover:prose-a:text-accent-forge hover:prose-a:underline
               prose-strong:text-rift-50
               prose-li:text-rift-200
               prose-blockquote:border-l-4 prose-blockquote:border-accent-spirit/70 prose-blockquote:text-rift-100 prose-blockquote:bg-rift-950/50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:my-8 prose-blockquote:border-solid
               prose-img:rounded-none
               prose-table:text-sm
               prose-th:text-accent-forge prose-th:font-semibold
               prose-td:text-rift-200
               prose-hr:border-rift-700/50">
               <div class="text-rift-500 italic text-center py-20">Le rendu s'affichera ici au fur et à mesure...</div>
             </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Draft Manager - Saves and restores form data to prevent loss
    const DRAFT_KEY = 'article_draft_new';
    const resetBtn = document.getElementById('reset-btn');

    resetBtn?.addEventListener('click', () => {
      if (confirm('Voulez-vous vraiment vider tout le formulaire ? Cette action est irréversible.')) {
        localStorage.removeItem(DRAFT_KEY);
        // Also clear backup just in case
        localStorage.removeItem(DRAFT_KEY + '_backup');
        window.location.reload();
      }
    });

    const form = document.querySelector('form');
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    const summaryInput = document.getElementById('summary') as HTMLTextAreaElement;
    const tagsInput = document.getElementById('tags') as HTMLInputElement;
    const imageUrlInput = document.getElementById('image_url') as HTMLInputElement;
    const contentInput = document.getElementById('content') as HTMLTextAreaElement;
    const publishedAtInput = document.getElementById('published_at') as HTMLInputElement;
    const featuredInput = document.querySelector('input[name="featured"]') as HTMLInputElement;
    const publishedInput = document.querySelector('input[name="published"]') as HTMLInputElement;
    
    // UI Elements for restoration
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const previewContainer = document.getElementById('image-preview')!;
    const uploadPrompt = document.getElementById('upload-prompt')!;
    const posContainer = document.getElementById('image-position-container')!;
    const posSlider = document.getElementById('image_position_slider') as HTMLInputElement;
    const posValLabel = document.getElementById('image-position-val')!;
    const liveCoverPreview = document.getElementById('live-cover-preview')!;
    const liveCoverImg = document.getElementById('live-cover-img') as HTMLImageElement;

    // Helper to get pure URL and position
    const parseImageUrl = (urlStr: string) => {
      const match = urlStr.match(/(.*)#pos=(\d+)$/);
      if (match) return { url: match[1], pos: match[2] };
      return { url: urlStr, pos: '50' };
    };

    const updateImagePreviews = (fullUrl: string) => {
      if (!fullUrl) {
        previewContainer.classList.add('hidden');
        uploadPrompt.classList.remove('hidden');
        posContainer.classList.add('hidden');
        liveCoverPreview.classList.add('hidden');
        return;
      }
      const { url, pos } = parseImageUrl(fullUrl);
      
      // Update inputs/sliders silently
      posSlider.value = pos;
      posValLabel.textContent = `${pos}%`;
      
      // Update form hidden input
      imageUrlInput.value = fullUrl;

      // Update upload zone
      previewImg.src = url;
      previewImg.style.objectPosition = `center ${pos}%`;
      previewContainer.classList.remove('hidden');
      uploadPrompt.classList.add('hidden');
      posContainer.classList.remove('hidden');

      // Update live preview
      liveCoverImg.src = url;
      liveCoverImg.style.objectPosition = `center ${pos}%`;
      liveCoverPreview.classList.remove('hidden');
    };

    const saveDraft = () => {
      const draft = {
        title: titleInput.value,
        slug: slugInput.value,
        summary: summaryInput.value,
        tags: tagsInput.value,
        image_url: imageUrlInput.value,
        content: contentInput.value,
        published_at: publishedAtInput.value,
        featured: featuredInput.checked,
        published: publishedInput.checked,
        timestamp: Date.now()
      };
      localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
    };

    const loadDraft = () => {
      // If server already made an error re-render (we can check if titleInput has value from server)
      // If titleInput has value (from server invalid submission), we should probably NOT overwrite it with draft, 
      // OR we prefer draft? 
      // Actually, if we just submitted, draft was cleared below.
      // So if we have a server error, draft relies on server recurrence (values injected in HTML).
      
      const saved = localStorage.getItem(DRAFT_KEY);
      if (!saved) return;

      try {
        const draft = JSON.parse(saved);
        
        // Check if draft contains any actual content to restore
        const hasContent = draft.title || draft.content || draft.summary || draft.image_url || draft.slug;
        if (!hasContent) {
          localStorage.removeItem(DRAFT_KEY);
          return;
        }

        // Show draft alert banner
        const draftAlert = document.getElementById('draft-alert')!;
        const restoreBtn = document.getElementById('restore-draft-btn')!;
        const discardBtn = document.getElementById('discard-draft-btn')!;
        
        draftAlert.classList.remove('hidden');
        
        restoreBtn.addEventListener('click', () => {
          if (draft.title) titleInput.value = draft.title;
          if (draft.slug) {
            slugInput.value = draft.slug;
            slugEdited = true; // Mark as edited so auto-gen doesn't overwrite
          }
          if (draft.summary) summaryInput.value = draft.summary;
          if (draft.tags) tagsInput.value = draft.tags;
          if (draft.image_url) {
            updateImagePreviews(draft.image_url);
          }
          if (draft.content) {
            contentInput.value = draft.content;
            contentInput.dispatchEvent(new Event('input'));
          }
          if (draft.published_at) {
            publishedAtInput.value = draft.published_at;
            window.dispatchEvent(new CustomEvent('update-date-published_at', { detail: { date: draft.published_at } }));
          }
          if (draft.featured !== undefined) featuredInput.checked = draft.featured;
          if (draft.published !== undefined) publishedInput.checked = draft.published;

          updateChipStates();
          draftAlert.classList.add('hidden');
          console.log('Brouillon restauré avec succès.');
        });

        discardBtn.addEventListener('click', () => {
          localStorage.removeItem(DRAFT_KEY);
          draftAlert.classList.add('hidden');
          console.log('Brouillon supprimé.');
        });

      } catch (e) {
        console.error('Erreur lors de la restauration du brouillon:', e);
      }
    };

    // Auto-save on input
    const inputs = [titleInput, slugInput, summaryInput, tagsInput, imageUrlInput, contentInput, publishedAtInput, featuredInput, publishedInput, posSlider];
    inputs.forEach(input => {
      input?.addEventListener('input', saveDraft);
      input?.addEventListener('change', saveDraft);
    });

    // Clear draft on successful form submission
    form?.addEventListener('submit', () => {
      // Create a backup just in case the post fails and the user hits back?
      // No, if post fails, server renders content back.
      // If user navigation breaks, data is lost. 
      // Let's rely on clearing it now.
      localStorage.removeItem(DRAFT_KEY);
    });


    // Auto-génération du slug depuis le titre
    let slugEdited = false;

    slugInput?.addEventListener('input', () => { slugEdited = true; });

    titleInput?.addEventListener('input', () => {
      if (!slugEdited) {
        slugInput.value = titleInput.value
          .toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '')
          .split('-').slice(0, 4).join('-');
        saveDraft(); // Save the auto-gen slug too
      }
    });

    // Image upload
    const zone = document.getElementById('image-upload-zone')!;
    const fileInput = document.getElementById('image-file-input') as HTMLInputElement;
    const uploadLoading = document.getElementById('upload-loading')!;
    const removeBtn = document.getElementById('remove-image-btn')!;

    // Click to browse
    zone.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#remove-image-btn')) return;
      fileInput.click();
    });

    // Drag & drop
    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
      const file = e.dataTransfer?.files[0];
      if (file) uploadImage(file);
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) uploadImage(file);
    });

    removeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateImagePreviews('');
      saveDraft();
    });

    posSlider.addEventListener('input', () => {
      const pos = posSlider.value;
      const { url } = parseImageUrl(imageUrlInput.value);
      if (url) {
        const fullUrl = `${url}#pos=${pos}`;
        updateImagePreviews(fullUrl);
      }
    });

    async function uploadImageAndGetUrl(file: File): Promise<string | null> {
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      if (!allowedTypes.includes(file.type)) {
        alert('Format non supporté. Utilisez JPG, PNG, WebP ou GIF.');
        return null;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('Image trop lourde (max 5 Mo).');
        return null;
      }

      try {
        const formData = new FormData();
        formData.append('image', file);

        const res = await fetch('/api/upload-image', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (!res.ok) {
          alert(data.error || 'Erreur lors de l\'upload');
          return null;
        }
        return data.url;
      } catch (err) {
        alert('Erreur réseau lors de l\'upload');
        return null;
      }
    }

    async function uploadImage(file: File) {
      uploadPrompt.classList.add('hidden');
      previewContainer.classList.add('hidden');
      uploadLoading.classList.remove('hidden');

      const url = await uploadImageAndGetUrl(file);

      if (url) {
        // default position 50
        updateImagePreviews(`${url}#pos=50`);
        uploadLoading.classList.add('hidden');
        saveDraft(); // Save URL to draft
      } else {
        uploadLoading.classList.add('hidden');
        uploadPrompt.classList.remove('hidden');
      }
    }

    // Tag picker logic
    const tagChips = document.querySelectorAll('.tag-chip');

    const updateChipStates = () => {
      const currentTags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      tagChips.forEach(chip => {
        const tag = (chip as HTMLElement).dataset.tag!;
        if (currentTags.includes(tag)) {
          chip.innerHTML = `✓ ${tag}`;
        } else {
          chip.innerHTML = `+ ${tag}`;
        }
      });
    };

    tagChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const tag = (chip as HTMLElement).dataset.tag!;
        let currentTags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
        
        if (currentTags.includes(tag)) {
          currentTags = currentTags.filter(t => t !== tag);
        } else {
          currentTags.push(tag);
        }
        
        tagsInput.value = currentTags.join(', ');
        updateChipStates();
        tagsInput.dispatchEvent(new Event('input'));
        saveDraft();
      });
    });
    
    tagsInput?.addEventListener('input', () => {
      updateChipStates();
      saveDraft();
    });

    // Run on load
    loadDraft();
    // Initialize previews from database value (this also fixes DOM state if draft exists but hasn't been restored)
    if (imageUrlInput.value) {
      updateImagePreviews(imageUrlInput.value);
    }
  </script>
</AdminLayout>
