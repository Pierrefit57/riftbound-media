---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../lib/supabase';

let errorMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const title = formData.get('title') as string;
  const slug = (formData.get('slug') as string).toLowerCase().replace(/[^a-z0-9-]/g, '-').replace(/-+/g, '-').replace(/^-|-$/g, '');
  const content = formData.get('content') as string;
  const summary = formData.get('summary') as string;
  const image_url = formData.get('image_url') as string || '';
  const tags = (formData.get('tags') as string).split(',').map((t) => t.trim()).filter(Boolean);
  const featured = formData.get('featured') === 'on';
  const published = formData.get('published') === 'on';

  const serviceClient = createServiceClient();
  const { error } = await serviceClient.from('articles').insert({
    title,
    slug,
    content,
    summary,
    image_url,
    tags,
    featured,
    published,
    author_id: Astro.locals.user?.id,
  });

  if (error) {
    console.error('[articles] Erreur création:', error.message, error.code);
    errorMsg = error.code === '23505'
      ? 'Ce slug existe déjà. Choisissez un slug unique.'
      : 'Erreur lors de la création. Réessayez.';
  } else {
    return Astro.redirect('/admin/articles');
  }
}
---

<AdminLayout title="Nouvel Article" activeItem="articles">
  <div class="max-w-3xl">

    <a href="/admin/articles" class="inline-flex items-center gap-1 text-sm text-accent-cyan hover:underline mb-6">
      ← Retour aux articles
    </a>

    <form method="POST" class="space-y-5">
      {errorMsg && (
        <div class="p-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          {errorMsg}
        </div>
      )}

      <!-- Titre -->
      <div>
        <label for="title" class="block text-sm font-medium text-gray-300 mb-1.5">Titre</label>
        <input type="text" id="title" name="title" required
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
          placeholder="Titre de l'article"
        />
      </div>

      <!-- Slug -->
      <div>
        <label for="slug" class="block text-sm font-medium text-gray-300 mb-1.5">Slug (URL)</label>
        <div class="flex items-center gap-2">
          <span class="text-sm text-gray-500">/news/</span>
          <input type="text" id="slug" name="slug" required
            class="flex-1 px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            placeholder="mon-article"
          />
        </div>
      </div>

      <!-- Image -->
      <div>
        <label class="block text-sm font-medium text-gray-300 mb-1.5">Image de couverture</label>
        <input type="hidden" id="image_url" name="image_url" value="" />

        <div id="image-upload-zone"
          class="relative w-full min-h-[180px] rounded-xl border-2 border-dashed border-surface-border bg-rift-950/50 hover:border-accent-cyan/40 transition-all duration-300 cursor-pointer flex flex-col items-center justify-center gap-3 overflow-hidden">

          <!-- Preview -->
          <div id="image-preview" class="hidden absolute inset-0">
            <img id="preview-img" class="w-full h-full object-cover" alt="Preview" />
            <div class="absolute inset-0 bg-gradient-to-t from-rift-950/80 to-transparent"></div>
            <button type="button" id="remove-image-btn"
              class="absolute top-3 right-3 w-8 h-8 rounded-full bg-red-500/80 hover:bg-red-500 text-white flex items-center justify-center text-lg transition-colors z-10">
              ×
            </button>
          </div>

          <!-- Upload prompt -->
          <div id="upload-prompt" class="flex flex-col items-center gap-2 py-4">
            <div class="w-12 h-12 rounded-xl bg-accent-cyan/10 flex items-center justify-center text-accent-cyan">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v13.5A1.5 1.5 0 003.75 21z" />
              </svg>
            </div>
            <p class="text-sm text-gray-400">Glissez une image ici ou <span class="text-accent-cyan font-medium">cliquez pour parcourir</span></p>
            <p class="text-xs text-gray-600">JPG, PNG, WebP ou GIF — Max 5 Mo</p>
          </div>

          <!-- Loading spinner -->
          <div id="upload-loading" class="hidden flex flex-col items-center gap-2 py-4">
            <div class="w-8 h-8 border-2 border-accent-cyan/30 border-t-accent-cyan rounded-full animate-spin"></div>
            <p class="text-sm text-gray-400">Upload en cours...</p>
          </div>

          <input type="file" id="image-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="hidden" />
        </div>
      </div>

      <!-- Résumé -->
      <div>
        <label for="summary" class="block text-sm font-medium text-gray-300 mb-1.5">Résumé</label>
        <textarea id="summary" name="summary" rows="2"
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors resize-none"
          placeholder="Résumé affiché dans les cards de news..."
        ></textarea>
      </div>

      <!-- Tags -->
      <div>
        <label for="tags" class="block text-sm font-medium text-gray-300 mb-1.5">Tags <span class="text-gray-500">(séparés par des virgules)</span></label>
        <input type="text" id="tags" name="tags"
          class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
          placeholder="Mise à jour, Lore, Événement"
        />
      </div>

      <!-- Contenu Markdown -->
      <div>
        <label for="content" class="block text-sm font-medium text-gray-300 mb-1.5">Contenu <span class="text-gray-500">(Markdown)</span></label>
        <textarea id="content" name="content" rows="16" required
          class="w-full px-4 py-3 rounded-lg bg-rift-950 border border-surface-border text-white placeholder-gray-500 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors font-mono text-sm leading-relaxed resize-y"
          placeholder="# Mon Article&#10;&#10;Le contenu en **markdown**..."
        ></textarea>
      </div>

      <!-- Options -->
      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="featured" class="w-4 h-4 rounded border-surface-border bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30" />
          <span class="text-sm text-gray-300">Article à la une</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="published" class="w-4 h-4 rounded border-surface-border bg-rift-950 text-accent-cyan focus:ring-accent-cyan/30" />
          <span class="text-sm text-gray-300">Publier immédiatement</span>
        </label>
      </div>

      <!-- Submit -->
      <div class="flex gap-3 pt-2">
        <button type="submit" class="px-6 py-2.5 rounded-lg bg-accent-cyan text-rift-950 font-semibold text-sm hover:bg-accent-cyan/90 transition-colors">
          Créer l'article
        </button>
        <a href="/admin/articles" class="px-6 py-2.5 rounded-lg bg-white/5 text-gray-300 font-medium text-sm border border-surface-border hover:bg-white/10 transition-colors">
          Annuler
        </a>
      </div>
    </form>
  </div>

  <script>
    // Auto-génération du slug depuis le titre
    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    let slugEdited = false;

    slugInput?.addEventListener('input', () => { slugEdited = true; });

    titleInput?.addEventListener('input', () => {
      if (!slugEdited) {
        slugInput.value = titleInput.value
          .toLowerCase()
          .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9\s-]/g, '')
          .replace(/\s+/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
      }
    });

    // Image upload
    const zone = document.getElementById('image-upload-zone')!;
    const fileInput = document.getElementById('image-file-input') as HTMLInputElement;
    const imageUrlInput = document.getElementById('image_url') as HTMLInputElement;
    const preview = document.getElementById('image-preview')!;
    const previewImg = document.getElementById('preview-img') as HTMLImageElement;
    const uploadPrompt = document.getElementById('upload-prompt')!;
    const uploadLoading = document.getElementById('upload-loading')!;
    const removeBtn = document.getElementById('remove-image-btn')!;

    // Click to browse
    zone.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('#remove-image-btn')) return;
      fileInput.click();
    });

    // Drag & drop
    zone.addEventListener('dragover', (e) => {
      e.preventDefault();
      zone.classList.add('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('dragleave', () => {
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
    });

    zone.addEventListener('drop', (e) => {
      e.preventDefault();
      zone.classList.remove('border-accent-cyan/60', 'bg-accent-cyan/5');
      const file = e.dataTransfer?.files[0];
      if (file) uploadImage(file);
    });

    fileInput.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (file) uploadImage(file);
    });

    removeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      imageUrlInput.value = '';
      preview.classList.add('hidden');
      uploadPrompt.classList.remove('hidden');
    });

    async function uploadImage(file: File) {
      // Validate
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      if (!allowedTypes.includes(file.type)) {
        alert('Format non supporté. Utilisez JPG, PNG, WebP ou GIF.');
        return;
      }
      if (file.size > 5 * 1024 * 1024) {
        alert('Image trop lourde (max 5 Mo).');
        return;
      }

      // Show loading
      uploadPrompt.classList.add('hidden');
      preview.classList.add('hidden');
      uploadLoading.classList.remove('hidden');

      try {
        const formData = new FormData();
        formData.append('image', file);

        const res = await fetch('/api/upload-image', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (!res.ok) {
          alert(data.error || 'Erreur lors de l\'upload');
          uploadLoading.classList.add('hidden');
          uploadPrompt.classList.remove('hidden');
          return;
        }

        // Success — show preview
        imageUrlInput.value = data.url;
        previewImg.src = data.url;
        uploadLoading.classList.add('hidden');
        preview.classList.remove('hidden');
      } catch (err) {
        alert('Erreur réseau lors de l\'upload');
        uploadLoading.classList.add('hidden');
        uploadPrompt.classList.remove('hidden');
      }
    }
  </script>
</AdminLayout>
