---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import DateTimePicker from '../../../components/admin/DateTimePicker';
import { createServiceClient } from '../../../lib/supabase';

const { id } = Astro.params;
let errorMsg = '';
let successMsg = '';

const supabase = createServiceClient();

// Charger l'événement
const { data: event, error: fetchError } = await supabase
  .from('calendar_events')
  .select('*')
  .eq('id', id)
  .single();

if (fetchError || !event) {
  return Astro.redirect('/admin/calendar');
}

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  
  const title = formData.get('title') as string;
  const description = formData.get('description') as string;
  const start_date = formData.get('start_date') as string;
  const end_date = formData.get('end_date') as string || null;
  const type = formData.get('type') as string;
  const url = formData.get('url') as string || null;
  const location = formData.get('location') as string || null;
  const country = formData.get('country') as string || null;
  const image_url = formData.get('image_url') as string || null;
  const image_position = formData.get('image_position') as string || '50% 50%';
  const image_size = formData.get('image_size') as string || 'cover';
  const all_day = formData.get('all_day') === 'on';

  const { error } = await supabase
    .from('calendar_events')
    .update({
      title,
      description,
      start_date: new Date(start_date).toISOString(),
      end_date: end_date ? new Date(end_date).toISOString() : null,
      all_day,
      type,
      url,
      location,
      country,
      image_url,
      image_position,
      image_size
    })
    .eq('id', id);

  if (error) {
    console.error('[calendar] ERROR UPDATE:', error);
    console.error('[calendar] ERROR DETAILS:', error.message, error.details, error.hint);
    errorMsg = `Erreur lors de la mise à jour de l'événement: ${error.message}`;
  } else {
    return Astro.redirect(`/admin/calendar?success=updated`);
  }
}

const successParam = Astro.url.searchParams.get('success');
if (successParam === 'updated') successMsg = 'Événement mis à jour !';
---

<AdminLayout title="Éditer l'événement" activeItem="calendar">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <a href="/admin/calendar" class="inline-flex items-center gap-1 text-sm text-accent-cyan hover:underline transition-colors">
        ← Retour au calendrier
      </a>
      <h1 class="text-2xl font-bold text-rift-100 font-display uppercase tracking-wider">Éditer l'événement</h1>
    </div>

    <form method="POST" class="space-y-6 bg-rift-900/40 p-6 rounded-xl border border-rift-800/50">
      {errorMsg && (
        <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
          {errorMsg}
        </div>
      )}

      {successMsg && (
        <div class="p-4 rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center justify-between">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            {successMsg}
          </div>
        </div>
      )}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="md:col-span-2">
          <label for="title" class="block text-sm font-medium text-rift-300 mb-2">Titre de l'événement</label>
          <input type="text" id="title" name="title" required
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            value={event.title}
          />
        </div>

        <div class="md:col-span-2">
          <label class="flex items-center gap-2 cursor-pointer group">
            <input type="checkbox" id="all_day" name="all_day" checked={event.all_day}
              class="w-4 h-4 rounded border-rift-700 bg-rift-950 text-accent-spirit focus:ring-accent-spirit/30 cursor-pointer"
            />
            <span class="text-sm font-medium text-rift-300 group-hover:text-rift-100 transition-colors">Événement toute la journée (masquer l'heure)</span>
          </label>
        </div>

        <div>
          <DateTimePicker 
            client:load 
            id="start_date" 
            name="start_date" 
            label="Date de début"
            initialDate={event.start_date} 
          />
        </div>

        <div>
          <DateTimePicker 
            client:load 
            id="end_date" 
            name="end_date" 
            label="Date de fin (optionnelle)"
            initialDate={event.end_date} 
          />
        </div>

        <div>
          <label for="type" class="block text-sm font-medium text-rift-300 mb-2">Type d'événement</label>
          <select id="type" name="type"
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors cursor-pointer">
            <option value="Tournoi International" selected={event.type === 'Tournoi International'}>Tournoi International</option>
            <option value="Tournoi FR" selected={event.type === 'Tournoi FR'}>Tournoi FR</option>
            <option value="Événement" selected={event.type === 'Événement'}>Événement</option>
            <option value="Communauté" selected={event.type === 'Communauté'}>Communauté</option>
          </select>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-rift-300 mb-2">Lieu / Plateforme</label>
          <input type="text" id="location" name="location"
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            value={event.location || ''}
          />
        </div>

        <div>
          <label for="country" class="block text-sm font-medium text-rift-300 mb-2">Code Pays (2 lettres)</label>
          <div class="flex gap-2">
             <input type="text" id="country" name="country" maxlength="5"
               class="w-24 px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors text-center uppercase"
               placeholder="FR"
               value={event.country || ''}
             />
             <div class="flex items-center text-xs text-rift-500 italic">
               Ex: FR, KR, WORLD...
             </div>
          </div>
        </div>

        <div class="md:col-span-2">
          <label for="url" class="block text-sm font-medium text-rift-300 mb-2">Lien externe (optionnel)</label>
          <input type="url" id="url" name="url"
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
            value={event.url || ''}
          />
        </div>

        <div class="md:col-span-2 space-y-4">
          <label class="block text-sm font-medium text-rift-300">Image de couverture (optionnelle)</label>
          <div class="flex items-center gap-4">
             <input type="hidden" id="image_url" name="image_url" value={event.image_url || ''} />
             <input type="hidden" id="image_position" name="image_position" value={event.image_position || 'center 50%'} />
             <div id="image-preview" class="w-16 h-16 rounded-lg bg-rift-950 border border-rift-700 flex items-center justify-center overflow-hidden">
                {event.image_url ? (
                  <img src={event.image_url} class="w-full h-full object-cover" style={`object-position: ${event.image_position || 'center 50%'}`} />
                ) : (
                  <svg class="w-6 h-6 text-rift-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                )}
             </div>
             <button type="button" id="upload-btn" class="px-4 py-2 rounded-lg bg-rift-800 text-rift-300 text-sm hover:bg-rift-700 transition-colors border border-rift-700">
               Choisir une image
             </button>
             <input type="file" id="file-input" accept="image/*" class="hidden" />
             <span id="upload-status" class="text-xs text-rift-500"></span>
          </div>
          <div>
            <label for="image_url_visible" class="block text-xs font-medium text-rift-500 mb-1">Ou coller une URL d'image externe</label>
            <div class="flex gap-2">
              <input type="url" id="image_url_visible" placeholder="https://exemple.com/image.webp"
                class="flex-1 px-4 py-2 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 text-sm focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors"
              />
              <button type="button" id="apply-url-btn" class="px-4 py-2 rounded-lg bg-accent-cyan/10 text-accent-cyan text-xs font-bold hover:bg-accent-cyan/20 border border-accent-cyan/20 transition-colors uppercase tracking-wider">
                Appliquer
              </button>
            </div>
          </div>

        </div>

        <div class="md:col-span-2">
          <label for="description" class="block text-sm font-medium text-rift-300 mb-2">Description</label>
          <textarea id="description" name="description" rows="4"
            class="w-full px-4 py-2.5 rounded-lg bg-rift-950 border border-rift-700/50 text-rift-100 placeholder-rift-600 focus:outline-none focus:border-accent-cyan/50 focus:ring-1 focus:ring-accent-cyan/30 transition-colors resize-none text-sm"
          >{event.description}</textarea>
        </div>
      </div>

      <div class="flex items-center justify-end gap-4 pt-4 border-t border-rift-800/50">
        <a href="/admin/calendar" class="px-6 py-2.5 rounded-lg text-rift-400 font-medium hover:text-rift-100 transition-colors text-sm uppercase tracking-widest">
          Annuler
        </a>
        <button type="submit" class="px-8 py-2.5 rounded-lg bg-accent-spirit text-rift-950 font-bold text-sm hover:bg-accent-spirit/90 transition-all shadow-lg shadow-accent-spirit/20 uppercase tracking-widest">
          Enregistrer les modifications
        </button>
      </div>
    </form>
  </div>

  <script>
    const uploadBtn = document.getElementById('upload-btn');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const imageUrlInput = document.getElementById('image_url') as HTMLInputElement;
    const imagePositionInput = document.getElementById('image_position') as HTMLInputElement;
    const imagePreview = document.getElementById('image-preview');
    const uploadStatus = document.getElementById('upload-status');
    const applyUrlBtn = document.getElementById('apply-url-btn');
    const imageUrlVisible = document.getElementById('image_url_visible') as HTMLInputElement;

    // Apply external URL
    applyUrlBtn?.addEventListener('click', () => {
      const url = imageUrlVisible?.value?.trim();
      if (!url) return;
      imageUrlInput.value = url;
      const pos = imagePositionInput?.value || 'center 50%';
      if (imagePreview) {
        imagePreview.innerHTML = `<img src="${url}" class="w-full h-full object-cover" style="object-position: ${pos}" />`;
      }
      if (uploadStatus) {
        uploadStatus.textContent = 'URL appliquée !';
        uploadStatus.className = 'text-xs text-emerald-400';
      }
    });

    uploadBtn?.addEventListener('click', () => fileInput?.click());

    // All Day toggle logic
    // Removed updateInputs logic as DateTimePicker handles date/time unifiedly.
    // window.addEventListener('load', () => { ... })

    fileInput?.addEventListener('change', async () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      if (uploadStatus) uploadStatus.textContent = 'Envoi...';
      
      const formData = new FormData();
      formData.append('image', file);

      try {
        const res = await fetch('/api/upload-image', { method: 'POST', body: formData });
        const data = await res.json();
        
        if (data.url) {
          imageUrlInput.value = data.url;
          const pos = imagePositionInput?.value || 'center 50%';
          
          if (imagePreview) {
             imagePreview.innerHTML = `<img src="${data.url}" class="w-full h-full object-cover" style="object-position: ${pos}" />`;
          }

          if (uploadStatus) {
            uploadStatus.textContent = 'Upload réussi !';
            uploadStatus.className = 'text-xs text-emerald-400';
          }
        } else {
          throw new Error(data.error || 'Erreur upload');
        }
      } catch (e: any) {
        if (uploadStatus) {
           uploadStatus.textContent = 'Erreur: ' + e.message;
           uploadStatus.className = 'text-xs text-red-400';
        }
      }
    });

    // Auto-sync End Date with Start Date
    window.addEventListener('date-change-start_date', (e: any) => {
        const newDate = e.detail?.date;
        if (newDate) {
           // Dispatch update to end_date component
           window.dispatchEvent(new CustomEvent('update-date-end_date', { detail: { date: newDate } }));
        }
    });
  </script>
</AdminLayout>
