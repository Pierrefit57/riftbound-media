---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../lib/supabase';

const supabase = createServiceClient();

// Gérer la suppression
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = formData.get('action');
  const eventId = formData.get('id') as string;

  if (action === 'delete' && eventId) {
    await supabase.from('calendar_events').delete().eq('id', eventId);
    return Astro.redirect('/admin/calendar?success=deleted');
  }
}

let { data: events, error: fetchError } = await supabase
  .from('calendar_events')
  .select('*')
  .order('start_date', { ascending: false });

function getEventColor(type: string) {
  switch (type) {
    case 'tournament': return 'text-accent-spirit border-accent-spirit/30 bg-accent-spirit/10';
    case 'stream': return 'text-accent-sakura border-accent-sakura/30 bg-accent-sakura/10';
    case 'patch': return 'text-accent-forge border-accent-forge/30 bg-accent-forge/10';
    default: return 'text-rift-300 border-rift-700/50 bg-rift-800/60';
  }
}
---

<AdminLayout title="Calendrier" activeItem="calendar">
  <div class="space-y-4">

    {fetchError && (
      <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
        Erreur de chargement: {fetchError.message}
      </div>
    )}

    <!-- Notification Toast -->
    <div id="success-toast" class="fixed top-24 right-8 z-50 transform translate-x-full opacity-0 transition-all duration-500 ease-out">
      <div class="flex items-center gap-3 px-6 py-4 rounded-xl bg-emerald-500 text-white shadow-2xl shadow-emerald-500/20 border border-white/10">
        <div class="w-2 h-2 rounded-full bg-white animate-pulse"></div>
        <span class="text-sm font-bold uppercase tracking-wider" id="toast-message">L'événement a été créé</span>
      </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="delete-modal" class="fixed inset-0 z-[100] hidden">
      <div class="absolute inset-0 bg-rift-950/80 backdrop-blur-sm"></div>
      <div class="absolute inset-0 flex items-center justify-center p-4">
        <div class="bg-rift-900 border border-rift-700 rounded-2xl shadow-2xl max-w-md w-full p-8 transform transition-all">
          <div class="flex items-center justify-center w-16 h-16 rounded-full bg-red-500/10 text-red-500 mx-auto mb-6">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-rift-50 text-center mb-2 font-display uppercase tracking-wider">Supprimer l'événement ?</h2>
          <p class="text-rift-400 text-center mb-8">Cette action est irréversible.</p>
          
          <div class="flex items-center gap-3">
            <button type="button" id="cancel-delete" class="flex-1 px-4 py-3 rounded-xl bg-rift-800 text-rift-200 font-semibold hover:bg-rift-700 transition-colors uppercase tracking-widest text-xs">
              Annuler
            </button>
            <form method="POST" id="confirm-delete-form" class="flex-1">
              <input type="hidden" name="id" id="delete-event-id" value="" />
              <input type="hidden" name="action" value="delete" />
              <button type="submit" class="w-full px-4 py-3 rounded-xl bg-red-500 text-white font-semibold hover:bg-red-600 transition-colors shadow-lg shadow-red-500/20 uppercase tracking-widest text-xs">
                Supprimer
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div slot="header-actions">
      <a href="/admin/calendar/new" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-spirit text-rift-950 text-sm font-bold hover:bg-accent-spirit/90 transition-all shadow-lg shadow-accent-spirit/20 hover:-translate-y-0.5 uppercase tracking-wider">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        Nouvel événement
      </a>
    </div>

    <!-- Header -->
    <div class="flex items-center justify-between">
      <p class="text-sm text-rift-400">{events?.length || 0} événement(s) programmé(s)</p>
    </div>

    <!-- Events list -->
    <div class="space-y-2">
      {events && events.length > 0 ? (
        events.map((event) => (
          <div class="flex items-center justify-between gap-4 p-4 bg-rift-800/40 rounded-xl border border-rift-700/50 transition-all group">
            <div class="flex items-center gap-4 min-w-0 flex-1">
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-sm font-bold text-rift-50 truncate">
                    {event.title}
                  </span>
                  <span class:list={["px-2 py-0.5 text-[9px] font-bold rounded border uppercase tracking-wider", getEventColor(event.type)]}>
                    {event.type}
                  </span>
                </div>
                <div class="flex items-center gap-3 text-xs text-rift-400">
                  <span class="text-accent-spirit/80">
                    {new Date(event.start_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' })}
                  </span>
                  {event.location && (
                    <>
                      <span class="opacity-40">|</span>
                      <span>📍 {event.location}</span>
                    </>
                  )}
                </div>
              </div>
            </div>

            <div class="flex items-center gap-2 flex-shrink-0 opacity-80 group-hover:opacity-100 transition-opacity">
              <div class="w-10 h-10 rounded-lg bg-rift-950 border border-rift-700/50 overflow-hidden flex-shrink-0">
                {event.image_url ? (
                  <img src={event.image_url} alt="" class="w-full h-full object-cover" />
                ) : (
                  <div class="w-full h-full flex items-center justify-center">
                    <svg class="w-4 h-4 text-rift-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  </div>
                )}
              </div>
              <a href={`/admin/calendar/${event.id}`} class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-accent-cyan/10 text-accent-cyan hover:bg-accent-cyan/20 border border-accent-cyan/20 transition-colors uppercase tracking-wider">
                Éditer
              </a>
              <button 
                type="button" 
                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors uppercase tracking-wider delete-btn"
                data-id={event.id}
              >
                Supprimer
              </button>
            </div>
          </div>
        ))
      ) : (
        <div class="text-center py-20 bg-rift-800/20 rounded-2xl border border-dashed border-rift-700/50">
          <p class="text-rift-400 text-lg mb-2">Aucun événement</p>
          <p class="text-rift-600 text-sm">Programmez votre premier événement pour commencer.</p>
        </div>
      )}
    </div>
  </div>

  <script is:inline>
    // Success Toast Logic
    const params = new URLSearchParams(window.location.search);
    const successAction = params.get('success');
    if (successAction) {
      const toast = document.getElementById('success-toast');
      const toastMsg = document.getElementById('toast-message');
      
      if (toast && toastMsg) {
        if (successAction === 'created') {
          toastMsg.textContent = "L'événement a été créé avec succès !";
        } else if (successAction === 'updated') {
          toastMsg.textContent = "L'événement a été mis à jour !";
        } else if (successAction === 'deleted') {
          toastMsg.textContent = "L'événement a été supprimé.";
          toast.firstElementChild.classList.remove('bg-emerald-500');
          toast.firstElementChild.classList.add('bg-red-500');
        }

        // Show toast
        setTimeout(() => {
          toast.classList.remove('translate-x-full', 'opacity-0');
          toast.classList.add('translate-x-0', 'opacity-100');
        }, 100);

        // Hide toast after 4s
        setTimeout(() => {
          toast.classList.add('translate-x-full', 'opacity-0');
          toast.classList.remove('translate-x-0', 'opacity-100');
        }, 4000);

        // Clean URL
        const newUrl = window.location.pathname;
        window.history.replaceState({}, '', newUrl);
      }
    }

    // Modal Logic
    const modal = document.getElementById('delete-modal');
    const cancelBtn = document.getElementById('cancel-delete');
    const deleteIdInput = document.getElementById('delete-event-id');
    const deleteBtns = document.querySelectorAll('.delete-btn');

    deleteBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        deleteIdInput.value = btn.dataset.id;
        modal.classList.remove('hidden');
      });
    });

    cancelBtn.addEventListener('click', () => {
      modal.classList.add('hidden');
    });

    window.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.classList.add('hidden');
      }
    });
  </script>
</AdminLayout>
