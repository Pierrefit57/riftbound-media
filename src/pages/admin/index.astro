---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { supabase } from '../../lib/supabase';

const { data: articles } = await supabase
  .from('articles')
  .select('id, published')
  .order('created_at', { ascending: false });

const totalArticles = articles?.length || 0;
const publishedCount = articles?.filter((a) => a.published)?.length || 0;
const draftCount = totalArticles - publishedCount;
---

<AdminLayout title="Dashboard" activeItem="dashboard">
  <div class="space-y-6">

    <!-- Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="bg-surface rounded-xl border border-surface-border p-5">
        <p class="text-sm text-gray-400 mb-1">Total Articles</p>
        <p class="text-3xl font-bold text-white">{totalArticles}</p>
      </div>
      <div class="bg-surface rounded-xl border border-surface-border p-5">
        <p class="text-sm text-gray-400 mb-1">Publiés</p>
        <p class="text-3xl font-bold text-emerald-400">{publishedCount}</p>
      </div>
      <div class="bg-surface rounded-xl border border-surface-border p-5">
        <p class="text-sm text-gray-400 mb-1">Brouillons</p>
        <p class="text-3xl font-bold text-amber-400">{draftCount}</p>
      </div>
    </div>

    <!-- Quick actions -->
    <div class="bg-surface rounded-xl border border-surface-border p-5">
      <h2 class="text-base font-bold text-white mb-4">Actions rapides</h2>
      <div class="flex flex-wrap gap-3">
        <a href="/admin/articles/new" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-accent-cyan text-rift-950 text-sm font-semibold hover:bg-accent-cyan/90 transition-colors">
          + Nouvel article
        </a>
        <a href="/admin/articles" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 text-white text-sm font-medium border border-surface-border hover:bg-white/10 transition-colors">
          Gérer les articles
        </a>
        <a href="/" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/5 text-white text-sm font-medium border border-surface-border hover:bg-white/10 transition-colors">
          Voir le site ↗
        </a>
      </div>
    </div>
  </div>
</AdminLayout>
