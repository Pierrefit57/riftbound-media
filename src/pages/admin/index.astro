---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import DashboardCharts from '../../components/admin/DashboardCharts';
import StatCard from '../../components/admin/StatCard';
import { createServiceClient } from '../../lib/supabase';

// Utiliser le service client pour contourner les RLS (lecture logs admin)
const supabase = createServiceClient();

// Désactiver le cache pour garantir des données fraîches
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

// 1. Articles Stats
const { data: articles } = await supabase
  .from('articles')
  .select('id, published, title, slug')
  .order('created_at', { ascending: false });

// Map slugs to titles for "Top Articles"
const articleTitleMap = new Map();
articles?.forEach(a => {
    if (a.slug) articleTitleMap.set(`/news/${a.slug}`, a.title);
});

const totalArticles = articles?.length || 0;
const publishedCount = articles?.filter((a) => a.published)?.length || 0;
const draftCount = totalArticles - publishedCount;

// 2. Analytics Stats
const now = new Date();
const fiveMinutesAgo = new Date(now.getTime() - 5 * 60 * 1000).toISOString();
const thirtyDaysAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000).toISOString();

// Datacenter IP prefixes to exclude (bots, crawlers, automated traffic)
const DATACENTER_PREFIXES = [
    '143.198.', '137.184.', '143.244.',  // DigitalOcean
    '18.144.', '13.56.', '13.57.',       // AWS US
    '54.', '52.',                         // AWS global
    '35.', '34.',                         // Google Cloud
    '20.', '40.', '104.',                // Azure
    '127.0.0.1',                          // localhost/test
];

function isRealVisitor(ip: string | null): boolean {
    if (!ip) return false;
    return !DATACENTER_PREFIXES.some(prefix => ip.startsWith(prefix));
}

// Online Now (Unique IPs in last 5 min)
const { data: onlineLogs } = await supabase
  .from('analytics_logs')
  .select('ip_address')
  .eq('event_type', 'page_view')
  .gte('created_at', fiveMinutesAgo);

const onlineCount = new Set(onlineLogs?.filter(l => isRealVisitor(l.ip_address)).map(l => l.ip_address)).size;

// Fetch Logs (Last 30 days)
import { format, subDays, startOfDay, endOfDay, eachDayOfInterval } from 'date-fns';

const endDate = new Date();
const startDate = subDays(endDate, 30);

const { data: rawLogs } = await supabase
  .from('analytics_logs')
  .select('event_type, created_at, path, ip_address, referrer, country')
  .gte('created_at', thirtyDaysAgo)
  .eq('event_type', 'page_view')
  .order('created_at', { ascending: true });

// Filter out bots and datacenter traffic
const logs = rawLogs?.filter(l => isRealVisitor(l.ip_address) && l.event_type !== 'diagnostic_test');


// Process Logs for Charts
const pageStats = new Map();
const referrerStats = new Map();
const countryStats = new Map();
let viewsToday = 0;
let totalViews30d = 0;
const uniqueIps30d = new Set();
const uniqueIpsToday = new Set();
// Utiliser UTC pour la comparaison avec created_at (stocké en UTC)
const todayStr = new Date().toISOString().split('T')[0];

// Initialize last 30 days specific map
const dailyViewsMap = {};
eachDayOfInterval({ start: startDate, end: endDate }).forEach(day => {
    dailyViewsMap[format(day, 'yyyy-MM-dd')] = 0;
});

logs?.forEach(log => {
   // Parsing robuste
   const dateObj = new Date(log.created_at);
   const dateStr = dateObj.toISOString().split('T')[0];
   const ip = log.ip_address;
   
   if (log.event_type === 'page_view') {
       totalViews30d++;
       if (dateStr === todayStr) viewsToday++;
       
       if (ip) {
           uniqueIps30d.add(ip);
           if (dateStr === todayStr) uniqueIpsToday.add(ip);
       }

       if (dailyViewsMap[dateStr] !== undefined) {
          dailyViewsMap[dateStr]++;
       }
       
       if (log.path) {
           const p = log.path;
           pageStats.set(p, (pageStats.get(p) || 0) + 1);
       }

       if (log.referrer && log.referrer !== 'direct') {
           const ref = new URL(log.referrer).hostname.replace('www.', '');
           referrerStats.set(ref, (referrerStats.get(ref) || 0) + 1);
       }

       if (log.country) {
           countryStats.set(log.country, (countryStats.get(log.country) || 0) + 1);
       }
   }
});

const uniqueVisitorsToday = uniqueIpsToday.size;
const totalUnique30d = uniqueIps30d.size;

// Convert Maps to Arrays and Sort
const dailyVisits = Object.entries(dailyViewsMap).map(([date, views]) => ({
    date: format(new Date(date), 'dd/MM'),
    views
}));

const chartData = dailyVisits;
---

<AdminLayout title="Tableau de bord" activeItem="dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-rift-100 font-display uppercase tracking-wider">Tableau de bord</h1>
        <p class="text-rift-400 text-sm mt-1">Bienvenue, {Astro.props.user?.email || 'Admin'} !</p>
      </div>
      <div class="flex gap-3 w-full sm:w-auto">
        <a href="/" target="_blank" class="w-full sm:w-auto text-center px-4 py-2 rounded-lg bg-rift-800 text-rift-300 text-sm font-medium hover:bg-rift-700 hover:text-accent-spirit transition-colors border border-rift-700">
          Voir le site
        </a>
      </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <StatCard
            title="En ligne"
            value={onlineCount}
            color="spirit"
        >
            <span slot="icon" class="relative flex h-3 w-3"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-spirit opacity-75"></span><span class="relative inline-flex rounded-full h-3 w-3 bg-accent-spirit"></span></span>
        </StatCard>
        
        <StatCard
            title="Visiteurs (Unique/J)"
            value={uniqueVisitorsToday}
            color="forge"
        >
            <svg slot="icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
        </StatCard>

        <StatCard
            title="Visiteurs (Unique/30j)"
            value={totalUnique30d}
            color="blue"
        >
            <svg slot="icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
        </StatCard>

        <StatCard
            title="Vues Totales (30j)"
            value={totalViews30d}
            color="sakura"
        >
            <svg slot="icon" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
        </StatCard>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        
        <!-- Left Column: Quick Actions & Trends -->
        <div class="lg:col-span-1 space-y-6">
           <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-5 shadow-card sticky top-6">
              <h2 class="text-base font-display font-bold text-rift-100 mb-4">Actions rapides</h2>
              <div class="flex flex-col gap-3 mb-6">
                <a href="/admin/articles/new" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-accent-spirit text-white text-sm font-semibold hover:bg-accent-spirit/90 shadow-spirit transition-all duration-300 hover:-translate-y-0.5 w-full">
                  ✦ Nouvel article
                </a>
                <a href="/admin/articles" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Gérer les articles
                </a>
                <a href="/admin/calendar" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Gérer le calendrier
                </a>
                <a href="/" target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Voir le site ↗
                </a>
              </div>

              {referrerStats.size > 0 && (
                <div class="pt-4 border-t border-rift-700/50">
                  <h3 class="text-xs font-bold text-rift-400 uppercase tracking-widest mb-3">Sources principales</h3>
                  <div class="space-y-2">
                    {Array.from(referrerStats.entries()).sort((a,b) => b[1] - a[1]).slice(0, 5).map(([ref, count]) => (
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-rift-200 truncate pr-2">{ref}</span>
                        <span class="text-rift-400 font-medium">{count}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {countryStats.size > 0 && (
                <div class="pt-4 mt-4 border-t border-rift-700/50">
                  <h3 class="text-xs font-bold text-rift-400 uppercase tracking-widest mb-3">Géographie</h3>
                  <div class="space-y-2">
                    {Array.from(countryStats.entries()).sort((a,b) => b[1] - a[1]).slice(0, 5).map(([country, count]) => (
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-rift-200">{country}</span>
                        <span class="text-rift-400 font-medium">{count}</span>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </div>
        </div>
    
        <!-- Right Column: Charts & Popular Content -->
        <div class="lg:col-span-3 space-y-8">
           <!-- Main Stats Chart -->
           <DashboardCharts client:load data={chartData} />

           <!-- Popular Content -->
           <div class="bg-rift-900/40 border border-rift-800/50 rounded-xl p-6 h-fit">
            <h3 class="text-lg font-bold text-rift-100 mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-accent-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
              Contenu Populaire (30j)
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
               {pageStats.size > 0 ? Array.from(pageStats.entries())
                    .filter(([path]) => path.startsWith('/news/') || path === '/')
                    .sort((a,b) => b[1] - a[1])
                    .slice(0, 10)
                    .map(([path, count]) => (
                 <div class="flex items-center justify-between p-3 rounded-lg bg-rift-950/50 border border-rift-800/50 hover:border-accent-cyan/30 transition-colors">
                   <div class="min-w-0 flex-1 mr-2">
                     <p class="text-sm font-medium text-rift-100 truncate" title={path}>
                       {articleTitleMap.get(path) || (path === '/' ? 'Accueil' : path.replace('/news/', ''))}
                     </p>
                   </div>
                   <span class="text-xs font-bold text-accent-cyan px-2 py-0.5 bg-accent-cyan/10 rounded">
                     {count}
                   </span>
                 </div>
               )) : (
                 <p class="text-sm text-rift-500 italic md:col-span-2">Aucune donnée récente.</p>
               )}
            </div>
          </div>
        </div>
    
    </div>
  </div>
</AdminLayout>
