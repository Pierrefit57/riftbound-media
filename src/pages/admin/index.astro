---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../lib/supabase';

// Utiliser le service client pour contourner les RLS (lecture logs admin)
const supabase = createServiceClient();

// Vérifier si la clé de service est présente (utile pour le debug admin)
const hasServiceKey = !!import.meta.env.SUPABASE_SERVICE_ROLE_KEY;

// Désactiver le cache pour garantir des données fraîches
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Vercel-CDN-Cache-Control', 'no-store');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

// 1. Articles Stats
const { data: articles } = await supabase
  .from('articles')
  .select('id, published, title, slug')
  .order('created_at', { ascending: false });

const totalArticles = articles?.length || 0;
const publishedCount = articles?.filter((a) => a.published)?.length || 0;
const draftCount = totalArticles - publishedCount;

const umamiShareUrl = "https://cloud.umami.is/analytics/eu/share/VjJpgvQiIFJSFV7W";
const isAdmin = Astro.locals.profile?.role === 'admin';
---

<AdminLayout title="Tableau de bord" activeItem="dashboard">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="text-2xl font-bold text-rift-100 font-display uppercase tracking-wider">Tableau de bord</h1>
        <p class="text-rift-400 text-sm mt-1">
          Bienvenue, <span class="capitalize text-rift-200">{isAdmin ? 'Admin' : 'Rédacteur'}</span> !
          {!hasServiceKey && <span class="text-red-500 font-bold ml-2">⚠️ Clé Service Role manquante !</span>}
        </p>
      </div>
      <div class="flex gap-3 w-full sm:w-auto">
        <a href="/" target="_blank" class="w-full sm:w-auto text-center px-4 py-2 rounded-lg bg-rift-800 text-rift-300 text-sm font-medium hover:bg-rift-700 hover:text-accent-spirit transition-colors border border-rift-700">
          Voir le site
        </a>
      </div>
    </div>

    <!-- Stats Grid (Articles Only) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-6 shadow-card flex items-center justify-between group hover:border-rift-600 transition-colors">
            <div>
                <p class="text-xs font-bold text-rift-400 uppercase tracking-widest mb-1">Total Articles</p>
                <p class="text-3xl font-display font-bold text-rift-100">{totalArticles}</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rift-900/50 flex items-center justify-center text-rift-400 group-hover:text-rift-200 transition-colors">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l4 4v10a2 2 0 01-2 2z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 2v4a2 2 0 002 2h4" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h2" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12h10" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16h10" /></svg>
            </div>
        </div>
        
        <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-6 shadow-card flex items-center justify-between group hover:border-accent-spirit/30 transition-colors">
            <div>
                <p class="text-xs font-bold text-accent-spirit uppercase tracking-widest mb-1">Articles Publiés</p>
                <p class="text-3xl font-display font-bold text-rift-100">{publishedCount}</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-accent-spirit/10 flex items-center justify-center text-accent-spirit">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
        </div>

        <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-6 shadow-card flex items-center justify-between group hover:border-rift-600 transition-colors">
            <div>
                <p class="text-xs font-bold text-rift-400 uppercase tracking-widest mb-1">Brouillons</p>
                <p class="text-3xl font-display font-bold text-rift-100">{draftCount}</p>
            </div>
            <div class="w-12 h-12 rounded-xl bg-rift-900/50 flex items-center justify-center text-rift-400">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        
        <!-- Left Column: Quick Actions -->
        <div class="lg:col-span-1 space-y-6">
           <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-5 shadow-card sticky top-6">
              <h2 class="text-base font-display font-bold text-rift-100 mb-4">Actions rapides</h2>
              <div class="flex flex-col gap-3 mb-6">
                <a href="/admin/articles/new" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-accent-spirit text-white text-sm font-semibold hover:bg-accent-spirit/90 shadow-spirit transition-all duration-300 hover:-translate-y-0.5 w-full">
                  ✦ Nouvel article
                </a>
                <a href="/admin/articles" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Gérer les articles
                </a>
                <a href="/admin/calendar" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Gérer le calendrier
                </a>
                <a href="/" target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-rift-300 text-sm font-medium border border-rift-700 bg-rift-800/60 hover:border-accent-spirit/30 hover:text-accent-spirit transition-all duration-300 w-full">
                  Voir le site ↗
                </a>
              </div>
              
              <div class="pt-4 border-t border-rift-700/50">
                {isAdmin && (
                  <a href="https://cloud.umami.is" target="_blank" class="flex items-center justify-center gap-2 text-xs text-rift-400 hover:text-accent-spirit transition-colors">
                    Ouvrir Umami Cloud ↗
                  </a>
                )}
              </div>
            </div>
        </div>
    
    
        <!-- Right Column: Umami Iframe (Admin only) -->
        <div class="lg:col-span-3">
          {isAdmin ? (
            <div class="bg-rift-900/40 border border-rift-800/50 rounded-2xl overflow-hidden shadow-card h-[800px] relative">
                <div class="absolute inset-0 flex items-center justify-center z-0">
                  <div class="flex flex-col items-center gap-3">
                   <div class="w-8 h-8 border-2 border-accent-spirit border-t-transparent rounded-full animate-spin"></div>
                   <p class="text-rift-500 text-sm animate-pulse">Chargement d'Umami...</p>
                  </div>
                </div>
                <iframe 
                  src={umamiShareUrl} 
                  class="relative z-10 w-full h-full border-0" 
                  title="Umami Analytics"
                  allowtransparency="true"
                ></iframe>
            </div>
          ) : (
            <div class="bg-rift-900/40 border border-rift-800/50 rounded-2xl overflow-hidden shadow-card h-full min-h-[400px] flex flex-col items-center justify-center p-8 text-center relative">
               <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(114,45,108,0.1),transparent_70%)]"></div>
               <div class="w-16 h-16 rounded-full bg-rift-800/80 border border-rift-700/50 flex items-center justify-center mb-4 relative z-10">
                  <svg class="w-8 h-8 text-rift-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
               </div>
               <h2 class="text-xl font-bold text-rift-100 font-display uppercase tracking-widest relative z-10">Espace Rédacteur</h2>
               <p class="text-rift-400 mt-2 max-w-md mx-auto relative z-10">
                 Les statistiques detaillées (vues, visiteurs, rebond) sont réservées aux administrateurs. Vous pouvez gérer vos articles via le menu latéral !
               </p>
            </div>
          )}
        </div>
    
    </div>
  </div>
</AdminLayout>
