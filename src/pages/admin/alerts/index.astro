---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { createServiceClient } from '../../../lib/supabase';

const supabase = createServiceClient();

// 1. Récupérer tous les événements
const { data: events, error: eventsError } = await supabase
  .from('calendar_events')
  .select('id, title, start_date, end_date, type, location')
  .order('start_date', { ascending: false });

// 2. Récupérer tous les follows groupés par event_id
const { data: allFollows, error: followsError } = await supabase
  .from('event_follows')
  .select('event_id, user_id');

// 3. Récupérer les profiles pour mapper user_id → username
const { data: profiles } = await supabase
  .from('profiles')
  .select('id, username');

// 4. Récupérer les emails via auth.admin
const { data: { users } } = await supabase.auth.admin.listUsers();

// Construire un map event_id → [followers]
const followsByEvent = new Map<string, { user_id: string; username: string; email: string }[]>();
if (allFollows) {
  for (const follow of allFollows) {
    const user = users?.find(u => u.id === follow.user_id);
    const profile = profiles?.find(p => p.id === follow.user_id);
    const follower = {
      user_id: follow.user_id,
      username: profile?.username || user?.user_metadata?.username || 'Inconnu',
      email: user?.email || 'N/A'
    };
    if (!followsByEvent.has(follow.event_id)) {
      followsByEvent.set(follow.event_id, []);
    }
    followsByEvent.get(follow.event_id)!.push(follower);
  }
}

// Stats globales
const totalFollows = allFollows?.length || 0;
const eventsWithFollows = followsByEvent.size;
const uniqueFollowers = new Set(allFollows?.map(f => f.user_id)).size;

function getEventColor(type: string) {
  switch (type) {
    case 'tournament': return 'text-accent-spirit border-accent-spirit/30 bg-accent-spirit/10';
    case 'stream': return 'text-accent-sakura border-accent-sakura/30 bg-accent-sakura/10';
    case 'patch': return 'text-accent-forge border-accent-forge/30 bg-accent-forge/10';
    default: return 'text-rift-300 border-rift-700/50 bg-rift-800/60';
  }
}
---

<AdminLayout title="Alertes e-mail" activeItem="alerts">
  <div class="space-y-6">
    
    {(eventsError || followsError) && (
      <div class="p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-xs">
        Erreur de chargement: {eventsError?.message || followsError?.message}
      </div>
    )}

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-5 shadow-card">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-accent-spirit/10 flex items-center justify-center text-accent-spirit text-lg">🔔</div>
          <div>
            <p class="text-2xl font-bold text-rift-50">{totalFollows}</p>
            <p class="text-xs text-rift-400 uppercase tracking-wider font-bold">Alertes totales</p>
          </div>
        </div>
      </div>
      <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-5 shadow-card">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-accent-forge/10 flex items-center justify-center text-accent-forge text-lg">📅</div>
          <div>
            <p class="text-2xl font-bold text-rift-50">{eventsWithFollows}</p>
            <p class="text-xs text-rift-400 uppercase tracking-wider font-bold">Événements suivis</p>
          </div>
        </div>
      </div>
      <div class="bg-rift-800/50 rounded-2xl border border-rift-700/50 p-5 shadow-card">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-10 h-10 rounded-xl bg-accent-sakura/10 flex items-center justify-center text-accent-sakura text-lg">👥</div>
          <div>
            <p class="text-2xl font-bold text-rift-50">{uniqueFollowers}</p>
            <p class="text-xs text-rift-400 uppercase tracking-wider font-bold">Utilisateurs uniques</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Events List with Follower Counts -->
    <div class="space-y-2">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-base font-display font-bold text-rift-100 uppercase tracking-wider">Alertes par événement</h2>
      </div>

      {events && events.length > 0 ? (
        events.map((event) => {
          const followers = followsByEvent.get(event.id) || [];
          const followerCount = followers.length;
          
          return (
            <details class="group bg-rift-800/40 rounded-xl border border-rift-700/50 transition-all hover:border-rift-600/50 overflow-hidden">
              <summary class="flex items-center justify-between gap-4 p-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div class="flex items-center gap-4 min-w-0 flex-1">
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-sm font-bold text-rift-50 truncate">{event.title}</span>
                      <span class:list={["px-2 py-0.5 text-[9px] font-bold rounded border uppercase tracking-wider", getEventColor(event.type)]}>{event.type}</span>
                    </div>
                    <div class="flex items-center gap-3 text-xs text-rift-400">
                      <span class="text-accent-spirit/80">
                        {new Date(event.start_date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}
                      </span>
                      {event.location && (
                        <>
                          <span class="opacity-40">|</span>
                          <span>📍 {event.location}</span>
                        </>
                      )}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-3 flex-shrink-0">
                  {followerCount > 0 ? (
                    <div class="flex items-center gap-2">
                      <span class:list={[
                        "px-3 py-1.5 rounded-lg text-xs font-bold border",
                        followerCount >= 10 ? "bg-accent-spirit/10 text-accent-spirit border-accent-spirit/30" :
                        followerCount >= 5 ? "bg-accent-forge/10 text-accent-forge border-accent-forge/30" :
                        "bg-rift-800 text-rift-300 border-rift-700"
                      ]}>
                        🔔 {followerCount} alerte{followerCount > 1 ? 's' : ''}
                      </span>
                      <svg class="w-4 h-4 text-rift-500 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  ) : (
                    <span class="px-3 py-1.5 rounded-lg text-xs font-medium bg-rift-900/60 text-rift-500 border border-rift-800">
                      Aucune alerte
                    </span>
                  )}
                </div>
              </summary>

              {followerCount > 0 && (
                <div class="border-t border-rift-700/50 p-4 bg-rift-900/40">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    {followers.map((follower) => (
                      <div class="flex items-center gap-3 p-3 rounded-lg bg-rift-800/60 border border-rift-700/30">
                        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-accent-spirit to-accent-sakura flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
                          {follower.username.charAt(0).toUpperCase()}
                        </div>
                        <div class="min-w-0 flex-1">
                          <p class="text-sm font-medium text-rift-100 truncate">{follower.username}</p>
                          <p class="text-[11px] text-rift-500 truncate">{follower.email}</p>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}
            </details>
          );
        })
      ) : (
        <div class="text-center py-20 bg-rift-800/20 rounded-2xl border border-dashed border-rift-700/50">
          <p class="text-rift-400 text-lg mb-2">Aucun événement</p>
          <p class="text-rift-600 text-sm">Créez un événement dans le calendrier pour commencer.</p>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
