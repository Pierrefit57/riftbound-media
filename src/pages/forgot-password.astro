---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import { supabase } from '../lib/supabase';

let errorMsg = '';
let successMsg = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email') as string;

  if (!email) {
    errorMsg = 'Veuillez entrer votre email.';
  } else {
    // URL de redirection vers la page de changement de mot de passe
    // On assume que le site est hébergé à la racine ou on utilise origin
    const redirectTo = `${Astro.url.origin}/reset-password`;

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo,
    });

    if (error) {
      // Pour des raisons de sécurité, on peut choisir de ne pas dire si l'email existe ou non,
      // mais ici on va afficher l'erreur pour le debug ou si c'est une erreur de rate limit.
      // En prod "strict", on afficherait souvent le même message de succès.
      if (error.status === 429) {
        errorMsg = 'Trop de demandes. Veuillez patienter avant de réessayer.';
      } else {
         console.error('Reset Password Error:', error);
         errorMsg = "Une erreur est survenue lors de l'envoi de l'email.";
      }
    } else {
      successMsg = 'Si un compte existe avec cet email, un lien de réinitialisation a été envoyé.';
    }
  }
}
---

<MainLayout title="Mot de passe oublié">
  <div class="max-w-md mx-auto px-4 pt-16 pb-20">

    <!-- Header -->
    <div class="text-center mb-8">
      <div class="flex items-center justify-center gap-3 mb-4">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-forge/50"></div>
        <span class="text-accent-forge text-xs font-display tracking-[0.2em] uppercase">Récupération</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-forge/50"></div>
      </div>
      <h1 class="text-3xl font-display font-bold text-rift-100 mb-2">Mot de passe oublié ?</h1>
      <p class="text-rift-400 text-sm">Entrez votre email pour recevoir un lien de réinitialisation.</p>
    </div>

    <!-- Card -->
    <div class="bg-rift-800/80 rounded-2xl border border-rift-700/50 p-6 space-y-6 shadow-card">

      <form method="POST" class="space-y-4">
        {errorMsg && (
          <div class="p-3 rounded-xl bg-red-500/10 border border-red-500/25 text-red-400 text-sm">
            {errorMsg}
          </div>
        )}
        
        {successMsg && (
          <div class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-sm">
            {successMsg}
          </div>
        )}

        <div>
          <label for="email" class="block text-sm font-medium text-rift-200 mb-1.5">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full px-4 py-2.5 rounded-xl bg-rift-900/50 border border-rift-700 text-rift-100 placeholder-rift-500 focus:outline-none focus:border-accent-spirit/50 focus:ring-2 focus:ring-accent-spirit/15 transition-all duration-300"
            placeholder="vous@exemple.com"
          />
        </div>

        <button
          type="submit"
          class="w-full px-4 py-3 rounded-xl bg-accent-spirit text-white font-semibold hover:bg-accent-spirit/90 shadow-spirit transition-all duration-300 hover:-translate-y-0.5"
        >
          Envoyer le lien
        </button>
      </form>

      <div class="text-center">
        <a href="/login" class="text-sm text-rift-500 hover:text-rift-300 transition-colors">
          ← Retour à la connexion
        </a>
      </div>
    </div>
  </div>
</MainLayout>
