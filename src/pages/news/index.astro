---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { supabase } from '../../lib/supabase';

const { data: allNews } = await supabase
  .from('articles')
  .select('*')
  .eq('published', true)
  .order('created_at', { ascending: false });

const featuredNews = allNews?.filter((n) => n.featured).slice(0, 2) || [];
const regularNews = allNews || [];
---

<MainLayout title="Actualités">

  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 pb-16">

    <div class="mb-12">
      <div class="flex items-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-forge/50"></div>
        <span class="text-accent-forge text-xs font-display tracking-[0.2em] uppercase">Actualités</span>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Dernières Nouvelles</h1>
      <p class="text-rift-300 leading-relaxed">Restez informé des dernières nouvelles et annonces de l'univers Riftbound</p>
    </div>

    {featuredNews.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-spirit to-accent-sakura"></div>
          <h2 class="text-lg font-display font-bold text-rift-100">À la Une</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredNews.map((article) => (
            <NewsCard
              title={article.title}
              summary={article.summary || ''}
              image={article.image_url || ''}
              tags={article.tags || []}
              author=""
              pubDate={new Date(article.created_at)}
              slug={article.slug}
              featured={true}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
        <h2 class="text-lg font-display font-bold text-rift-100">Toutes les Actualités</h2>
      </div>
      {regularNews.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {regularNews.map((article) => (
            <NewsCard
              title={article.title}
              summary={article.summary || ''}
              image={article.image_url || ''}
              tags={article.tags || []}
              author=""
              pubDate={new Date(article.created_at)}
              slug={article.slug}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-rift-400 font-display">Aucun article publié pour le moment.</p>
        </div>
      )}
    </section>
  </div>

</MainLayout>
