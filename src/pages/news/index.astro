---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { supabase } from '../../lib/supabase';
import { proxyUrl } from '../../lib/proxy';

// Cache CDN : 5 min côté edge, 1 min navigateur
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, max-age=60, stale-while-revalidate=60');

let { data: allNews, error: newsError } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, created_at, article_number, highlighted, featured')
  .eq('published', true)
  .order('published_at', { ascending: false })
  .order('created_at', { ascending: false });

// Fallback si la colonne published_at n'existe pas encore
if (newsError && newsError.message.includes('published_at')) {
  const fallback = await supabase
    .from('articles')
    .select('id, title, slug, summary, image_url, tags, published_at, created_at, article_number, highlighted, featured')
    .eq('published', true)
    .order('published_at', { ascending: false })
    .order('created_at', { ascending: false });
  allNews = fallback.data;
}

const featuredNews = allNews?.filter((n) => n.featured).slice(0, 2) || [];
const regularNews = (allNews?.filter((n) => !featuredNews.some(f => f.slug === n.slug)) || [])
  .sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());
---

<MainLayout title="Actualités">

  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Unleashed Shading Background -->
    <div class="absolute inset-x-0 top-0 h-[500px] pointer-events-none z-0" style="background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(190,69,148,0.18), transparent);"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-[#BE4594]/50"></div>
        <span class="text-[#BE4594] text-xs font-display tracking-[0.2em] uppercase">Actualités</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-[#BE4594]/50"></div>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Dernières Nouvelles</h1>
      <p class="text-rift-300 leading-relaxed max-w-2xl mx-auto">Restez informés des dernières nouvelles et annonces de l'univers Riftbound<br />Le tout traduit pour vous en français</p>
      <a href="/rss.xml" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 mt-4 px-3 py-1.5 rounded-full border border-rift-700/50 text-xs font-medium text-rift-400 hover:text-accent-spirit hover:border-accent-spirit/40 transition-all duration-300 group" title="Flux RSS">
        <svg class="w-3.5 h-3.5 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><circle cx="6.18" cy="17.82" r="2.18"/><path d="M4 4.44v2.83c7.03 0 12.73 5.7 12.73 12.73h2.83c0-8.59-6.97-15.56-15.56-15.56zm0 5.66v2.83c3.9 0 7.07 3.17 7.07 7.07h2.83c0-5.47-4.43-9.9-9.9-9.9z"/></svg>
        <span>S'abonner via RSS</span>
      </a>
    </div>

    {featuredNews.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-spirit to-accent-sakura"></div>
          <h2 class="text-lg font-display font-bold text-rift-100">Épinglés</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredNews.map((article) => (
            <NewsCard
              title={article.title}
              summary={article.summary || ''}
              image={proxyUrl(article.image_url)}
              tags={article.tags || []}
              author=""
              pubDate={new Date(article.published_at || article.created_at)}
              slug={article.slug}
              articleNumber={article.article_number}
              featured={true}
              highlighted={article.highlighted || false}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
          <h2 class="text-lg font-display font-bold text-rift-100">Toutes les Actualités</h2>
          <span id="search-count" class="hidden text-xs text-rift-400 font-mono ml-1"></span>
        </div>
        <div class="relative w-full sm:w-72">
          <input
            type="text"
            id="news-search"
            placeholder="Rechercher un article ou tag..."
            class="w-full pl-9 pr-10 py-2 rounded-xl bg-rift-800 border border-rift-700 text-rift-100 placeholder-rift-500 focus:border-accent-spirit focus:ring-1 focus:ring-accent-spirit outline-none transition-all text-sm font-sans"
          />
          <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-rift-500 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <button id="search-clear" class="absolute right-3 top-1/2 -translate-y-1/2 text-rift-500 hover:text-rift-200 transition-colors hidden" aria-label="Effacer">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>
      </div>

      <!-- No results message -->
      <div id="no-results" class="hidden text-center py-12">
        <svg class="w-12 h-12 mx-auto text-rift-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        <p class="text-rift-400 font-display">Aucun article trouvé pour "<span id="no-results-query" class="text-rift-200"></span>"</p>
      </div>

      {regularNews.length > 0 ? (
        <div id="news-grid-container">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="news-grid">
            {regularNews.map((article, index) => (
              <div
                class:list={['news-item transition-[opacity,transform] duration-500 ease-out', index >= 9 ? 'opacity-0 translate-y-4' : '']}
                data-index={index}
                data-title={article.title.toLowerCase()}
                data-summary={(article.summary || '').toLowerCase()}
                data-tags={(article.tags || []).map((t: string) => t.toLowerCase()).join(',')}
                data-revealed={index < 9 ? 'true' : 'false'}
              >
                <NewsCard
                  title={article.title}
                  summary={article.summary || ''}
                  image={proxyUrl(article.image_url)}
                  tags={article.tags || []}
                  author=""
                  pubDate={new Date(article.published_at || article.created_at)}
                  slug={article.slug}
                  articleNumber={article.article_number}
                  highlighted={article.highlighted || false}
                />
              </div>
            ))}
          </div>
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-rift-400 font-display">Aucun article publié pour le moment.</p>
        </div>
      )}
    </section>
  </div>
  </div>

  <script>
    // === Search Logic ===
    const searchInput = document.getElementById('news-search') as HTMLInputElement;
    const searchClear = document.getElementById('search-clear');
    const searchCount = document.getElementById('search-count');
    const noResults = document.getElementById('no-results');
    const noResultsQuery = document.getElementById('no-results-query');
    const allItems = document.querySelectorAll('.news-item');
    let isSearchActive = false;

    function performSearch(query: string) {
      const q = query.toLowerCase().trim();
      isSearchActive = q.length > 0;

      if (searchClear) searchClear.classList.toggle('hidden', !isSearchActive);

      if (!isSearchActive) {
        // Reset: show all items, restore unrevealed state for those not yet scrolled to
        allItems.forEach((item) => {
          const el = item as HTMLElement;
          el.classList.remove('search-hidden');
          el.style.display = '';
          // If it was already revealed by scroll observer, keep it visible
          if (el.dataset.revealed !== 'true') {
            el.classList.add('opacity-0', 'translate-y-4');
          }
        });
        if (searchCount) searchCount.classList.add('hidden');
        if (noResults) noResults.classList.add('hidden');
        return;
      }

      let matchCount = 0;
      allItems.forEach((item) => {
        const el = item as HTMLElement;
        const title = el.dataset.title || '';
        const summary = el.dataset.summary || '';
        const tags = el.dataset.tags || '';

        const matches = title.includes(q) || summary.includes(q) || tags.includes(q);

        if (matches) {
          el.classList.remove('search-hidden', 'opacity-0', 'translate-y-4');
          el.style.display = '';
          matchCount++;
        } else {
          el.classList.add('search-hidden');
          el.style.display = 'none';
        }
      });

      if (searchCount) {
        searchCount.textContent = `(${matchCount} résultat${matchCount !== 1 ? 's' : ''})`;
        searchCount.classList.remove('hidden');
      }

      if (noResults && noResultsQuery) {
        if (matchCount === 0) {
          noResultsQuery.textContent = query;
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    }

    let searchTimer: ReturnType<typeof setTimeout>;
    searchInput?.addEventListener('input', () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => performSearch(searchInput.value), 200);
    });

    searchClear?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      performSearch('');
      searchInput?.focus();
    });

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        searchInput.value = '';
        performSearch('');
        searchInput.blur();
      }
    });

    // === Scroll Reveal via IntersectionObserver ===
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !isSearchActive) {
          const el = entry.target as HTMLElement;
          if (el.dataset.revealed !== 'true') {
            el.dataset.revealed = 'true';
            el.classList.remove('opacity-0', 'translate-y-4');
          }
          revealObserver.unobserve(el);
        }
      });
    }, { rootMargin: '50px' });

    // Observe only items that haven't been revealed yet
    allItems.forEach((item) => {
      const el = item as HTMLElement;
      if (el.dataset.revealed !== 'true') {
        revealObserver.observe(el);
      }
    });
  </script>

</MainLayout>
