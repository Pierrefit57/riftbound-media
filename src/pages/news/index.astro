---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { supabase } from '../../lib/supabase';

let { data: allNews, error: newsError } = await supabase
  .from('articles')
  .select('*')
  .eq('published', true)
  .order('sort_order', { ascending: false })
  .order('published_at', { ascending: false })
  .order('created_at', { ascending: false });

// Fallback si la colonne published_at n'existe pas encore
if (newsError && newsError.message.includes('published_at')) {
  const fallback = await supabase
    .from('articles')
    .select('*')
    .eq('published', true)
    .order('sort_order', { ascending: false })
    .order('created_at', { ascending: false });
  allNews = fallback.data;
}

const featuredNews = allNews?.filter((n) => n.featured).slice(0, 2) || [];
const regularNews = allNews?.filter((n) => !featuredNews.some(f => f.slug === n.slug)) || [];
---

<MainLayout title="Actualités">

  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Spiritforged Shading Background -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-spirit-radial pointer-events-none z-0"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
        <span class="text-accent-sakura text-xs font-display tracking-[0.2em] uppercase">Actualités</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Dernières Nouvelles</h1>
      <p class="text-rift-300 leading-relaxed max-w-2xl mx-auto">Restez informés des dernières nouvelles et annonces de l'univers Riftbound<br />Le tout traduit pour vous en français</p>
    </div>

    {featuredNews.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-spirit to-accent-sakura"></div>
          <h2 class="text-lg font-display font-bold text-rift-100">Épinglés</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredNews.map((article) => (
            <NewsCard
              title={article.title}
              summary={article.summary || ''}
              image={article.image_url || ''}
              tags={article.tags || []}
              author=""
              pubDate={new Date(article.published_at || article.created_at)}
              slug={article.slug}
              featured={true}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
        <h2 class="text-lg font-display font-bold text-rift-100">Toutes les Actualités</h2>
      </div>
      {regularNews.length > 0 ? (
        <div id="news-grid-container">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="news-grid">
            {regularNews.map((article, index) => (
              <div class:list={['news-item transition-all duration-500', index >= 9 ? 'hidden opacity-0 translate-y-4' : '']} data-index={index}>
                <NewsCard
                  title={article.title}
                  summary={article.summary || ''}
                  image={article.image_url || ''}
                  tags={article.tags || []}
                  author=""
                  pubDate={new Date(article.published_at || article.created_at)}
                  slug={article.slug}
                />
              </div>
            ))}
          </div>

          {regularNews.length > 9 && (
            <div class="mt-12 text-center" id="load-more-container">
              <button 
                id="load-more-btn"
                class="px-8 py-3 rounded-xl bg-rift-800 border border-rift-700 hover:border-accent-spirit/50 text-rift-100 font-display font-bold tracking-widest uppercase text-sm transition-all hover:shadow-lg hover:shadow-accent-spirit/10 group"
              >
                <span class="flex items-center gap-2">
                  Afficher plus
                  <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>
            </div>
          )}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-rift-400 font-display">Aucun article publié pour le moment.</p>
        </div>
      )}
    </section>
  </div>
  </div>

  <script>
    // Infinite Scroll Logic
    const grid = document.getElementById('news-grid');
    const sentinel = document.getElementById('load-more-container');
    let page = 1;
    let loading = false;
    let hasMore = true;

    // Helper for tag styles (duplicated from NewsCard.astro for consistency)
    function getTagStyle(tag) {
      const t = tag.toLowerCase().trim();
      if (t.includes('riot') || t.includes('officiel')) return 'bg-domain-order/15 text-domain-order border-domain-order/30';
      if (t.includes('tournoi') || t.includes('compétitif')) return 'bg-accent-spirit/15 text-accent-spirit border-accent-spirit/30';
      if (t.includes('mise à jour') || t.includes('patch')) return 'bg-domain-calm/15 text-domain-calm border-domain-calm/30';
      if (t.includes('lore')) return 'bg-domain-chaos/15 text-domain-chaos border-domain-chaos/30';
      return 'bg-rift-800/50 text-rift-200 border-rift-700/50';
    }

    async function loadNextPage() {
      if (loading || !hasMore) return;
      loading = true;

      // Show loader
      if (sentinel) sentinel.innerHTML = '<div class="w-8 h-8 mx-auto border-4 border-rift-700 border-t-accent-spirit rounded-full animate-spin"></div>';

      try {
        const res = await fetch(`/api/news?page=${page + 1}&limit=9`);
        const { data, meta } = await res.json();

        if (data && data.length > 0) {
          data.forEach((article, index) => {
             // Check if already exists (server rendered)
             // Actually, we should probably start fetching from page 2 if page 1 is server rendered?
             // Server renders "regularNews" which could be any number.
             // Strategy: The API handles offset. If server rendered 9 items (limit 9), we ask for page 2.
             
             // Render Article HTML
             const div = document.createElement('div');
             div.className = 'news-item transition-all duration-500 opacity-0 translate-y-4';
             
             const hasImage = article.image_url && !article.image_url.includes('cloudflare');
             const pubDate = new Date(article.published_at || article.created_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

             div.innerHTML = `
              <a href="/news/${article.slug}" class="group block overflow-hidden rounded-2xl border border-rift-700/50 bg-rift-800 hover:border-accent-spirit/30 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-1 h-full flex flex-col">
                <div class="relative h-36 overflow-hidden flex-shrink-0">
                  ${hasImage ? 
                    `<img src="${article.image_url}" alt="${article.title}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />` : 
                    `<div class="absolute inset-0 bg-gradient-to-br from-accent-sakura/10 via-rift-900 to-accent-forge/8"></div>`
                  }
                </div>
                <div class="p-4 md:p-5 relative z-10 flex flex-col flex-1">
                  <div class="flex flex-wrap gap-1.5 mb-2 min-h-[24px]">
                    ${(article.tags || []).map(tag => `<span class="inline-flex items-center justify-center px-2 py-0.5 text-[11px] font-medium rounded-full border leading-none ${getTagStyle(tag)}">${tag}</span>`).join('')}
                  </div>
                  <h3 class="text-base font-display font-bold text-rift-50 mb-1.5 group-hover:text-accent-spirit transition-colors duration-300 line-clamp-2 uppercase tracking-wide">
                    ${article.title}
                  </h3>
                  <p class="text-rift-200 text-sm mb-3 line-clamp-2 leading-relaxed">
                    ${article.summary || ''}
                  </p>
                  <div class="flex items-center justify-between text-xs text-rift-400 mt-auto">
                    <span>${formattedDate}</span>
                  </div>
                </div>
              </a>
             `;
             
             grid?.appendChild(div);
             
             // Animate in
             requestAnimationFrame(() => {
               div.classList.remove('opacity-0', 'translate-y-4');
             });
          });

          page++;
          hasMore = page < meta.totalPages;
        } else {
          hasMore = false;
        }
      } catch (e) {
        console.error('Error loading news:', e);
      } finally {
        loading = false;
        if (!hasMore && sentinel) sentinel.remove();
        if (hasMore && sentinel) sentinel.innerHTML = ''; // Clear loader but keep sentinel
      }
    }

    // Interaction Observer
    if (sentinel) {
        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                loadNextPage();
            }
        }, { rootMargin: '200px' });
        
        observer.observe(sentinel);
    }
  </script>

</MainLayout>
