---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import NewsCard from '../../components/NewsCard.astro';
import { supabase } from '../../lib/supabase';

let { data: allNews, error: newsError } = await supabase
  .from('articles')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false })
  .order('created_at', { ascending: false });

// Fallback si la colonne published_at n'existe pas encore
if (newsError && newsError.message.includes('published_at')) {
  const fallback = await supabase
    .from('articles')
    .select('*')
    .eq('published', true)
    .order('published_at', { ascending: false })
    .order('created_at', { ascending: false });
  allNews = fallback.data;
}

const featuredNews = allNews?.filter((n) => n.featured).slice(0, 2) || [];
const regularNews = (allNews?.filter((n) => !featuredNews.some(f => f.slug === n.slug)) || [])
  .sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime());
---

<MainLayout title="Actualités">

  <div class="relative pt-16 pb-24 overflow-hidden">
    <!-- Spiritforged Shading Background -->
    <div class="absolute inset-x-0 top-0 h-[500px] bg-spirit-radial pointer-events-none z-0"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">

    <div class="mb-12 text-center">
      <div class="flex items-center justify-center gap-3 mb-3">
        <div class="h-px w-8 bg-gradient-to-r from-transparent to-accent-sakura/50"></div>
        <span class="text-accent-sakura text-xs font-display tracking-[0.2em] uppercase">Actualités</span>
        <div class="h-px w-8 bg-gradient-to-l from-transparent to-accent-sakura/50"></div>
      </div>
      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-100 mb-3">Dernières Nouvelles</h1>
      <p class="text-rift-300 leading-relaxed max-w-2xl mx-auto">Restez informés des dernières nouvelles et annonces de l'univers Riftbound<br />Le tout traduit pour vous en français</p>
    </div>

    {featuredNews.length > 0 && (
      <section class="mb-14">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-spirit to-accent-sakura"></div>
          <h2 class="text-lg font-display font-bold text-rift-100">Épinglés</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {featuredNews.map((article) => (
            <NewsCard
              title={article.title}
              summary={article.summary || ''}
              image={article.image_url || ''}
              tags={article.tags || []}
              author=""
              pubDate={new Date(article.published_at || article.created_at)}
              slug={article.slug}
              featured={true}
            />
          ))}
        </div>
      </section>
    )}

    <section>
      <div class="flex items-center gap-3 mb-6">
        <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
        <h2 class="text-lg font-display font-bold text-rift-100">Toutes les Actualités</h2>
      </div>
      {regularNews.length > 0 ? (
        <div id="news-grid-container">
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="news-grid">
            {regularNews.map((article, index) => (
              <div class:list={['news-item transition-all duration-500', index >= 9 ? 'hidden opacity-0 translate-y-4' : '']} data-index={index}>
                <NewsCard
                  title={article.title}
                  summary={article.summary || ''}
                  image={article.image_url || ''}
                  tags={article.tags || []}
                  author=""
                  pubDate={new Date(article.published_at || article.created_at)}
                  slug={article.slug}
                />
              </div>
            ))}
          </div>

          {regularNews.length > 9 && (
            <div class="mt-12 text-center" id="load-more-container">
              <button 
                id="load-more-btn"
                class="px-8 py-3 rounded-xl bg-rift-800 border border-rift-700 hover:border-accent-spirit/50 text-rift-100 font-display font-bold tracking-widest uppercase text-sm transition-all hover:shadow-lg hover:shadow-accent-spirit/10 group"
              >
                <span class="flex items-center gap-2">
                  Afficher plus
                  <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </span>
              </button>
            </div>
          )}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-rift-400 font-display">Aucun article publié pour le moment.</p>
        </div>
      )}
    </section>
  </div>
  </div>

  <script>
    // Reveal Scroll Logic (Robust version - no extra API calls needed)
    const sentinel = document.getElementById('load-more-container');
    let loading = false;
    const itemsPerPage = 9;

    function revealNextBatch() {
      if (loading) return;
      loading = true;

      const hiddenItems = document.querySelectorAll('.news-item.hidden');
      
      if (hiddenItems.length > 0) {
        // Show next batch
        const nextBatch = Array.from(hiddenItems).slice(0, itemsPerPage);
        
        nextBatch.forEach((item, i) => {
          setTimeout(() => {
            item.classList.remove('hidden');
            // Force reflow
            item.clientHeight; 
            item.classList.remove('opacity-0', 'translate-y-4');
          }, i * 100);
        });

        // Hide sentinel if no more items
        if (hiddenItems.length <= itemsPerPage && sentinel) {
          sentinel.style.display = 'none';
        }
      }
      
      loading = false;
    }

    // Interaction Observer (Infinite Scroll Effect)
    if (sentinel) {
        const observer = new IntersectionObserver((entries) => {
            if (entries[0].isIntersecting) {
                revealNextBatch();
            }
        }, { rootMargin: '300px' });
        
        observer.observe(sentinel);

        // Click fallback
        const btn = document.getElementById('load-more-btn');
        btn?.addEventListener('click', revealNextBatch);
    }
  </script>

</MainLayout>
