---
export const prerender = false;

import MainLayout from '../../layouts/MainLayout.astro';
import { supabase } from '../../lib/supabase';
import { proxyUrl } from '../../lib/proxy';
import { marked } from 'marked';
import { parseShortcodes } from '../../lib/shortcodes';

// Configurer marked pour les retours à la ligne
marked.use({
  breaks: true,
  gfm: true
});

const { slug } = Astro.params;

// Cache navigateur uniquement (pas de cache CDN public pour éviter les conflits de session)
Astro.response.headers.set('Cache-Control', 'private, max-age=60');

// --- Resolve article: new numeric format OR legacy slug ---
let article: any = null;

const numMatch = slug?.match(/^(\d+)(?:-|$)/);

if (numMatch) {
  // New format: /news/42-katchouze-interview
  const articleNumber = parseInt(numMatch[1]);
  const { data } = await supabase
    .from('articles')
    .select('*')
    .eq('article_number', articleNumber)
    .eq('published', true)
    .single();
  article = data;
} else {
  // Legacy format: /news/katchouze-linterview-du-commentateur-...
  const { data } = await supabase
    .from('articles')
    .select('*')
    .eq('slug', slug)
    .eq('published', true)
    .single();
  article = data;

  // 301 redirect to the new short URL for SEO
  if (article?.article_number) {
    const shortSlug = article.slug.split('-').slice(0, 4).join('-');
    return Astro.redirect(`/news/${article.article_number}-${shortSlug}`, 301);
  }
}

if (!article) {
  return Astro.redirect('/news');
}

// Manually fetch author profile
if (article.author_id) {
  const { data: profile } = await supabase
    .from('profiles')
    .select('username, avatar_url')
    .eq('id', article.author_id)
    .single();
  
  // Attach profile data to article object for template compatibility
  if (profile) {
    (article as any).profiles = profile;
  }
}

const rawContent = (article.content || '').replace(/\r\n/g, '\n');
let processedContent = rawContent.replace(/\n{3,}/g, (match) => {
  const count = match.length - 2;
  return '\n\n' + '<div class="spacer" style="height: ' + (count * 1.5) + 'rem" aria-hidden="true"></div>\n\n';
});

// Correction automatique : Assurer une ligne vide entre les balises <div> et le contenu Markdown
// pour que marked puisse les parser correctement à l'intérieur du HTML.
processedContent = processedContent
  .replace(/(<div[^>]*>)\n(?!\n)/g, '$1\n\n')
  .replace(/(?<!\n)\n(<\/div>)/g, '\n\n$1');

processedContent = parseShortcodes(processedContent);

let htmlContent = await marked.parse(processedContent);

// Post-processing: convert any remaining markdown syntax that marked
// didn't process (e.g. inside HTML block-level elements like <div> or <blockquote>)
// Links: [text](url) -> <a>
htmlContent = htmlContent.replace(
  /\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
  '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
);
// Images: ![alt](url) -> <img>
htmlContent = htmlContent.replace(
  /!\[([^\]]*)\]\(([^)]+)\)/g,
  '<img src="$2" alt="$1">'
);
// Bold: **text** -> <strong>
htmlContent = htmlContent.replace(
  /\*\*([^*]+)\*\*/g,
  '<strong>$1</strong>'
);
// Italic: *text* -> <em> (single asterisks, not inside **)
htmlContent = htmlContent.replace(
  /(?<!\*)\*(?!\*)([^*]+)(?<!\*)\*(?!\*)/g,
  '<em>$1</em>'
);

// Proxy: Replace all Supabase Storage URLs with CDN-proxied versions
const SUPABASE_STORAGE_RE = /https:\/\/otbccpoavhfvjpqpzemz\.supabase\.co\/storage\/v1\/object\/public\/([^"'\s)]+)/g;
htmlContent = htmlContent.replace(SUPABASE_STORAGE_RE, (_match, path) => `/api/img/${path}`);


const formattedDate = new Date(article.published_at || article.created_at).toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const authorName = article.profiles?.username || 'Équipe Riftbound';

// Check if current user is admin or editor (for edit FAB)
const currentProfile = Astro.locals.profile;
const isEditor = currentProfile && ['admin', 'editor'].includes(currentProfile.role);

// SEO Preparation
const seoDescription = article.summary || rawContent.slice(0, 160).replace(/[#*`]/g, '').trim() + '...';
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const publishDate = article.published_at || article.created_at;

// JSON-LD Structured Data
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": article.title,
  "description": seoDescription,
  "image": [article.image_url ? proxyUrl(article.image_url) : undefined].filter(Boolean),
  "datePublished": publishDate,
  "dateModified": article.updated_at || publishDate,
  "author": [{
    "@type": "Person",
    "name": authorName,
    "url": new URL('/', Astro.site).href
  }],
  "publisher": {
    "@type": "Organization",
    "name": "Riftbound Media",
    "logo": {
      "@type": "ImageObject",
      "url": new URL('/riftbound-logo.png', Astro.site).href
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": pageUrl.href
  }
};

function getTagStyle(tag: string): string {
  const t = tag.toLowerCase().trim();
  
  if (t.includes('riot') || t.includes('officiel') || t.includes('store')) return 'bg-domain-order/15 text-domain-order border-domain-order/30';
  if (t.includes('tournoi') || t.includes('compétitif')) return 'bg-accent-spirit/15 text-accent-spirit border-accent-spirit/30';
  if (t.includes('mise à jour') || t.includes('actualité') || t.includes('news')) return 'bg-domain-calm/15 text-domain-calm border-domain-calm/30';
  if (t.includes('équilibrage') || t.includes('patch')) return 'bg-accent-forge/15 text-accent-forge border-accent-forge/30';
  if (t.includes('lore') || t.includes('fun')) return 'bg-domain-chaos/15 text-domain-chaos border-domain-chaos/30';
  if (t.includes('carte') || t.includes('règles')) return 'bg-domain-mind/15 text-domain-mind border-domain-mind/30';
  if (t.includes('interview')) return 'bg-accent-sakura/20 text-accent-sakura border-accent-sakura/30';
  if (t.includes('errata')) return 'bg-domain-body/15 text-domain-body border-domain-body/30';
  if (t === 'set 1') return 'bg-[#C5A059]/15 text-[#C5A059] border-[#C5A059]/30';
  if (t === 'set 2') return 'bg-[#A5A9B4]/15 text-[#A5A9B4] border-[#A5A9B4]/30';
  if (t === 'set 3') return 'bg-[#722d6c]/15 text-[#c46db8] border-[#722d6c]/30';
  if (t === 'eu') return 'bg-blue-500/15 text-blue-300 border-blue-500/30';
  if (t === 'us') return 'bg-red-500/15 text-red-300 border-red-500/30';
  if (t === 'chine') return 'bg-amber-500/15 text-amber-300 border-amber-500/30';

  return 'bg-rift-800/50 text-rift-200 border-rift-700/50';
}
---

<MainLayout 
  title={article.title} 
  description={seoDescription}
  image={proxyUrl(article.image_url)}
  type="article"
  petalMode="sides"
>
  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />


  <article class="max-w-4xl mx-auto px-4 sm:px-6 pt-10 pb-16">

    <a href="/news" class="inline-flex items-center gap-1.5 text-sm text-accent-spirit hover:text-accent-forge font-medium mb-8 transition-colors duration-300 group">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
      </svg>
      Retour aux actualités
    </a>

    <header class="mb-8">
      <div class="flex flex-wrap gap-2 mb-4">
        {article.tags?.map((tag: string) => (
          <span class={`px-2.5 py-0.5 text-xs font-medium rounded-full border ${getTagStyle(tag)}`}>
            {tag}
          </span>
        ))}
      </div>

      <h1 class="text-3xl md:text-4xl font-display font-bold text-rift-50 mb-4 leading-tight">
        {article.title}
      </h1>

      <div class="flex items-center gap-3 text-sm text-rift-500">
        <div class="flex items-center gap-2">
          {article.profiles?.avatar_url ? (
            <img 
              src={article.profiles.avatar_url} 
              alt={authorName} 
              class="w-7 h-7 rounded-full object-cover border border-rift-700/50" 
            />
          ) : (
            <div class="w-7 h-7 rounded-full bg-gradient-to-br from-accent-spirit to-accent-sakura flex items-center justify-center text-[10px] font-bold text-white">
              {authorName.charAt(0)}
            </div>
          )}
          <span>{authorName}</span>
        </div>
        <span class="text-rift-300">·</span>
        <span>Publié le {formattedDate}</span>
      </div>
    </header>

    <!-- Hero image -->
    <div class="relative w-full overflow-hidden mb-12 rounded-lg border border-rift-700/30">
      {article.image_url ? (
        <img src={proxyUrl(article.image_url)} alt={article.title} class="w-full h-auto block" />
      ) : (
        <>
          <div class="absolute inset-0 bg-gradient-to-br from-accent-sakura/15 via-rift-100 to-accent-forge/10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(227,158,166,0.12),transparent_60%)]"></div>
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22><circle cx=%2220%22 cy=%2220%22 r=%221.5%22 fill=%22%23e39ea6%22/></svg>'); background-size: 40px 40px;"></div>
        </>
      )}
    </div>

    <div class="prose prose-invert prose-orange max-w-none flow-root
      prose-headings:font-display prose-headings:font-bold prose-headings:text-rift-50
      prose-h2:text-xl prose-h2:mt-8 prose-h2:mb-4
      prose-h3:text-lg prose-h3:mt-6 prose-h3:mb-3
      prose-p:text-rift-200 prose-p:leading-relaxed
      prose-a:text-accent-spirit prose-a:no-underline hover:prose-a:text-accent-forge hover:prose-a:underline
      prose-strong:text-rift-50
      prose-li:text-rift-200
      prose-blockquote:border-l-4 prose-blockquote:border-accent-spirit/70 prose-blockquote:text-rift-100 prose-blockquote:bg-rift-950/50 prose-blockquote:py-2 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:my-8 prose-blockquote:border-solid
      prose-img:rounded-none
      prose-table:text-sm
      prose-th:text-accent-forge prose-th:font-semibold
      prose-td:text-rift-200
      prose-hr:border-rift-700/50"
      set:html={htmlContent}
    />

    <div class="mt-12 pt-8 border-t border-rift-700/50 clear-both">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <a href="/news" class="inline-flex items-center gap-1.5 text-sm text-accent-spirit hover:text-accent-forge font-medium transition-colors duration-300 group">
          <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" />
          </svg>
          Retour aux actualités
        </a>

        <button 
          onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
          class="inline-flex items-center gap-3 text-sm text-rift-400 hover:text-accent-spirit transition-all duration-300 group"
        >
          <span class="font-medium tracking-wide">Remonter en haut</span>
          <div class="w-9 h-9 rounded-full border border-rift-700/50 group-hover:border-accent-spirit/50 flex items-center justify-center transition-all group-hover:bg-accent-spirit/5">
            <svg class="w-4 h-4 group-hover:-translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
            </svg>
          </div>
        </button>
      </div>
    </div>
  </article>

  <!-- Floating Edit Button (admin/editor only) -->
  {isEditor && (
    <a
      href={`/admin/articles/${article.id}`}
      class="fixed bottom-6 right-6 z-50 group"
      title="Éditer cet article"
    >
      <div class="w-12 h-12 rounded-full bg-accent-spirit/90 hover:bg-accent-spirit text-rift-950 flex items-center justify-center shadow-lg shadow-accent-spirit/25 hover:shadow-accent-spirit/40 transition-all duration-300 hover:scale-110">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      </div>
      <span class="absolute right-full mr-3 top-1/2 -translate-y-1/2 px-3 py-1.5 rounded-lg bg-rift-900/95 border border-rift-700/50 text-xs font-medium text-rift-200 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none shadow-xl">
        Éditer l'article
      </span>
    </a>
  )}

  <!-- Image Lightbox Overlay — no backdrop-blur for max GPU perf -->
  <div id="lightbox-overlay" class="fixed inset-0 z-[100] pointer-events-none cursor-zoom-out" style="contain: layout style;">
    <!-- Dark background (separate layer for independent opacity animation) -->
    <div id="lightbox-bg" class="absolute inset-0 bg-rift-950/95" style="opacity: 0; transition: opacity 0.3s ease; will-change: opacity;"></div>
    
    <!-- Close button -->
    <div class="absolute top-4 right-4 sm:top-8 sm:right-8 z-10">
      <button id="lightbox-close" class="w-10 h-10 rounded-full bg-rift-800/80 text-rift-100 flex items-center justify-center hover:bg-red-500 hover:text-white transition-colors" style="opacity: 0; transition: opacity 0.2s ease 0.15s;">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- FLIP Image — positioned absolutely, animated via transform only (GPU-composited) -->
    <img id="lightbox-img" src="" alt="Zoom" class="absolute rounded-lg shadow-2xl hidden" style="transform-origin: 0 0; will-change: transform; transition: none;" />
    
    <!-- Video fallback (keeps old scale approach) -->
    <video id="lightbox-video" autoplay loop muted playsinline class="absolute top-1/2 left-1/2 max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl hidden" style="transform: translate(-50%, -50%) scale(0.88); opacity: 0; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease; will-change: transform, opacity;">
      <source src="" type="video/mp4">
    </video>
  </div>

  <script>
    // FLIP Lightbox — smooth zoom from source position, GPU-only transforms, no backdrop-blur
    const overlay = document.getElementById('lightbox-overlay')!;
    const overlayBg = document.getElementById('lightbox-bg')!;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
    const closeBtn = document.getElementById('lightbox-close')!;
    
    const articleMedia = document.querySelectorAll('.prose img:not(.icon-tcg):not(.icon-energy):not(.youtube-thumbnail), .prose .article-video');
    
    let sourceElement: HTMLElement | null = null;
    let isAnimating = false;

    // Scrollbar compensation — prevents layout shift when toggling overflow
    function lockScroll() {
      const scrollbarW = window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = 'hidden';
      document.body.style.paddingRight = scrollbarW + 'px';
    }
    function unlockScroll() {
      document.body.style.overflow = '';
      document.body.style.paddingRight = '';
    }

    // Compute the FLIP transform: from final position, invert back to source position
    function computeFlip(sourceRect: DOMRect, img: HTMLImageElement) {
      const viewW = window.innerWidth;
      const viewH = window.innerHeight;
      const pad = window.innerWidth < 640 ? 16 : 32; // p-4 / p-8

      // Final: image centered in viewport, constrained to max-w/max-h
      const natW = img.naturalWidth || sourceRect.width;
      const natH = img.naturalHeight || sourceRect.height;
      const aspect = natW / natH;

      const maxW = viewW - pad * 2;
      const maxH = viewH - pad * 2;

      let finalW: number, finalH: number;
      if (maxW / maxH > aspect) {
        finalH = Math.min(maxH, natH);
        finalW = finalH * aspect;
      } else {
        finalW = Math.min(maxW, natW);
        finalH = finalW / aspect;
      }

      const finalX = (viewW - finalW) / 2;
      const finalY = (viewH - finalH) / 2;

      // Invert: transform from final to source
      const scaleX = sourceRect.width / finalW;
      const scaleY = sourceRect.height / finalH;
      const translateX = sourceRect.left - finalX;
      const translateY = sourceRect.top - finalY;

      return { finalX, finalY, finalW, finalH, scaleX, scaleY, translateX, translateY };
    }

    function openLightbox(element: HTMLElement) {
      if (isAnimating) return;
      isAnimating = true;
      sourceElement = element;
      
      const isVideo = element.tagName.toLowerCase() === 'video';
      
      if (isVideo) {
        const videoSource = (element as HTMLVideoElement).querySelector('source')?.src || (element as HTMLVideoElement).src;
        lightboxVideo.src = videoSource;
        lightboxVideo.classList.remove('hidden');
        lightboxImg.classList.add('hidden');
        lightboxVideo.play().catch(() => {});

        overlay.style.pointerEvents = 'auto';
        overlayBg.style.opacity = '1';
        closeBtn.style.opacity = '1';
        
        requestAnimationFrame(() => {
          lightboxVideo.style.transform = 'translate(-50%, -50%) scale(1)';
          lightboxVideo.style.opacity = '1';
          setTimeout(() => { isAnimating = false; }, 400);
        });
        lockScroll();
        return;
      }

      // --- FLIP for images ---
      const src = (element as HTMLImageElement).src;
      const sourceRect = element.getBoundingClientRect();

      // Prepare lightbox img — keep INVISIBLE until FLIP transform is set
      lightboxImg.style.transition = 'none';
      lightboxImg.style.visibility = 'hidden';
      lightboxImg.src = src;
      lightboxImg.classList.remove('hidden');
      lightboxVideo.classList.add('hidden');

      // Wait for image dimensions to be available
      const proceed = () => {
        const flip = computeFlip(sourceRect, lightboxImg);
        
        // Position at final location
        lightboxImg.style.left = flip.finalX + 'px';
        lightboxImg.style.top = flip.finalY + 'px';
        lightboxImg.style.width = flip.finalW + 'px';
        lightboxImg.style.height = flip.finalH + 'px';
        
        // INVERT: start at source position via transform
        lightboxImg.style.transform = `translate(${flip.translateX}px, ${flip.translateY}px) scale(${flip.scaleX}, ${flip.scaleY})`;
        lightboxImg.style.borderRadius = '8px';
        
        // NOW reveal — transform is in place, no flash
        lightboxImg.style.visibility = 'visible';
        
        // Show overlay
        overlay.style.pointerEvents = 'auto';
        lockScroll();
        
        // Fade the source element slightly
        (element as HTMLElement).style.opacity = '0.3';
        
        // PLAY: animate to final position in next frame
        requestAnimationFrame(() => {
          // Enable transition
          lightboxImg.style.transition = 'transform 0.4s cubic-bezier(0.2, 0, 0.1, 1)';
          overlayBg.style.opacity = '1';
          closeBtn.style.opacity = '1';
          
          // Animate to identity (final centered position)
          lightboxImg.style.transform = 'translate(0, 0) scale(1, 1)';
          
          setTimeout(() => { isAnimating = false; }, 400);
        });
      };

      // If natural dimensions available (cached), proceed immediately
      if (lightboxImg.naturalWidth > 0) {
        proceed();
      } else {
        lightboxImg.onload = proceed;
      }
    }
    
    function closeLightbox() {
      if (isAnimating) return;
      isAnimating = true;

      // Unlock scroll IMMEDIATELY while overlay is still opaque — prevents flash
      unlockScroll();
      
      // Restore source opacity NOW — the lightbox image covers it so this is invisible
      if (sourceElement) (sourceElement as HTMLElement).style.opacity = '';

      // Video path
      if (!lightboxVideo.classList.contains('hidden')) {
        lightboxVideo.style.transform = 'translate(-50%, -50%) scale(0.88)';
        lightboxVideo.style.opacity = '0';
        lightboxVideo.pause();
        overlayBg.style.opacity = '0';
        closeBtn.style.opacity = '0';
        
        setTimeout(() => {
          overlay.style.pointerEvents = 'none';
          lightboxVideo.classList.add('hidden');
          lightboxVideo.src = '';
          sourceElement = null;
          isAnimating = false;
        }, 400);
        return;
      }

      // --- FLIP reverse for images ---
      if (sourceElement) {
        const sourceRect = sourceElement.getBoundingClientRect();
        const flip = computeFlip(sourceRect, lightboxImg);
        
        // Animate back to source position — sync bg fade with image duration
        lightboxImg.style.transition = 'transform 0.35s cubic-bezier(0.4, 0, 0.2, 1)';
        lightboxImg.style.transform = `translate(${flip.translateX}px, ${flip.translateY}px) scale(${flip.scaleX}, ${flip.scaleY})`;
        overlayBg.style.transition = 'opacity 0.35s ease';
        overlayBg.style.opacity = '0';
        closeBtn.style.opacity = '0';
        
        setTimeout(() => {
          overlay.style.pointerEvents = 'none';
          lightboxImg.classList.add('hidden');
          lightboxImg.style.visibility = 'hidden';
          lightboxImg.style.transition = 'none';
          lightboxImg.src = '';
          overlayBg.style.transition = 'opacity 0.3s ease';
          sourceElement = null;
          isAnimating = false;
        }, 360);
      } else {
        // Fallback: simple fade
        lightboxImg.style.transition = 'opacity 0.25s ease';
        lightboxImg.style.opacity = '0';
        overlayBg.style.opacity = '0';
        closeBtn.style.opacity = '0';
        
        setTimeout(() => {
          overlay.style.pointerEvents = 'none';
          lightboxImg.classList.add('hidden');
          lightboxImg.src = '';
          isAnimating = false;
        }, 300);
      }
    }

    articleMedia.forEach(el => {
      (el as HTMLElement).classList.add('cursor-zoom-in');
      (el as HTMLElement).style.transition = 'opacity 0.2s ease';
      
      el.addEventListener('click', () => {
        openLightbox(el as HTMLElement);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    
    overlay?.addEventListener('click', (e) => {
      if (e.target === overlay || e.target === overlayBg) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  </script>

</MainLayout>

<style is:global>
  /* Spacer for multiple empty lines */
  .prose .spacer {
    display: block;
    width: 100%;
  }

  /* TCG Icons */
  .prose .icon-tcg {
    display: inline-block;
    height: 1.3em;
    width: auto;
    vertical-align: middle;
    margin: 0 0.2em;
    transform: translateY(-1px);
  }

  .prose .icon-energy {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.4em;
    height: 1.4em;
    border-radius: 50%;
    background-color: #1a1a1a;
    color: #fff;
