---
import MainLayout from '../../layouts/MainLayout.astro';
export const prerender = false;
---

<MainLayout title="Authentification en cours...">
  <div class="fixed inset-0 bg-rift-900 flex items-center justify-center z-[100]">
    <div class="text-center">
      <div class="w-16 h-16 border-4 border-accent-spirit border-t-transparent rounded-full animate-spin mx-auto mb-6"></div>
      <h2 class="text-2xl font-display font-bold text-rift-100 mb-2">Connexion en cours...</h2>
      <p class="text-rift-400">Veuillez patienter pendant que nous sécurisons votre session.</p>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';

    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    async function handleAuth() {
        // Le SDK Supabase va automatiquement extraire le code/hash de l'URL
        // et utiliser le verifier stocké en localStorage pour obtenir la session.
        const { data: { session }, error } = await supabase.auth.getSession();

        if (error) {
            console.error('[auth] Erreur session:', error.message);
            window.location.href = '/login?error=callback_failed';
            return;
        }

        if (session) {
            console.log('[auth] Session obtenue, synchronisation...');
            
            // On envoie la session au serveur pour qu'il pose les cookies HttpOnly
            const res = await fetch('/api/auth/sync', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    access_token: session.access_token,
                    refresh_token: session.refresh_token
                })
            });

            if (res.ok) {
                console.log('[auth] Sync OK, redirection...');
                window.location.href = '/';
            } else {
                console.error('[auth] Echec de la synchronisation serveur');
                window.location.href = '/login?error=sync_failed';
            }
        } else {
            console.warn('[auth] Aucune session trouvée');
            window.location.href = '/login';
        }
    }

    handleAuth();
  </script>
</MainLayout>
