---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { proxyUrl } from '../lib/proxy';
import { supabase } from '../lib/supabase';
import { getCollection } from 'astro:content';

// Cache navigateur uniquement (pas de cache CDN public pour éviter les conflits de session)
Astro.response.headers.set('Cache-Control', 'private, max-age=60');

// Articles depuis Supabase (colonnes spécifiques = moins d'egress)
const { data: latestArticles, error: latestError } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, created_at, article_number, highlighted')
  .eq('published', true)
  .order('published_at', { ascending: false })
  .order('created_at', { ascending: false })
  .limit(6);

const latestNews = latestArticles || [];

// Fetch Tournaments specifically (check for 'tournoi' or 'Tournoi')
const { data: tournamentNews } = await supabase
  .from('articles')
  .select('id, title, slug, summary, image_url, tags, published_at, created_at, article_number, highlighted')
  .eq('published', true)
  .or('tags.cs.{"tournoi"},tags.cs.{"Tournoi"}')
  .order('published_at', { ascending: false })
  .order('created_at', { ascending: false })
  .limit(3);

const realTournaments = tournamentNews || [];

// Mock items to ensure 3 real-looking slots (copies of the interview style)
// Mock items removed as per user request
const mockTournaments = [];

const tournaments = realTournaments
  .sort((a, b) => new Date(b.published_at || b.created_at).getTime() - new Date(a.published_at || a.created_at).getTime())
  .slice(0, 3);

// Règles depuis Content Collections (statique)
const allRules = await getCollection('rules');
const sortedRules = allRules.sort((a, b) => a.data.order - b.data.order);
---

<MainLayout 
  title="Riftbound TCG | Accueil - Portail Francophone"
  description="Découvrez Riftbound Media, le portail n°1 de la communauté francophone Riftbound TCG. Actualités, tournois, guides de deck et calendrier complet des événements."
>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-x-0 top-0 h-[500px] pointer-events-none z-0" style="background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(160,28,64,0.23), transparent);"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-8 sm:pt-16 pb-12 sm:pb-24 text-center z-10">
      
      <!-- Decorative line -->


      <div class="flex items-center justify-center gap-4 mb-6 animate-fade-in">
        <div class="h-px w-12 sm:w-24 bg-gradient-to-r from-transparent to-[#A5A9B4]/60"></div>
        <!-- Remplace le texte par l'image du logo Vendetta. 
             Taille réduite d'environ 25% (h-8 sm:h-9) -->
        <img src="/vendetta-logo.png" alt="Vendetta" class="h-8 sm:h-9 object-contain opacity-90 drop-shadow-md" />
        <div class="h-px w-12 sm:w-24 bg-gradient-to-l from-transparent to-[#A5A9B4]/60"></div>
      </div>

      <h1 class="font-display font-bold tracking-tight animate-slide-up flex flex-col items-center -mt-20 sm:-mt-32 -mb-10 sm:-mb-24">
        <img src="/riftbound-logo.png?v=3" alt="Riftbound Media" class="w-[22rem] sm:w-[30rem] md:w-[39rem] h-auto drop-shadow-lg" />
        <span class="sr-only">Riftbound Media — Portail Francophone Riftbound TCG</span>
      </h1>

      <p class="text-rift-300 text-sm md:text-base max-w-xl mx-auto mb-6 sm:mb-10 animate-slide-up-delay leading-relaxed">
        Votre source francophone pour l'univers Riftbound.<br />
        Actualités, tournois, règles et communauté.
      </p>

      <div class="flex flex-wrap gap-4 justify-center animate-slide-up-delay-2">
        <a href="/news" class="group px-7 py-3 rounded-xl bg-accent-spirit text-rift-900 font-bold text-sm shadow-spirit hover:shadow-lg hover:bg-accent-spirit/90 transition-all duration-300 hover:-translate-y-0.5">
          Toute l'actualité
          <span class="inline-block ml-1 group-hover:translate-x-1 transition-transform duration-300">→</span>
        </a>
      </div>
    </div>

  </section>



  <!-- All Latest News -->
  {latestNews.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
          <h2 class="text-xl font-display font-bold text-rift-100">Dernières Actualités</h2>
        </div>
        <a href="/news" class="text-sm text-accent-spirit hover:text-accent-forge font-medium transition-colors duration-300 flex items-center gap-1">
          Tout voir <span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestNews.map((article) => (
          <NewsCard
            title={article.title}
            summary={article.summary || ''}
            image={proxyUrl(article.image_url)}
            tags={article.tags || []}
            author=""
            pubDate={new Date(article.published_at || article.created_at)}
            slug={article.slug}
            articleNumber={article.article_number}
            highlighted={article.highlighted || false}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Tournaments Section -->
  {tournaments.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <div class="w-1 h-6 rounded-full bg-gradient-to-b from-domain-chaos to-accent-spirit"></div>
        <h2 class="text-xl font-display font-bold text-rift-100">Tous les Tournois</h2>
      </div>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {tournaments.map((article) => (
        <NewsCard
          title={article.title}
          summary={article.summary || ''}
          image={proxyUrl(article.image_url)}
          tags={article.tags || []}
          author=""
          pubDate={new Date(article.published_at || article.created_at)}
          slug={article.slug}
          articleNumber={article.article_number}
          highlighted={article.highlighted || false}
        />
      ))}
    </div>
    </div>
  </section>
  )}



  <!-- Community CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-8">
    <div class="relative overflow-hidden rounded-2xl border border-rift-700/50 p-8 md:p-12 text-center bg-gradient-to-br from-rift-900/80 via-rift-800/50 to-rift-900/80">
      <!-- Decorative -->
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-forge/30 to-transparent"></div>

      <div class="relative">
        <span class="text-accent-spirit text-xs font-display tracking-[0.2em] uppercase mb-4 block">Communauté</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-4 text-rift-100">Rejoignez la Communauté</h2>
        <p class="text-rift-300 mb-8 max-w-lg mx-auto leading-relaxed">
          Discutez stratégie et tournois, partagez vos decklists, et surtout restez informés des actualités avec Riftbound Media
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="https://discord.gg/QDB6WfA9Zm" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-[#5865F2] text-white text-sm font-semibold hover:bg-[#4752C4] transition-all duration-300 shadow-lg shadow-[#5865F2]/20 hover:-translate-y-0.5 border border-[#5865F2]">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-3.6751 1.5152.07.07 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.057 19.9 19.9 0 005.9936 3.03.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.3101-1.274-.6629-1.8703-.9132a.077.077 0 01-.009-.1363c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.006.1376 12.2949 12.2949 0 01-1.873.9142.076.076 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.993a.076.076 0 00.0842.0286 19.839 19.839 0 006.0028-3.03.077.077 0 00.0321-.0544c.5-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9554 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
            Discord
          </a>
          <a href="https://x.com/Riftbound_Media" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-black text-white text-sm font-semibold hover:bg-black/80 transition-all duration-300 shadow-lg shadow-black/20 hover:-translate-y-0.5 border border-black">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            Twitter / X
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script>
  // Simple Parallax Effect
  const heroSection = document.querySelector('section.relative');
  const bgElement = heroSection?.querySelector('.bg-spirit-radial') as HTMLElement;

  if (heroSection) {
    window.addEventListener('scroll', () => {
      const scrolled = window.scrollY;
      
      // Optimize: stop calculating if out of view
      if (scrolled > 800) return;

      // Background moves slower (depth)
      if (bgElement) {
        bgElement.style.transform = `translateY(${scrolled * 0.4}px)`;
      }
    });
  }
</script>
