---
export const prerender = false;

import MainLayout from '../layouts/MainLayout.astro';
import NewsCard from '../components/NewsCard.astro';
import { supabase } from '../lib/supabase';
import { getCollection } from 'astro:content';

// Articles depuis Supabase
const { data: allNews } = await supabase
  .from('articles')
  .select('*')
  .eq('published', true)
  .order('created_at', { ascending: false })
  .limit(6);

const featuredNews = allNews?.filter((n) => n.featured).slice(0, 3) || [];
const latestNews = allNews || [];

// Règles depuis Content Collections (statique)
const allRules = await getCollection('rules');
const sortedRules = allRules.sort((a, b) => a.data.order - b.data.order);
---

<MainLayout title="Accueil">

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-spirit-radial"></div>
    <div class="absolute inset-0 bg-forge-radial"></div>



    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-20 pb-16 md:pt-28 md:pb-24 text-center">
      <!-- Decorative line -->


      <div class="flex items-center justify-center gap-4 mb-6 animate-fade-in">
        <div class="h-px w-12 bg-gradient-to-r from-transparent to-accent-forge/50"></div>
        <span class="text-accent-forge text-xs font-display tracking-[0.3em] uppercase">Spiritforged</span>
        <div class="h-px w-12 bg-gradient-to-l from-transparent to-accent-forge/50"></div>
      </div>

      <h1 class="font-display font-bold tracking-tight mb-6 animate-slide-up flex flex-col items-center">
        <img src="/riftbound-logo.png" alt="Riftbound" class="w-48 sm:w-56 md:w-72 h-auto mb-3 drop-shadow-lg" />
        <span class="block text-2xl sm:text-3xl md:text-4xl mt-2 text-accent-spirit tracking-widest">MEDIA</span>
      </h1>

      <p class="text-rift-300 text-lg md:text-xl max-w-xl mx-auto mb-10 animate-slide-up-delay leading-relaxed">
        Votre source francophone pour l'univers Riftbound. Actualités, règles, méta et communauté.
      </p>

      <div class="flex flex-wrap gap-4 justify-center animate-slide-up-delay-2">
        <a href="/news" class="group px-7 py-3 rounded-xl bg-accent-spirit text-white font-semibold text-sm shadow-spirit hover:shadow-lg hover:bg-accent-spirit/90 transition-all duration-300 hover:-translate-y-0.5">
          Dernières Actualités
          <span class="inline-block ml-1 group-hover:translate-x-1 transition-transform duration-300">→</span>
        </a>
      </div>
    </div>

    <!-- Bottom fade -->
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-rift-900 to-transparent"></div>
  </section>

  <!-- Featured News -->
  {featuredNews.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-spirit to-accent-sakura"></div>
          <h2 class="text-xl font-display font-bold text-rift-100 uppercase tracking-wider">À la Une</h2>
        </div>
        <a href="/news" class="text-sm text-accent-spirit hover:text-accent-forge font-medium transition-colors duration-300 flex items-center gap-1">
          Voir tout <span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredNews.map((article) => (
          <NewsCard
            title={article.title}
            summary={article.summary || ''}
            image={article.image_url || ''}
            tags={article.tags || []}
            author=""
            pubDate={new Date(article.created_at)}
            slug={article.slug}
            featured={true}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All Latest News -->
  {latestNews.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3">
          <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-sakura"></div>
          <h2 class="text-xl font-display font-bold text-rift-100">Dernières Actualités</h2>
        </div>
        <a href="/news" class="text-sm text-accent-spirit hover:text-accent-forge font-medium transition-colors duration-300 flex items-center gap-1">
          Tout voir <span>→</span>
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {latestNews.map((article) => (
          <NewsCard
            title={article.title}
            summary={article.summary || ''}
            image={article.image_url || ''}
            tags={article.tags || []}
            author=""
            pubDate={new Date(article.created_at)}
            slug={article.slug}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Rules Preview -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-16">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <div class="w-1 h-6 rounded-full bg-gradient-to-b from-accent-forge to-accent-spirit"></div>
        <h2 class="text-xl font-display font-bold text-rift-100">Règles du Jeu</h2>
      </div>
      <a href="/rules" class="text-sm text-accent-spirit hover:text-accent-forge font-medium transition-colors duration-300 flex items-center gap-1">
        Voir les règles <span>→</span>
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {sortedRules.map((rule) => (
        <a href="/rules" class="group flex items-start gap-4 p-5 rounded-2xl bg-white/60 border border-rift-200/60 hover:border-accent-sakura/40 transition-all duration-300 hover:shadow-sakura hover:-translate-y-0.5">
          <span class="text-3xl flex-shrink-0 group-hover:scale-110 transition-transform duration-300">{rule.data.icon}</span>
          <div>
            <h3 class="text-base font-display font-bold text-rift-100 mb-1 group-hover:text-accent-spirit transition-colors duration-300">{rule.data.title}</h3>
            <p class="text-sm text-rift-400 line-clamp-2 leading-relaxed">{rule.data.summary}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Community CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 mb-8">
    <div class="relative overflow-hidden rounded-2xl border border-accent-sakura/20 p-8 md:p-12 text-center bg-gradient-to-br from-white/80 via-accent-glow/20 to-white/80">
      <!-- Decorative -->
      <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-forge/30 to-transparent"></div>

      <div class="relative">
        <span class="text-accent-forge text-xs font-display tracking-[0.2em] uppercase mb-4 block">Communauté</span>
        <h2 class="text-2xl md:text-3xl font-display font-bold mb-4 text-rift-900">Rejoignez la Communauté</h2>
        <p class="text-rift-600 mb-8 max-w-lg mx-auto leading-relaxed">
          Discutez stratégie, partagez vos decks et restez informés des derniers événements.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="#" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#5865F2] text-white text-sm font-semibold hover:bg-[#4752C4] transition-all duration-300 shadow-lg shadow-[#5865F2]/20 hover:-translate-y-0.5">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
            Discord
          </a>
          <a href="#" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl text-rift-700 text-sm font-semibold border border-rift-300 bg-white/60 hover:border-accent-spirit hover:text-accent-spirit transition-all duration-300">
            Twitter / X
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>
