---
interface Props {
  name: string;
  id: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  label?: string;
}

const { id, name, value = '', placeholder = '', rows = 20, required = false, label } = Astro.props;

// Lecture dynamique des icônes disponibles
import fs from 'node:fs';
import path from 'node:path';

const iconsDir = path.join(process.cwd(), 'public', 'assets', 'icons');
let availableIcons = [];
try {
  if (fs.existsSync(iconsDir)) {
    availableIcons = fs.readdirSync(iconsDir)
      .filter(file => file.endsWith('.png') && !file.includes('logo'))
      .map(file => ({
        name: file.replace('.png', '').charAt(0).toUpperCase() + file.replace('.png', '').slice(1),
        filename: file
      }));
  }
} catch (e) {
  console.error('Erreur lecture icônes:', e);
}
---

<div class="markdown-editor flex flex-col gap-2" data-id={id}>
  {label && <label for={id} class="block text-sm font-medium text-rift-300 mb-1">{label}</label>}
  
  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-1 p-2 border border-rift-700/50 rounded-t-lg bg-rift-900/50">
