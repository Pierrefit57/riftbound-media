---
interface Props {
  name: string;
  id: string;
  value?: string;
  placeholder?: string;
  rows?: number;
  required?: boolean;
  label?: string;
}

const { name, id, value = '', placeholder, rows = 20, required = false, label } = Astro.props;
---

<div class="markdown-editor flex flex-col gap-2" data-id={id}>
  {label && <label for={id} class="block text-sm font-medium text-rift-300 mb-1">{label}</label>}
  
  <!-- Toolbar -->
  <div class="flex flex-wrap items-center gap-1 p-2 border border-rift-700/50 rounded-t-lg bg-rift-900/50">
    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Gras" data-action="bold">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 12h8a4 4 0 100-8H6v8zm0 0h8a4 4 0 110 8H6v-8z" />
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Italique" data-action="italic">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 4h-4l-4 16h4" />
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Barré" data-action="strike">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L15 9M4.5 12h15" />
      </svg>
    </button>
    
    <div class="w-px h-4 bg-rift-800 mx-1"></div>

    <!-- Font Size -->
    <div class="flex items-center gap-1">
      <select class="font-size-select h-7 text-xs bg-rift-950 border border-rift-700 text-rift-300 rounded px-1" title="Taille">
        <option value="" disabled selected>Taille</option>
        {[14, 16, 18, 20, 24, 28, 32, 40].map((size) => (
          <option value={size}>{size}px</option>
        ))}
      </select>
      <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors flex items-center gap-0.5" title="Appliquer" data-action="fontSize">
        <span class="text-[10px] font-bold">T</span>
        <svg class="w-2 h-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </button>
    </div>

    <div class="w-px h-4 bg-rift-800 mx-1"></div>

    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Citation" data-action="quote">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Lien" data-action="link">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
    </button>
    <button type="button" class="p-1.5 rounded hover:bg-rift-800 text-rift-400 hover:text-accent-spirit transition-colors" title="Liste" data-action="list">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16M4 6l2 0m-2 6l2 0m-2 6l2 0" />
      </svg>
    </button>

    <div class="flex-1"></div>
    
    <button type="button" class="editor-status-dot w-3 h-3 rounded-full bg-rift-700 transition-colors" title="Status"></button>

    <button type="button" class="flex items-center gap-1.5 px-3 py-1 rounded bg-accent-spirit text-rift-950 hover:bg-accent-spirit/90 transition-colors text-xs font-bold" title="Image" data-action="image">
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      IMAGE
    </button>
    <input type="file" accept="image/*" class="hidden image-upload-input" />
  </div>

  <!-- Textarea -->
  <div class="relative flex flex-col border border-t-0 border-rift-700/50 rounded-b-lg bg-rift-950 min-h-[500px] overflow-hidden focus-within:border-accent-spirit/50 transition-colors">
    <textarea
      id={id}
      name={name}
      required={required}
      class="flex-1 w-full px-4 py-3 bg-transparent text-rift-100 placeholder-rift-600 focus:outline-none font-mono text-sm leading-relaxed resize-y overflow-y-auto"
      placeholder={placeholder}
    >{value}</textarea>
  </div>

  <div class="upload-loading hidden mt-1 flex items-center gap-2 text-xs text-accent-spirit">
    <div class="w-3 h-3 border-2 border-accent-spirit/30 border-t-accent-spirit rounded-full animate-spin"></div>
    Envoi...
  </div>
</div>

<!-- CDN Marked Library -->
<script is:inline src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script is:inline>
  (function() {
    class MarkdownEditor {
      constructor(container) {
        this.container = container;
        this.textarea = container.querySelector('textarea');
        this.fileInput = container.querySelector('.image-upload-input');
        this.uploadLoading = container.querySelector('.upload-loading');
        this.fontSizeSelect = container.querySelector('.font-size-select');
        this.statusDot = container.querySelector('.editor-status-dot');
        // Look for the preview area on the page
        this.preview = document.querySelector('.article-live-preview');

        if (!this.textarea) return;
        this.init();
      }

      init() {
        this.textarea.addEventListener('input', () => this.updatePreview());
        
        // Auto-continue blockquotes on Enter
        this.textarea.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            const start = this.textarea.selectionStart;
            const text = this.textarea.value;
            const before = text.substring(0, start);
            const currentLine = before.split('\n').pop();
            
            if (currentLine.trim().startsWith('>')) {
              e.preventDefault();
              const prefix = '\n> ';
              this.insertText(prefix, start, start);
              const newPos = start + prefix.length;
              this.textarea.setSelectionRange(newPos, newPos);
            }
          }
        });

        this.initToolbar();
        this.initImageUpload();
        this.updatePreview();
        if (this.statusDot) this.statusDot.style.backgroundColor = '#22c55e';
      }

      updatePreview() {
        if (!this.preview || !window.marked) return;
        this.preview.innerHTML = window.marked.parse(this.textarea.value || '');
      }

      // Helper to preserve UNDO stack (Ctrl+Z)
      insertText(newText, sStart, sEnd) {
        this.textarea.focus();
        this.textarea.setSelectionRange(sStart, sEnd);
        
        try {
          if (!document.execCommand('insertText', false, newText)) {
            throw new Error('execCommand failed');
          }
        } catch (e) {
          const val = this.textarea.value;
          this.textarea.value = val.substring(0, sStart) + newText + val.substring(sEnd);
          this.textarea.dispatchEvent(new Event('input'));
        }
      }

      initToolbar() {
        this.container.addEventListener('mousedown', (e) => {
          const btn = e.target.closest('[data-action]');
          if (!btn) return;

          e.preventDefault();
          this.handleAction(btn.dataset.action);
        });
      }

      handleAction(action) {
        const start = this.textarea.selectionStart;
        const end = this.textarea.selectionEnd;
        const text = this.textarea.value;
        const selection = text.substring(start, end);

        const checkToggle = (tag) => {
          if (text.substring(start - tag.length, start) === tag && text.substring(end, end + tag.length) === tag) {
             return { before: tag.length, after: tag.length };
          }
          return null;
        };

        const toggleWrap = (tag) => {
          const info = checkToggle(tag);
          if (info) {
             const sStart = start - info.before;
             const sEnd = end + info.after;
             this.insertText(selection, sStart, sEnd);
             
             const newStart = start - info.before;
             const newEnd = end - info.before;
             this.textarea.setSelectionRange(newStart, newEnd);
             return true;
          }
          return false;
        };

        let prefix = '', suffix = '';
        let content = selection;

        switch(action) {
          case 'bold':
            if (toggleWrap('**')) return;
            prefix = '**'; suffix = '**';
            if (!content) content = 'gras';
            break;
          case 'italic':
            if (toggleWrap('*')) return;
            prefix = '*'; suffix = '*';
            if (!content) content = 'italique';
            break;
          case 'strike':
            if (toggleWrap('~~')) return;
            prefix = '~~'; suffix = '~~';
            if (!content) content = 'barré';
            break;
          case 'quote':
            if (selection.includes('\n')) {
              const multiLine = selection.split('\n').map(line => `> ${line}`).join('\n');
              this.insertText(multiLine, start, end);
              this.textarea.setSelectionRange(start, start + multiLine.length);
              return;
            }
            prefix = '> ';
            if (!content) content = 'citation';
            break;
          case 'link':
            prefix = '['; 
            suffix = '](url)';
            if (!content) content = 'lien';
            break;
          case 'list':
            prefix = '- ';
            if (!content) content = 'élément';
            break;
          case 'fontSize':
            const size = this.fontSizeSelect.value;
            if (!size) {
              alert('Veuillez sélectionner une taille.');
              return;
            }
            prefix = `<span style="font-size: ${size}px">`;
            suffix = '</span>';
            if (!content) content = 'Texte';
            break;
          case 'image':
            this.fileInput.click();
            return;
        }

        if (prefix || suffix) {
          const replacement = prefix + content + suffix;
          this.insertText(replacement, start, end);
          
          const newStart = start + prefix.length;
          const newEnd = newStart + content.length;
          this.textarea.setSelectionRange(newStart, newEnd);
        }
      }

        initImageUpload() {
          this.fileInput.addEventListener('change', async () => {
             const file = this.fileInput.files[0];
             if (!file) return;

             this.uploadLoading.classList.remove('hidden');
             const fd = new FormData(); fd.append('image', file);
             
             try {
               const res = await fetch('/api/upload-image', { method: 'POST', body: fd });
               const data = await res.json();
               if (data.url) {
                 const tag = `\n![Image](${data.url})\n`;
                 const start = this.textarea.selectionStart;
                 this.textarea.value = this.textarea.value.substring(0, start) + tag + this.textarea.value.substring(this.textarea.selectionEnd);
                 this.textarea.dispatchEvent(new Event('input'));
               } else {
                 alert('Upload échoué: ' + (data.error || 'Erreur inconnue'));
               }
             } catch (e) {
               alert('Erreur réseau upload');
             } finally {
               this.uploadLoading.classList.add('hidden');
               this.fileInput.value = '';
             }
          });
        }
      }

      // Initialize
      function run() {
        document.querySelectorAll('.markdown-editor').forEach(el => {
          if (!el._editor) el._editor = new MarkdownEditor(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }

      // Diagnostic: click status dot to log preview HTML
      document.addEventListener('click', (e) => {
        if (e.target.classList.contains('editor-status-dot')) {
          const editor = e.target.closest('.markdown-editor');
          const preview = document.querySelector('.article-live-preview');
          if (preview) {
             console.log('--- PREVIEW HTML ---');
             console.log(preview.innerHTML);
             console.log('--------------------');
             alert('HTML de la preview loggé dans la console.');
          }
        }
      });
    })();
  </script>

  <style is:global>
    /* Ensure font-size spans are respected within Tailwind's prose */
    .article-live-preview span[style*="font-size"] {
      display: inline-block !important;
      line-height: normal !important;
      vertical-align: baseline !important;
    }
    
    /* Stronger override to ensure inline style wins */
    .article-live-preview .prose span[style*="font-size"],
    .prose.prose-invert span[style*="font-size"] {
      font-size: inherit; /* This allows the inline style attribute to take full effect */
    }

    /* Sync with News Article styling */
    .article-live-preview .prose blockquote {
      border-left: 4px solid rgba(234, 179, 8, 0.7) !important; /* accent-spirit/70 */
      background-color: rgba(10, 10, 10, 0.5) !important; /* rift-950/50 */
      padding: 0.5rem 1.5rem !important;
      font-style: normal !important;
      margin: 2rem 0 !important;
      border-radius: 0 !important;
    }

    .article-live-preview .prose img {
      border-radius: 0 !important;
    }
  </style>
</div>
