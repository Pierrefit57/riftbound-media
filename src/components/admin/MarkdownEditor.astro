<script>
  import imageCompression from 'browser-image-compression';
  import { marked } from 'marked';
  import { parseShortcodes } from '../../lib/shortcodes';
  import morphdom from 'morphdom';

  class MarkdownEditor {
    constructor(container) {
      this.container = container;
      this.textarea = container.querySelector('textarea');
      this.fileInput = container.querySelector('.image-upload-input');
      this.uploadLoading = container.querySelector('.upload-loading');
      this.fontSizeSelect = container.querySelector('.font-size-select');
      this.statusDot = container.querySelector('.editor-status-dot');
      // Look for the preview area on page
      this.preview = document.querySelector('.article-live-preview');

      if (!this.textarea) return;
      this.init();
    }

    init() {
      // Prevent duplicate init
      if (this.textarea._mdEditorInit) return;
      this.textarea._mdEditorInit = true;

      this.textarea.addEventListener('input', () => this.updatePreview());
      
      // Auto-continue blockquotes on Enter
      this.textarea.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const start = this.textarea.selectionStart;
          const text = this.textarea.value;
          const before = text.substring(0, start);
          const currentLine = before.split('\n').pop();
          
          if (currentLine.trim().startsWith('>')) {
            e.preventDefault();
            const prefix = '\n> ';
            this.insertText(prefix, start, start);
            const newPos = start + prefix.length;
            this.textarea.setSelectionRange(newPos, newPos);
          }
        }
      });

      // Configuration de marked pour les retours à la ligne intuitifs
      marked.setOptions({
        breaks: true,
        gfm: true
      });

      this.initToolbar();
      this.initImageUpload();
      this.initPasteSupport();
      this.updatePreview();
      if (this.statusDot) this.statusDot.style.backgroundColor = '#22c55e';
    }

    updatePreview() {
      if (!this.preview) return;
      
      // Normalisation des sauts de ligne (\r\n -> \n)
      const rawValue = (this.textarea.value || '').replace(/\r\n/g, '\n');
      
      // Pre-traitement pour préserver les lignes vides multiples
      let processedValue = rawValue.replace(/\n{3,}/g, (match) => {
        const count = match.length - 2;
        return '\n\n' + '<div class="spacer" style="height: ' + (count * 1.5) + 'rem" aria-hidden="true"></div>\n\n';
      });

      // Correction automatique : Assurer une ligne vide entre les balises <div> et le contenu Markdown
      processedValue = processedValue
        .replace(/(<div[^>]*>)\n(?!\n)/g, '$1\n\n')
        .replace(/(?<!\n)\n(<\/div>)/g, '\n\n$1');

      // Interpréter les shortcodes avant le Markdown brut
      processedValue = parseShortcodes(processedValue);

      let html = marked.parse(processedValue);
      // Post-processing: convert remaining markdown syntax that marked
      // skips inside HTML block-level elements (<div>, <blockquote>)
      html = html.replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
        '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
      html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/(?<!\*)\*(?!\*)([^*]+)(?<!\*)\*(?!\*)/g, '<em>$1</em>');
      
      if (html.trim() === '' && rawValue.trim() !== '') {
        html = '<p>' + rawValue + '</p>';
      }

      // Save scroll position
      const scrollPos = this.preview.scrollTop;

      // Use morphdom to update the DOM tree instead of rebuilding it entirely,
      // this prevents images from collapsing and destroying the layout during edit.
      morphdom(this.preview, `<div>${html}</div>`, {
        childrenOnly: true,
        onBeforeElUpdated: function (fromEl, toEl) {
          // Si l'élément est un volet (details) et qu'il est ouvert,
          // on préserve cet état pour éviter de fermer le volet pendant qu'on tape dedans
          if (fromEl.tagName === 'DETAILS' && toEl.tagName === 'DETAILS') {
            if (fromEl.hasAttribute('open')) {
              toEl.setAttribute('open', '');
            }
          }
          return true;
        }
      });

      // Restore scroll position to prevent minor diff-shifts
      this.preview.scrollTop = scrollPos;
    }

    insertText(newText, sStart, sEnd) {
      this.textarea.focus();
      this.textarea.setSelectionRange(sStart, sEnd);
      
      try {
        if (!document.execCommand('insertText', false, newText)) {
          throw new Error('execCommand failed');
        }
      } catch (e) {
        const val = this.textarea.value;
        this.textarea.value = val.substring(0, sStart) + newText + val.substring(sEnd);
        this.textarea.dispatchEvent(new Event('input'));
      }
    }

    initToolbar() {
      this.container.addEventListener('mousedown', (e) => {
        const btn = e.target.closest('[data-action]');
        if (!btn) return;

        e.preventDefault();
        this.handleAction(btn.dataset.action, btn);
      });
    }

    handleAction(action, target = null) {
      const start = this.textarea.selectionStart;
      const end = this.textarea.selectionEnd;
      const text = this.textarea.value;
      const selection = text.substring(start, end);

      const checkToggle = (tagStart, tagEnd = tagStart) => {
        if (text.substring(start - tagStart.length, start) === tagStart && text.substring(end, end + tagEnd.length) === tagEnd) {
           return { before: tagStart.length, after: tagEnd.length };
        }
        return null;
      };

      const toggleWrap = (tagStart, tagEnd = tagStart) => {
        const info = checkToggle(tagStart, tagEnd);
        if (info) {
           const sStart = start - info.before;
           const sEnd = end + info.after;
           this.insertText(selection, sStart, sEnd);
           
           const newStart = start - info.before;
           const newEnd = end - info.before;
           this.textarea.setSelectionRange(newStart, newEnd);
           return true;
        }
        return false;
      };

      let prefix = '', suffix = '';
      let content = selection;

      switch(action) {
        case 'bold':
          if (toggleWrap('**')) return;
          prefix = '**'; suffix = '**';
          if (!content) content = 'gras';
          break;
        case 'italic':
          if (toggleWrap('*')) return;
          prefix = '*'; suffix = '*';
          if (!content) content = 'italique';
          break;
        case 'strike':
          if (toggleWrap('~~')) return;
          prefix = '~~'; suffix = '~~';
          if (!content) content = 'barré';
          break;
        case 'underline':
          if (toggleWrap('<u>', '</u>')) return;
          prefix = '<u>'; suffix = '</u>';
          if (!content) content = 'souligné';
          break;
        case 'quote':
          prefix = '[quote]\n\n';
          suffix = '\n\n[/quote]';
          if (!content) content = 'Citation ou contenu important';
          break;
        case 'link':
          prefix = '['; 
          suffix = '](url)';
          if (!content) content = 'lien';
          break;
        case 'list':
          prefix = '- ';
          if (!content) content = 'élément';
          break;
        case 'volet':
          prefix = '[volet:Titre du jour]\n\n';
          suffix = '\n\n[/volet]';
          if (!content) content = 'Contenu de la journée...';
          break;
        case 'fontSize':
          const size = this.fontSizeSelect.value;
          if (!size) {
            alert('Veuillez sélectionner une taille.');
            return;
          }
          prefix = `[size:${size}]`;
          suffix = '[/size]';
          if (!content) content = 'Texte';
          break;
        case 'textColor':
          const colorHex = target.getAttribute('data-color');
          prefix = `[color:${colorHex}]`;
          suffix = '[/color]';
          if (!content) content = 'Texte coloré';
          break;
        case 'alignLeft':
          prefix = '[align-left]\n\n';
          suffix = '\n\n[/align]';
          if (!content) content = 'Texte à gauche';
          break;
        case 'alignCenter':
          prefix = '[align-center]\n\n';
          suffix = '\n\n[/align]';
          if (!content) content = 'Texte centré';
          break;
        case 'alignRight':
          prefix = '[align-right]\n\n';
          suffix = '\n\n[/align]';
          if (!content) content = 'Texte à droite';
          break;
        case 'sectionLeft':
          prefix = '[layout-left]\n\n';
          suffix = '\n\n---\n\nTexte ici\n\n[/layout]';
          if (!content) content = '![Image](url)';
          break;
        case 'sectionRight':
          prefix = '[layout-right]\n\n';
          suffix = '\n\n---\n\nTexte ici\n\n[/layout]';
          if (!content) content = '![Image](url)';
          break;
        case 'sectionDualImage':
          prefix = '[layout-dual]\n\n';
          suffix = '\n\n---\n\n![Image 2](url)\n\n[/layout]';
          if (!content) content = '![Image 1](url)';
          break;
        case 'sectionCenter': {
          const imgWidth = prompt('Largeur de l\'image ? (ex: 40%, 300px — laisser vide pour 50%)', '50%') ?? '50%';
          const widthVal = imgWidth.trim() || '50%';
          prefix = `[image-center:${widthVal}]\n\n`;
          suffix = '\n\n[/image-center]';
          if (!content) content = '![Image](url)';
          break;
        }
        case 'clearFloat':
          prefix = '\n[clear]\n';
          suffix = '';
          content = '';
          break;
        case 'insertTCGIcon':
          const iconFile = target.getAttribute('data-icon');
          const iconName = iconFile.replace('.png', '');
          prefix = `[icon:${iconName}]`;
          suffix = '';
          content = '';
          break;
        case 'insertEnergy':
          const manualCost = prompt('Coût en énergie ?', '1') || '1';
          prefix = `[energy:${manualCost}]`;
          suffix = '';
          content = '';
          break;
        case 'insertEnergyValue':
          const cost = target.getAttribute('data-value');
          prefix = `[energy:${cost}]`;
          suffix = '';
          content = '';
          break;
        case 'badgeGreen':
          // Legacy support (defaults to lime)
          prefix = '[badge:lime]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'badgeLime':
          prefix = '[badge:lime]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'badgeTeal':
          prefix = '[badge:teal]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'badgeRed':
          prefix = '[badge:red]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'badgeMagenta':
          prefix = '[badge:magenta]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'badgeGray':
          prefix = '[badge:gray]';
          suffix = '[/badge]';
          if (!content) content = 'MOT-CLÉ';
          break;
        case 'video':
          const url = prompt('URL de la vidéo ou du GIF (mp4, webm...) ?', '');
          if (!url) return;
          prefix = `[video:${url}]`;
          suffix = '';
          content = '';
          break;
        case 'youtube':
          const ytUrl = prompt('URL ou ID de la vidéo YouTube ?', '');
          if (!ytUrl) return;
          prefix = `[youtube:${ytUrl}]`;
          suffix = '';
          content = '';
          break;
        case 'image':
          this.fileInput.click();
          return;
      }

      if (prefix || suffix) {
        const replacement = prefix + content + suffix;
        this.insertText(replacement, start, end);
        
        const newStart = start + prefix.length;
        const newEnd = newStart + content.length;
        this.textarea.setSelectionRange(newStart, newEnd);
      }
    }

    initImageUpload() {
      this.fileInput.addEventListener('change', async () => {
         const file = this.fileInput.files[0];
         if (file) {
           await this.uploadImageFile(file);
           this.fileInput.value = '';
         }
      });
    }

    initPasteSupport() {
      this.textarea.addEventListener('paste', async (e) => {
        const items = (e.clipboardData || e.originalEvent.clipboardData).items;
        for (const item of items) {
          if (item.type.indexOf('image') !== -1) {
            const file = item.getAsFile();
            if (file) {
              e.preventDefault();
              this.uploadImageFile(file);
            }
          }
        }
      });
    }

    async uploadImageFile(file) {
      this.uploadLoading.classList.remove('hidden');
      
      try {
        // Options de compression
        const options = {
          maxSizeMB: 1.5, // < 1.5 Mo — qualité HD préservée
          maxWidthOrHeight: 2400,
          useWebWorker: true,
          fileType: 'image/webp',
          initialQuality: 0.85
        };

        // Compression
        const compressedFile = await imageCompression(file, options);
        
        // Renommage pour s'assurer de l'extension .webp
        const finalFile = new File([compressedFile], file.name.replace(/\.[^/.]+$/, "") + ".webp", {
          type: 'image/webp'
        });

        const fd = new FormData(); 
        fd.append('image', finalFile);
        
        const res = await fetch('/api/upload-image', { method: 'POST', body: fd });
        const data = await res.json();
        if (data.url) {
          const tag = `![Image](${data.url})`;
          const start = this.textarea.selectionStart;
          this.insertText(tag, start, this.textarea.selectionEnd);
        } else {
          alert('Upload échoué: ' + (data.error || 'Erreur inconnue'));
        }
      } catch (e) {
        console.error('Compression/Upload error:', e);
        alert('Erreur lors de la compression ou de l\'envoi');
      } finally {
        this.uploadLoading.classList.add('hidden');
      }
    }
  }

  // Initialize
  function run() {
    document.querySelectorAll('.markdown-editor').forEach(el => {
      // @ts-ignore
      if (!el._editor) el._editor = new MarkdownEditor(el);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }

  // Diagnostic: click status dot to log preview HTML
  document.addEventListener('click', (e) => {
    // @ts-ignore
    if (e.target.classList.contains('editor-status-dot')) {
      // @ts-ignore
      const editor = e.target.closest('.markdown-editor');
      const preview = document.querySelector('.article-live-preview');
      if (preview) {
         console.log('--- PREVIEW HTML ---');
         console.log(preview.innerHTML);
         console.log('--------------------');
         alert('HTML de la preview loggé dans la console.');
      }
    }
  });
</script>

