---
interface Props {
  title: string;
  summary: string;
  image: string;
  tags: string[];
  author: string;
  pubDate: Date;
  slug: string;
  featured?: boolean;
}

const { title, summary, image, tags, author, pubDate, slug, featured = false } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

{featured ? (
  <a href={`/news/${slug}`} class="group block relative overflow-hidden rounded-xl border border-surface-border bg-surface hover:border-accent-cyan/40 transition-all duration-300 hover:shadow-2xl hover:shadow-accent-cyan/10">
    <div class="relative h-56 md:h-64 bg-gradient-to-br from-accent-cyan/20 via-surface to-accent-purple/20 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(0,217,255,0.15),transparent_60%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_80%,rgba(168,85,247,0.15),transparent_60%)]"></div>
      <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-surface to-transparent"></div>
    </div>
    <div class="p-5 md:p-6">
      <div class="flex flex-wrap gap-2 mb-3">
        {tags.map((tag) => (
          <span class="px-2.5 py-0.5 text-xs font-medium rounded-full bg-accent-cyan/15 text-accent-cyan border border-accent-cyan/20">
            {tag}
          </span>
        ))}
      </div>
      <h3 class="text-xl md:text-2xl font-bold text-white mb-2 group-hover:text-accent-cyan transition-colors duration-200 line-clamp-2">
        {title}
      </h3>
      <p class="text-gray-400 text-sm mb-4 line-clamp-2">
        {summary}
      </p>
      <div class="flex items-center justify-between text-xs text-gray-500">
        <span>{author}</span>
        <span>{formattedDate}</span>
      </div>
      <span class="mt-3 inline-flex items-center text-sm font-semibold text-accent-cyan group-hover:gap-2 gap-1 transition-all duration-200">
        Lire la suite
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </span>
    </div>
  </a>
) : (
  <a href={`/news/${slug}`} class="group block overflow-hidden rounded-xl border border-surface-border bg-surface hover:border-accent-cyan/40 transition-all duration-300 hover:shadow-xl hover:shadow-accent-cyan/10 hover:-translate-y-1">
    <div class="relative h-44 bg-gradient-to-br from-accent-purple/20 via-surface to-accent-cyan/10 overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(0,217,255,0.1),transparent_70%)]"></div>
      <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-surface to-transparent"></div>
    </div>
    <div class="p-4 md:p-5">
      <div class="flex flex-wrap gap-1.5 mb-2">
        {tags.map((tag) => (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-accent-cyan/10 text-accent-cyan/80 border border-accent-cyan/15">
            {tag}
          </span>
        ))}
      </div>
      <h3 class="text-base font-bold text-white mb-1.5 group-hover:text-accent-cyan transition-colors duration-200 line-clamp-2">
        {title}
      </h3>
      <p class="text-gray-400 text-sm mb-3 line-clamp-2">
        {summary}
      </p>
      <div class="flex items-center justify-between text-xs text-gray-500">
        <span>{author}</span>
        <span>{formattedDate}</span>
      </div>
    </div>
  </a>
)}
