---
import { articleUrl } from '../lib/articleUrl';

interface Props {
  title: string;
  summary: string;
  image: string;
  tags: string[];
  author: string;
  pubDate: Date;
  slug: string;
  articleNumber?: number;
  featured?: boolean;
  highlighted?: boolean;
}

const { title, summary, image, tags, author, pubDate, slug, articleNumber, featured = false, highlighted = false } = Astro.props;
const href = articleUrl({ article_number: articleNumber, slug });

const formattedDate = pubDate.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const hasImage = image && image.length > 0 && !image.includes('cloudflare');

// Tag color mapping based on content
function getTagStyle(tag: string): string {
  const t = tag.toLowerCase().trim();
  
  if (t === 'boutique riot' || t === 'store riot') return 'bg-accent-sakura/15 text-accent-sakura border-accent-sakura/30';
  if (t.includes('riot') || t.includes('officiel')) return 'bg-domain-order/15 text-domain-order border-domain-order/30';
  if (t.includes('tournoi') || t.includes('compétitif')) return 'bg-accent-spirit/15 text-accent-spirit border-accent-spirit/30';
  if (t.includes('mise à jour') || t.includes('actualité') || t.includes('news')) return 'bg-domain-calm/15 text-domain-calm border-domain-calm/30';
  if (t.includes('équilibrage') || t.includes('patch')) return 'bg-accent-forge/15 text-accent-forge border-accent-forge/30';
  if (t.includes('lore') || t.includes('fun')) return 'bg-domain-chaos/15 text-domain-chaos border-domain-chaos/30';
  if (t.includes('carte') || t.includes('règles')) return 'bg-domain-mind/15 text-domain-mind border-domain-mind/30';
  if (t.includes('interview')) return 'bg-accent-sakura/20 text-accent-sakura border-accent-sakura/30';
  if (t.includes('errata')) return 'bg-domain-body/15 text-domain-body border-domain-body/30';
  if (t.includes('faq')) return 'bg-domain-body/15 text-domain-body border-domain-body/30';
  if (t.includes('site web')) return 'bg-sky-400/20 text-sky-400 border-sky-400/40 font-bold shadow-[0_0_10px_rgba(56,189,248,0.1)]';
  if (t === 'set 1') return 'bg-[#C5A059]/15 text-[#C5A059] border-[#C5A059]/30';
  if (t === 'set 2') return 'bg-[#A5A9B4]/15 text-[#A5A9B4] border-[#A5A9B4]/30';
  if (t === 'set 3') return 'bg-[#722d6c]/15 text-[#c46db8] border-[#722d6c]/30';
  if (t === 'eu') return 'bg-blue-500/15 text-blue-300 border-blue-500/30';
  if (t === 'us') return 'bg-red-500/15 text-red-300 border-red-500/30';
  if (t === 'chine') return 'bg-amber-500/15 text-amber-300 border-amber-500/30';

  return 'bg-rift-800/50 text-rift-200 border-rift-700/50';
}
---

{featured ? (
  <a href={href} class:list={["group w-full block relative overflow-hidden rounded-2xl border bg-rift-800 hover:border-accent-spirit/40 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-0.5 h-full flex flex-col", highlighted ? 'highlighted-card' : 'border-rift-700/50']}>
    <!-- Card image area -->
    <div class="relative h-56 md:h-[230px] overflow-hidden flex-shrink-0">
      {hasImage ? (
        <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
      ) : (
        <>
          <div class="absolute inset-0 bg-gradient-to-br from-accent-sakura/15 via-rift-900 to-accent-forge/10"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_40%,rgba(255,107,53,0.15),transparent_60%)]"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_60%,rgba(250,188,42,0.1),transparent_60%)]"></div>
          <div class="absolute inset-0 opacity-[0.04]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2240%22 height=%2240%22><circle cx=%2220%22 cy=%2220%22 r=%221.5%22 fill=%22%23ff6b35%22/></svg>'); background-size: 40px 40px;"></div>
        </>
      )}
      <!-- Featured badge -->
      <div class="absolute top-4 left-4 z-10">
        <span class="px-3 py-1 text-xs font-display font-semibold uppercase tracking-wider bg-accent-forge text-rift-900 rounded-full shadow-forge">
          ✦ Épinglé
        </span>
      </div>
    </div>
    <div class="p-4 md:p-5 relative z-10 flex flex-col flex-1 overflow-hidden">
      <div class="flex flex-wrap gap-2 mb-2 min-h-[24px]">
        {tags.map((tag) => {
          const displayTag = tag === 'Store Riot' ? 'Boutique Riot' : tag;
          return (
          <span class={`inline-flex items-center justify-center px-2 py-0.5 text-[11px] font-medium rounded-full border leading-none ${getTagStyle(tag)}`}>
            {displayTag}
          </span>
          );
        })}
      </div>
      <h3 class="text-lg md:text-xl font-display font-bold text-rift-50 mb-1 group-hover:text-accent-spirit transition-colors duration-300 line-clamp-2 uppercase tracking-wide leading-snug">
        {title}
      </h3>
      <p class="text-rift-200 text-sm mb-3 line-clamp-2 leading-snug">
        {summary}
      </p>
      <div class="mt-auto">
        <div class="flex items-center justify-between text-xs text-rift-400">
            <span>{author}</span>
            <span>{formattedDate}</span>
        </div>
        <span class="mt-3 inline-flex items-center text-[13px] font-semibold text-accent-spirit group-hover:gap-2.5 gap-1.5 transition-all duration-300">
            Lire la suite
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
        </span>
      </div>
    </div>
  </a>
) : (
  <a href={href} class:list={["group block overflow-hidden rounded-2xl border bg-rift-800 hover:border-accent-spirit/30 transition-all duration-300 hover:shadow-card-hover hover:-translate-y-1 h-full flex flex-col", highlighted ? 'highlighted-card' : 'border-rift-700/50']}>
    <div class="relative h-36 overflow-hidden flex-shrink-0">
      {hasImage ? (
        <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
      ) : (
        <>
          <div class="absolute inset-0 bg-gradient-to-br from-accent-sakura/10 via-rift-900 to-accent-forge/8"></div>
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(255,107,53,0.1),transparent_70%)]"></div>
          <div class="absolute inset-0 opacity-[0.03]" style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2230%22 height=%2230%22><circle cx=%2215%22 cy=%2215%22 r=%221%22 fill=%22%23ff6b35%22/></svg>'); background-size: 30px 30px;"></div>
        </>
      )}
    </div>
    <div class="p-4 md:p-5 relative z-10 flex flex-col flex-1">
      <div class="flex flex-wrap gap-1.5 mb-2 min-h-[24px]">
        {tags.map((tag) => {
          const displayTag = tag === 'Store Riot' ? 'Boutique Riot' : tag;
          return (
          <span class={`inline-flex items-center justify-center px-2 py-0.5 text-[11px] font-medium rounded-full border leading-none ${getTagStyle(tag)}`}>
            {displayTag}
          </span>
          );
        })}
      </div>
      <h3 class="text-base font-display font-bold text-rift-50 mb-1.5 group-hover:text-accent-spirit transition-colors duration-300 line-clamp-2 uppercase tracking-wide">
        {title}
      </h3>
      <p class="text-rift-200 text-sm mb-3 line-clamp-2 leading-relaxed">
        {summary}
      </p>
      <div class="flex items-center justify-between text-xs text-rift-400 mt-auto">
        <span>{author}</span>
        <span>{formattedDate}</span>
      </div>
    </div>
  </a>
)}

<style is:global>
  @keyframes highlight-glow {
    0%, 100% { box-shadow: 0 0 15px rgba(255, 102, 51, 0.3), 0 0 40px rgba(255, 102, 51, 0.1); }
    50% { box-shadow: 0 0 25px rgba(255, 102, 51, 0.5), 0 0 60px rgba(255, 102, 51, 0.2); }
  }
  .highlighted-card {
    border-color: rgba(255, 102, 51, 0.6) !important;
    animation: highlight-glow 2s ease-in-out infinite;
  }
</style>
