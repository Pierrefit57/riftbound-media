{
    "redirects": [
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "riftbound-media.com" }],
            "destination": "https://www.riftbound-media.fr/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "www.riftbound-media.com" }],
            "destination": "https://www.riftbound-media.fr/$1",
            "permanent": true
        },
        {
            "source": "/(.*)",
            "has": [{ "type": "host", "value": "riftbound-media.fr" }],
            "destination": "https://www.riftbound-media.fr/$1",
            "permanent": true
        }
    ],
    "crons": [
        {
            "path": "/api/cron/send-notifications",
            "schedule": "0 6 * * *"
        }
    ],
    "headers": [
        {
            "source": "/api/img/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=2592000, max-age=604800, stale-while-revalidate=86400"
                }
            ]
        }
    ]
}